{
  "name": "@massic/forms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute massic-forms --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute massic-forms --local --file=./seed.sql",
    "db:migrate": "wrangler d1 execute massic-forms --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute massic-forms --remote --file=./seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.20.0"
  }
}
