---
/**
 * Events hub — all copy, links and photos come from the Sanity "Events hub"
 * singleton (`eventsContent`); defaults live in src/data/pages/events.ts.
 * The Instagram feed shows Sanity photo tiles until a feed embed is approved.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import OptionsTable from '~/components/widgets/OptionsTable.astro';
import InstagramFeed from '~/components/widgets/InstagramFeed.astro';
import EventsBlocks from '~/components/widgets/EventsBlocks.astro';
import { getEventsHubContent } from '~/lib/content';
import { paragraphsToHtml } from '~/lib/content/inlineLink';

const c = await getEventsHubContent();

const metadata = { title: c.seoTitle, description: c.seoDescription, ignoreTitleTemplate: true };
const isExternal = (href: string) => /^https?:\/\//.test(href);

const weeklyRows = c.weeklyRows.map((row) => [
  row.day,
  row.event,
  row.location,
  { text: row.detailsText, href: row.detailsHref, ...(isExternal(row.detailsHref) ? { external: true } : {}) },
]);

const linkGroups = [
  ...(c.moreOptionLinks.length ? [{ label: c.moreOptionsLabel, links: c.moreOptionLinks }] : []),
  ...(c.locationLinks.length ? [{ label: c.locationInfoLabel, links: c.locationLinks }] : []),
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    image={c.heroImage}
    title={c.heroTitle}
    content={paragraphsToHtml(c.heroParagraphs)}
    actions={[
      {
        variant: 'primary',
        text: c.heroButton.text,
        href: c.heroButton.href,
        target: isExternal(c.heroButton.href) ? '_blank' : undefined,
      },
    ]}
  />

  <OptionsTable
    id="weekly-events"
    layout="stacked"
    heading={c.weeklyHeading}
    note={c.weeklyNote}
    columns={['Day', 'Event', 'Location', 'Details']}
    rows={weeklyRows}
    linkGroups={linkGroups}
  />

  <InstagramFeed
    tone="card"
    heading={c.instagramHeading}
    text={c.instagramText}
    ctaText={c.instagramButton.text}
    ctaHref={c.instagramButton.href}
    feedLabel={c.instagramFeedLabel}
    tiles={c.instagramTiles}
  />

  <EventsBlocks blocks={c.blocks} />
</PageLayout>
