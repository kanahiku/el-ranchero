---
/**
 * Event Space Rental — copy from pages-content/Events/_events_event-space-rental - Event Space Rental.docx.
 * The inquiry form posts through the site contact worker. The doc says the form recipient,
 * booking phone and approved workflow are still to be confirmed — the "Call About the Space"
 * button is intentionally omitted until the booking phone is verified.
 * Composes shared widgets only. Photos come from the Sanity "Events" singleton
 * (`eventsContent`); a missing photo renders the grey placeholder.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import OptionsTable from '~/components/widgets/OptionsTable.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Text from '~/components/ui/Text.astro';
import Form from '~/components/ui/Form.astro';
import { moreEventsColumns, moreEventsRows } from '~/data/events';
import { getEventsImages } from '~/lib/content';

const images = await getEventsImages();

const metadata = {
  title: 'Event Space Rental in Kapolei | Taqueria El Ranchero',
  description:
    'Plan a private gathering at Taqueria El Ranchero Kapolei. Learn about our rentable event space with a stage, TVs, microphones and speakers, and inquire.',
  ignoreTitleTemplate: true,
};

const inquiryInputs = [
  { type: 'text', name: 'name', label: 'Name', autocomplete: 'name', required: true },
  { type: 'email', name: 'email', label: 'Email', autocomplete: 'email', required: true },
  { type: 'tel', name: 'phone', label: 'Phone', autocomplete: 'tel' },
  {
    type: 'select',
    name: 'topic',
    label: 'Type of event',
    placeholder: 'Select an event type',
    required: true,
    options: [
      { label: 'Corporate event', value: 'corporate' },
      { label: 'Baby shower', value: 'baby-shower' },
      { label: 'Wedding reception', value: 'wedding-reception' },
      { label: 'Family celebration', value: 'family' },
      { label: 'Other group occasion', value: 'other' },
    ],
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    image={images.spaceRentalHero}
    title="Event Space Rental at El Ranchero Kapolei"
    content="Bring your people together somewhere that already knows how to welcome a crowd.<br /><br />Taqueria El Ranchero’s Kapolei location at Ka Makana Aliʻi has venue space available to rent for private events, from work gatherings to family celebrations.<br /><br />Tell us what you’re planning and ask about the space for your occasion."
    actions={[{ variant: 'primary', text: 'Request Event Space Information', href: '#inquiry' }]}
  />

  <TextSplit id="gathering" heading="A Place for Your Next Gathering">
    <div class="flex flex-col gap-6">
      <Text color="default">
        Our Kapolei event space is an option for corporate events, baby showers, wedding receptions and other group occasions.
      </Text>
      <Text color="default">
        The right setup depends on your event. Capacity and available arrangements should be confirmed directly before you finalize plans.
      </Text>
    </div>
  </TextSplit>

  <TextSplit id="features" heading="Event Space Features" class="bg-card">
    <div class="flex flex-col gap-6">
      <Text color="default">The venue space includes a stage, televisions, microphones and speakers.</Text>
      <Text color="default">
        For equipment availability, room arrangements and any food or bar options, please confirm what is included with your event inquiry.
      </Text>
    </div>
  </TextSplit>

  <TextSplit id="inquiry" heading="Ask About Event Space Availability" alignTop class="scroll-mt-24">
    <div class="flex flex-col gap-8">
      <Text color="default">
        Have a date or occasion in mind? Share the type of event, your preferred date, estimated number of guests and any particular needs so the availability and arrangements can be discussed.
      </Text>
      <Form
        inputs={inquiryInputs}
        textarea={{
          name: 'message',
          label: 'Preferred date, estimated guests and any particular needs',
          rows: 5,
        }}
        button="Request Event Space Information"
      />
      <Text variant="small" color="muted">
        For information about the restaurant itself, visit the <a class="text-accent underline underline-offset-4" href="/locations/kapolei">Kapolei location page</a>. Planning food for a group separately? See our <a class="text-accent underline underline-offset-4" href="/catering">Catering options</a>.
      </Text>
    </div>
  </TextSplit>

  <OptionsTable
    id="more-events"
    tone="card"
    layout="stacked"
    heading="More Events at El Ranchero"
    intro="Want to join an upcoming night at El Ranchero instead? Our calendar has tacos, karaoke, Latin music and special concerts too."
    columns={moreEventsColumns}
    rows={moreEventsRows('/events/event-space-rental')}
    ctaText="View All Events"
    ctaHref="/events"
  />

  <CTABanner
    title="Let’s Talk About Your Event"
    subtitle="Your occasion is unique. Send an event space inquiry with the details you know so far and confirm the next steps with the Kapolei team."
    actions={[{ variant: 'primary', text: 'Request Event Space Information', href: '#inquiry' }]}
  />
</PageLayout>
