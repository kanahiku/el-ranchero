---
/**
 * Latin Night — copy from pages-content/Events/_events_latin-night - Latin Night.docx.
 * Composes shared widgets only. Photos come from the Sanity "Events" singleton
 * (`eventsContent`); a missing photo renders the grey placeholder.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import OptionsTable from '~/components/widgets/OptionsTable.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import {
  EVENTS_INSTAGRAM_HANDLE,
  EVENTS_INSTAGRAM_HREF,
  instagramLink,
  locationLinks,
  moreEventsColumns,
  moreEventsRows,
} from '~/data/events';
import { getEventsImages } from '~/lib/content';

const images = await getEventsImages();

const metadata = {
  title: 'Saturday Latin Night on Oʻahu | El Ranchero',
  description:
    'Spend Saturday at Latin Night at El Ranchero on Oʻahu. Enjoy music from across Latin America and tacos served until 2 a.m. Check this week’s event details.',
  ignoreTitleTemplate: true,
};
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    image={images.latinNightHero}
    title="Saturday Latin Night at El Ranchero"
    content="Saturday nights at El Ranchero have a soundtrack from across Latin America!<br /><br />Latin Night brings together different Latin sounds for a night of music and good company. It’s not just Mexican music or mariachi. It’s a chance to enjoy music from across Latin American cultures, with everyone welcome to join in.<br /><br />And when hunger hits, tacos are served until 2 a.m. at the participating location."
    actions={[{ variant: 'primary', text: 'See This Saturday’s Latin Night', href: EVENTS_INSTAGRAM_HREF, target: '_blank' }]}
  />

  <OptionsTable
    id="details"
    heading="Latin Night Details"
    note="Check the latest announcement for event times, location and admission details before heading out."
    columns={['Detail', 'Info']}
    rows={[
      ['When', 'Every Saturday'],
      ['Time', 'Check the latest event announcement for start times.'],
      ['Where', `Participating location announced through ${EVENTS_INSTAGRAM_HANDLE}.`],
      ['Music', 'Latin music from across Latin America.'],
      ['Late-Night Food', 'Tacos served until 2 a.m. at the hosting location.'],
    ]}
    linkGroups={[{ links: locationLinks }]}
  />

  <TextSplit id="late-night-tacos" heading="Keep the Night Going With Tacos" class="bg-card" withImage imageAspect="4 / 3">
    <div class="flex flex-col gap-6">
      <Text color="default">The music isn’t the only reason to stick around.</Text>
      <Text color="default">
        During Saturday Latin Night, El Ranchero keeps serving tacos until 2 a.m. at the participating venue, even after regular kitchen service ends.
      </Text>
      <Text color="default">
        Whether you’re enjoying the music with friends or getting hungry later in the evening, tacos are part of the Latin Night experience.
      </Text>
      <Button variant="primary" text="See Our Tacos & Birria Menu" href="/menu/tacos" hideNote={true} class="self-start" />
    </div>
  </TextSplit>

  <OptionsTable
    id="more-events"
    layout="stacked"
    heading="More Events at El Ranchero"
    intro="The good times don’t stop on Saturday. Find another event to enjoy at Taqueria El Ranchero."
    columns={moreEventsColumns}
    rows={moreEventsRows('/events/latin-night')}
    ctaText="View All Events"
    ctaHref="/events"
  />

  <CTABanner
    title="See What’s Happening This Saturday"
    subtitle={`Get the latest Latin Night details, including the hosting location, event times and announcements, through ${EVENTS_INSTAGRAM_HANDLE}. Make your Saturday plans and join us for Latin Night!`}
    actions={[{ variant: 'primary', text: instagramLink.text, href: instagramLink.href }]}
  />
</PageLayout>
