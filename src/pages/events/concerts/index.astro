---
/**
 * Live Concerts — copy from pages-content/Events/_events_concerts - Live Concerts.docx.
 * Composes shared widgets only. Photos come from the Sanity "Events" singleton
 * (`eventsContent`); a missing photo renders the grey placeholder.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import OptionsTable from '~/components/widgets/OptionsTable.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import {
  EVENTS_INSTAGRAM_HANDLE,
  EVENTS_INSTAGRAM_HREF,
  instagramLink,
  locationLinks,
  moreEventsColumns,
  moreEventsRows,
} from '~/data/events';
import { getEventsImages } from '~/lib/content';

const images = await getEventsImages();

const metadata = {
  title: 'Live Mexican Band Concerts on Oʻahu | El Ranchero',
  description:
    'Catch headline concerts at El Ranchero on Oʻahu with professional Mexican bands and a full-party atmosphere. Find show announcements and venue details.',
  ignoreTitleTemplate: true,
};
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    image={images.concertsHero}
    title="Live Mexican Band Concerts at El Ranchero"
    content="Some nights deserve a bigger stage.<br /><br />About three times a year, Taqueria El Ranchero brings professional, well-known Mexican bands to Oʻahu for special concerts. These are full-party nights built around the music, the crowd and getting together.<br /><br />Every show is its own event. Keep an eye on the next announcement for the artist, date, location and entry details."
    actions={[{ variant: 'primary', text: 'See the Latest Concert Announcements', href: EVENTS_INSTAGRAM_HREF, target: '_blank' }]}
  />

  <TextSplit id="next-concert" heading="The Next El Ranchero Concert" withImage imageAspect="4 / 3">
    <div class="flex flex-col gap-6">
      <Text color="default">
        Big concert nights don’t happen every weekend, so the next confirmed show deserves its own announcement.
      </Text>
      <Text color="default">
        Check {EVENTS_INSTAGRAM_HANDLE} for the next artist, date, hosting venue and event information.      </Text>
      <Button variant="primary" text={`Check ${EVENTS_INSTAGRAM_HANDLE} for the Next Show`} href={EVENTS_INSTAGRAM_HREF} target="_blank" hideNote={true} class="self-start" />
    </div>
  </TextSplit>

  <TextSplit id="full-night" heading="A Full Night of Live Music" class="bg-card" withImage imageAspect="4 / 3" imageReverse>
    <div class="flex flex-col gap-6">
      <Text color="default">
        El Ranchero’s headline concerts feature professional Mexican bands and a full party atmosphere, rather than the regular weekly music schedule.
      </Text>
      <Text color="default">
        Concert nights typically run from about 9:30 p.m. to 2 a.m. Check each show’s announcement for exact times, location and entry details.
      </Text>
    </div>
  </TextSplit>

  <TextSplit id="plan-your-night" heading="Plan Your Concert Night" withImage imageAspect="4 / 3">
    <div class="flex flex-col gap-6">
      <Text color="default">
        A concert announcement will tell you which El Ranchero location is hosting. We have restaurants in Wahiawa and Kapolei, but don’t assume both are hosting the same concert.
      </Text>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-sans text-body text-heading">
        {
          locationLinks.map((link, index) => (
            <>
              {index > 0 && (
                <span class="text-heading/30" aria-hidden="true">
                  |
                </span>
              )}
              <a href={link.href} class="text-accent underline underline-offset-4 transition-opacity hover:opacity-80">
                {link.text}
              </a>
            </>
          ))
        }
      </p>
    </div>
  </TextSplit>

  <OptionsTable
    id="more-events"
    tone="card"
    layout="stacked"
    heading="More Events at El Ranchero"
    intro="There’s more on the calendar between headline shows. Choose another El Ranchero event or ask about hosting your own gathering."
    columns={moreEventsColumns}
    rows={moreEventsRows('/events/concerts')}
    ctaText="View All Events"
    ctaHref="/events"
  />

  <CTABanner
    title="Don’t Miss the Next Show"
    subtitle={`For the latest concert updates, follow ${EVENTS_INSTAGRAM_HANDLE}. You’ll find current announcements there as new shows are confirmed.`}
    actions={[{ variant: 'primary', text: instagramLink.text, href: instagramLink.href }]}
  />
</PageLayout>
