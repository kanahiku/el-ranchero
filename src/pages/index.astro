---
/**
 * Homepage — every piece of copy, link and photo comes from the Sanity
 * "Homepage" singleton (`homepageContent`); built-in defaults live in
 * src/data/pages/homepage.ts. Composes shared widgets only.
 * Decorative motifs stay in code.
 */
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import FeaturedDishes from '~/components/widgets/FeaturedDishes.astro';
import ScheduleSection from '~/components/widgets/ScheduleSection.astro';
import Locations from '~/components/widgets/Locations.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import Motif from '~/components/ui/Motif.astro';
import { getHomepageContent } from '~/lib/content';
import { inlineLinkHtml, paragraphsToHtml } from '~/lib/content/inlineLink';

const c = await getHomepageContent();

const metadata = {
  title: c.seoTitle,
  description: c.seoDescription,
  ignoreTitleTemplate: true,
};

const heroSubtitle = paragraphsToHtml(c.heroParagraphs);

const linkClass = 'text-accent underline underline-offset-4 transition-opacity hover:opacity-80';
const eventsFootnote = inlineLinkHtml(c.eventsFootnoteBefore, c.eventsFootnoteLink, c.eventsFootnoteAfter, linkClass);
---

<Layout metadata={metadata}>
  {/* ── 1. Hero ───────────────────────────────────────────── */}
  <Hero2
    id="home-hero"
    variant="overlay"
    image={c.heroImage}
    overlapHeader={false}
    title={c.heroTitle}
    subtitle={heroSubtitle}
    actions={c.heroActions.map((action) => ({ ...action, variant: action.variant ?? 'primary' }))}
  >
    <Fragment slot="stats">
      <ul class="grid grid-cols-3 gap-4 text-center text-contrast md:gap-8">
        {
          c.heroStats.map((stat) => (
            <li class="flex flex-col items-center gap-1">
              <Heading variant="h3" color="white" as="p">
                {stat.value}
              </Heading>
              <Text variant="small" color="white" as="span">
                {stat.label}
              </Text>
            </li>
          ))
        }
      </ul>
    </Fragment>
  </Hero2>

  {/* ── 2. Breakfast ──────────────────────────────────────── */}
  <TextSplit
    id="breakfast"
    heading={c.breakfastHeading}
    withImage
    image={c.breakfastImage}
    imageAspect="4 / 3"
    class="bg-card"
  >
    {/* Plant motif (Figma 2083:1163) — overlaps the bottom of the breakfast photo */}
    <Motif slot="motif" name="plant" width={315} height={198} style="left: 68.37%; bottom: 0;" />
    <div class="flex flex-col gap-8">
      {
        c.breakfastParagraphs.map((paragraph) => (
          <Text variant="body" color="default">
            {paragraph}
          </Text>
        ))
      }
      {
        c.breakfastCta.text && (
          <div>
            <Button variant="primary" text={c.breakfastCta.text} href={c.breakfastCta.href} hideNote={true} />
          </div>
        )
      }
    </div>
  </TextSplit>

  {/* ── 3. Menu favorites ─────────────────────────────────── */}
  <FeaturedDishes
    id="favorites"
    eyebrow=""
    title={c.favoritesTitle}
    subtitle={c.favoritesParagraphs}
    ctaText={c.favoritesCta.text}
    ctaHref={c.favoritesCta.href}
    dishes={c.favoritesDishes.map((dish) => ({
      title: dish.title,
      image: dish.image,
      description: dish.paragraphs,
      href: dish.href,
    }))}
  />

  {/* ── 4. Weekly events ──────────────────────────────────── */}
  <div class="bg-card">
    <ScheduleSection
      id="weekly-events"
      heading={c.eventsHeading}
      body={c.eventsBody}
      days={c.eventsDays}
      footnote={eventsFootnote}
      ctaText={c.eventsCta.text}
      ctaHref={c.eventsCta.href}
    >
      {/* Cactus motif (Figma 2083:1373) — bottom-right, behind the cards */}
      <Motif slot="motif" name="cactus" width={382} height={388} style="left: 69.04%; bottom: -4px;" />
    </ScheduleSection>
  </div>

  {/* ── 5. Locations ──────────────────────────────────────── */}
  <Locations
    id="locations"
    variant="detailed"
    eyebrow=""
    title={c.locationsTitle}
    subtitle={c.locationsSubtitle}
    ctaText=""
    locations={c.locationsList.map((location) => ({
      name: location.name,
      image: location.image,
      heading: location.heading,
      shopName: location.shopName,
      addressLine1: location.address,
      addressLine2: '',
      description: location.paragraphs,
      hours: location.hours,
      actions: location.actions,
    }))}
  />

  {/* ── 6. Catering ───────────────────────────────────────── */}
  <TextSplit id="catering" heading={c.cateringHeading} withImage image={c.cateringImage} imageAspect="4 / 3" imageReverse>
    <div class="flex flex-col gap-6">
      {
        c.cateringParagraphs.map((paragraph) => (
          <Text variant="body" color="default">
            {paragraph}
          </Text>
        ))
      }
      {
        c.cateringCta.text && (
          <div>
            <Button variant="primary" text={c.cateringCta.text} href={c.cateringCta.href} hideNote={true} />
          </div>
        )
      }
    </div>
  </TextSplit>

  {/* ── 7. Private events ─────────────────────────────────── */}
  <TextSplit
    id="private-events"
    heading={c.privateEventsHeading}
    withImage
    image={c.privateEventsImage}
    imageAspect="4 / 3"
    class="bg-card"
  >
    <div class="flex flex-col gap-6">
      {
        c.privateEventsParagraphs.map((paragraph) => (
          <Text variant="body" color="default">
            {paragraph}
          </Text>
        ))
      }
      {
        c.privateEventsCta.text && (
          <div>
            <Button variant="primary" text={c.privateEventsCta.text} href={c.privateEventsCta.href} hideNote={true} />
          </div>
        )
      }
    </div>
  </TextSplit>

  {/* ── 8. Reviews — cards come from Sanity Testimonials ──── */}
  <Testimonials id="reviews" heading={c.reviewsHeading} />

  {/* ── 9. Closing CTA ────────────────────────────────────── */}
  <CTABanner id="visit" rider title={c.closingTitle} subtitle={c.closingSubtitle} actions={c.closingActions} />
</Layout>
