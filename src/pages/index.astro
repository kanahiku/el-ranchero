---
/**
 * Homepage — Figma "Taqueria El Ranchero (For Review)" Variant 1 (2083:1854).
 * Composes shared widgets only. Photos, reviews and blogs come from Sanity;
 * only decorative motifs (public/motifs) live in the codebase.
 */
import { getHomepageImages } from '~/lib/content';
import RelatedBlogs from '~/components/widgets/RelatedBlogs.astro';
import Layout from '~/layouts/PageLayout.astro';
import HeroArch from '~/components/widgets/HeroArch.astro';
import StatsRibbon from '~/components/widgets/StatsRibbon.astro';
import PolaroidFeature from '~/components/widgets/PolaroidFeature.astro';
import DishPolaroids from '~/components/widgets/DishPolaroids.astro';
import EventTickets from '~/components/widgets/EventTickets.astro';
import LocationPair from '~/components/widgets/LocationPair.astro';
import PanelPair from '~/components/widgets/PanelPair.astro';
import ReviewCards from '~/components/widgets/ReviewCards.astro';
import CTAFiesta from '~/components/widgets/CTAFiesta.astro';
import { PRIMARY_CTA_HREF, CATERING_CTA_HREF, LOCATION_CTA_HREF } from '~/config/cta';

const metadata = {
  title: 'Mexican Restaurant in Wahiawa & Kapolei | El Ranchero',
  description:
    'Enjoy tacos, burritos and Mexican breakfast at Taqueria El Ranchero in Wahiawa or Kapolei. View our menu and order online.',
  ignoreTitleTemplate: true,
};

const light = { variant: 'ghost', tone: 'dark' } as const; // cream fill, red type
const outline = { variant: 'ghost', tone: 'light' } as const; // ink outline

const images = await getHomepageImages();
---

<Layout metadata={metadata}>
  <HeroArch
    id="home-hero"
    image={images.hero}
    eyebrow="¡Bienvenidos!"
    title="Hawaii’s<br />Original<br />Taqueria"
    body="Northern California–inspired Mexican food in Wahiawā and Kapolei. Tacos, burritos and ranchero-style entrées made fresh every day with meats off the open-fire grill and salsas made in-house."
    actions={[
      { variant: 'primary', text: 'Order Now', href: PRIMARY_CTA_HREF },
      { ...outline, text: 'View Our Menu', href: '/menu' },
    ]}
    stamp={{ top: 'Desde', year: '2015', bottom: 'Oʻahu' }}
  />

  <StatsRibbon
    items={['Est. 2015 on Oʻahu', '2 Oʻahu Locations', 'Fresh Daily', 'Open-Fire Grill', 'Salsas Made In-House']}
  />

  <PolaroidFeature
    id="breakfast"
    image={images.breakfast}
    eyebrow="Desayuno"
    title="Mexican Breakfast, Every Day From 7 AM"
    body="Start your morning at El Ranchero. Breakfast is served daily from 7 AM to 12 PM at both locations."
    caption="Mexican Omelette, 7 AM"
    picks={[
      {
        label: 'On the go',
        text: 'Breakfast Burrito — bacon, ham, chorizo or veggie, with eggs, beans, cheese, potatoes, tomato, onion and jalapeño.',
      },
      {
        label: 'Sit down',
        text: 'Chilaquiles, Huevos Rancheros or Huevos con Chorizo with traditional accompaniments.',
      },
    ]}
    action={{ ...light, text: 'Explore Our Breakfast Menu', href: '/menu/breakfast' }}
  />

  <DishPolaroids
    id="favorites"
    eyebrow="Los Favoritos"
    title="Discover Our Mexican Food Favorites"
    subtitle="Inspired by the taquerias of San Francisco: straightforward cooking, meats grilled over an open fire each morning and salsas made in-house."
    dishes={[
      {
        title: 'Molcajete',
        image: images.molcajete,
        description:
          'Our signature: grilled meats, vegetables and savory sauce served sizzling in a volcanic stone mortar, with beans, rice and tortillas.',
      },
      {
        title: 'Tacos & Birria',
        image: images.tacosBirria,
        description:
          'Classic tacos with your choice of carne asada, carnitas or al pastor, plus Tacos and Mulitas de Birria, three per order.',
      },
      {
        title: 'Burritos',
        image: images.burritos,
        description:
          'The Burrito Grande with meat, beans, rice, cheese, pico, guac and sour cream, or the fries-stuffed California Burrito.',
      },
    ]}
    action={{ variant: 'primary', text: 'Explore Full Menu', href: '/menu' }}
  />

  <EventTickets
    id="weekly-events"
    eyebrow="Cartelera semanal"
    title="Weekly Events<br />at El Ranchero"
    intro="Food is only part of the experience. Our restaurants bring people together through music and community events inspired by Latin American culture."
    tickets={[
      {
        day: 'Tuesday',
        title: 'Taco Tuesday',
        icon: 'banner',
        description: 'Make tacos part of your Tuesday plans. Check the latest announcements for current specials.',
      },
      {
        day: 'Wednesday',
        title: 'Free Karaoke Wednesday',
        icon: 'karaoke',
        description: 'Karaoke hosted by local DJs. Sing in Spanish or English, no set theme.',
      },
      {
        day: 'Friday',
        title: 'DJ & Promoter Nights',
        icon: 'dj',
        description: 'Many Fridays feature local promoters and DJs. Check the schedule for performers.',
      },
      {
        day: 'Saturday',
        title: 'Latin Night',
        icon: 'drink',
        description: 'Music from across Latin America and an evening centered on the Latino community.',
      },
    ]}
    footnote={'We also host live concerts with professional Mexican bands — see <a href="/events/concerts">Live Concerts</a> for upcoming shows.'}
    action={{ ...light, text: 'View All Events', href: '/events' }}
  />

  <LocationPair
    id="locations"
    eyebrow="Dos casas"
    title="Two Taquerias<br />on Oʻahu"
    intro="Visit us in Wahiawā or Kapolei. Same menu, two different dining rooms to suit your plans."
    locations={[
      {
        label: 'No. 1 · The Original',
        name: 'Wahiawā',
        image: images.wahiawa,
        address: '823 California Ave, Unit A5, Wahiawā, HI 96786 · Wahiawā Shopping Center',
        hours: 'Kitchen 7 AM–10 PM  ·  Breakfast 7 AM–12 PM daily',
        description:
          'A rustic neighborhood spot serving local regulars, military families and travelers heading to the North Shore. Breakfast burritos in the morning, tacos to go all day.',
        actions: [
          { variant: 'primary', text: 'View Wahiawā Location', href: '/locations/wahiawa' },
          {
            ...outline,
            text: 'Order Takeout',
            href: 'https://www.doordash.com/store/taqueria-el-ranchero-wahiawa-276575/',
          },
        ],
      },
      {
        label: 'No. 2 · Ka Makana Aliʻi',
        labelClass: 'text-section-green',
        name: 'Kapolei',
        image: images.kapolei,
        address: '91-5431 Kapolei Pkwy #501, Kapolei, HI 96707 · Ka Makana Aliʻi',
        hours: 'Kitchen 7 AM–10 PM  ·  Breakfast 7 AM–12 PM daily',
        description:
          'Sit-down dining with servers and outdoor seating — great for family meals, and home to our private event space.',
        actions: [
          { variant: 'primary', text: 'View Kapolei Location', href: '/locations/kapolei' },
          {
            ...outline,
            text: 'Order Takeout',
            href: 'https://www.doordash.com/store/taqueria-el-ranchero-kapolei-2390257/',
          },
        ],
      },
    ]}
  />

  <PanelPair
    id="catering"
    panels={[
      {
        eyebrow: 'Catering',
        title: 'Mexican Catering for Gatherings',
        image: images.catering,
        body: 'From small office lunches to events for roughly 250 guests, including taco bar packages. Tell our catering team about your group and we’ll plan it with you.',
        action: { variant: 'primary', text: 'Explore Catering', href: CATERING_CTA_HREF },
      },
      {
        eyebrow: 'Fiestas privadas',
        title: 'Host Your Private Event in Kapolei',
        image: images.privateEvents,
        body: 'A rentable event space with a stage, TVs, microphones and speakers — for birthdays, baby showers, wedding receptions and company parties.',
        action: { variant: 'primary', text: 'Explore Event Space', href: '/events/event-space-rental' },
      },
    ]}
  />

  <ReviewCards id="reviews" eyebrow="Lo que dicen" title="Customers Are Raving" />

  <RelatedBlogs pageSlug="" surface="grey" />

  <CTAFiesta
    id="visit"
    eyebrow="¡Te esperamos!"
    title="Visit or Order From<br />Taqueria El Ranchero"
    body="Explore the menu, choose your nearest taqueria or talk to our team about catering your next gathering."
    actions={[
      { text: 'Order Now', href: PRIMARY_CTA_HREF },
      { text: 'Order Catering', href: CATERING_CTA_HREF },
      { text: 'Find a Location', href: LOCATION_CTA_HREF },
    ]}
  />
</Layout>
