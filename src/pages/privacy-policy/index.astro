---
/**
 * Privacy Policy — copy from the Drive doc "/privacy-policy - Privacy Policy".
 */
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';

const metadata = {
  title: 'Privacy Policy | Taqueria El Ranchero',
  description:
    'Learn about website forms, analytics, external ordering services, and privacy questions at Taqueria El Ranchero.',
  ignoreTitleTemplate: true,
};

const headingClass =
  'text-[22px] md:text-[26px] font-normal leading-[130%] tracking-tight font-heading text-heading mb-4';
const bodyClass = 'text-[16px] font-normal leading-[160%] text-muted';
const linkClass = 'text-accent underline underline-offset-4 transition-opacity hover:opacity-80';
---

<Layout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    hideImage
    title="Privacy Policy"
    content="Taqueria El Ranchero provides this notice to explain the website features through which visitors may share information or interact with third-party services."
  />

  <WidgetWrapper containerClass="max-w-container mx-auto">
    <div class="mx-auto w-full max-w-3xl space-y-10 text-left md:space-y-14">
      <section>
        <h2 class={headingClass}>Information You Provide Through Forms</h2>
        <div class={`${bodyClass} space-y-5`}>
          <p>
            Our website includes ways to send general inquiries and may offer a form to sign up for updates. When you
            complete a form, you provide the information requested by that form, such as contact details or a message.
            These features are intended to let us receive inquiries or subscription requests.
          </p>
          <p>
            Please do not submit payment card details or other sensitive personal information through a general contact
            form.
          </p>
        </div>
      </section>

      <section>
        <h2 class={headingClass}>Website Analytics</h2>
        <p class={bodyClass}>
          Our website uses Google Analytics 4 and Google Tag Manager. Depending on the configuration, these tools can
          process website activity and technical information, such as page interactions, browser details and device
          information.
        </p>
      </section>

      <section>
        <h2 class={headingClass}>Online Ordering and External Services</h2>
        <div class={`${bodyClass} space-y-5`}>
          <p>
            Our online ordering links direct you to DoorDash. Information you enter while using DoorDash is handled
            through that service and is subject to its own privacy practices. Please review DoorDash's privacy
            information when ordering.
          </p>
          <p>
            Our website may also link to services such as Google Maps for directions. External websites and services
            have their own privacy practices.
          </p>
        </div>
      </section>

      <section>
        <h2 class={headingClass}>Privacy Questions</h2>
        <p class={bodyClass}>
          For questions about privacy and the information you share through this website, please use our
          <a class={linkClass} href="/contact">Contact page</a> to reach us.
        </p>
      </section>

      <section>
        <h2 class={headingClass}>Changes to This Notice</h2>
        <p class={bodyClass}>
          This notice may be updated as our website features and practices change. The latest version will be available
          on this page.
        </p>
      </section>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <CTABanner
    title="Privacy Questions"
    subtitle="For questions about privacy and the information you share through this website, please use our Contact page to reach us."
    actions={[{ variant: 'primary', text: 'Contact Us', href: '/contact' }]}
  />
</Layout>
