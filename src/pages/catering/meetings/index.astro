---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CateringSubNav from '~/components/widgets/CateringSubNav.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import { CATERING_CTA_HREF, LOCATION_CTA_HREF } from '~/config/cta';
import { getSanityCateringImages } from '~/lib/content/sanity';

const cateringImages = await getSanityCateringImages();

const metadata = {
  title: 'Meeting Catering Oahu | Boardroom Meals | El Ranchero',
  description:
    'Order fresh meeting catering for your business. We prepare salad trays, wrap platters, fresh soups, and beverages for pickup across our six Oahu locations.',
  ignoreTitleTemplate: true,
};

const occasions = [
  {
    number: '01',
    title: 'Working Lunches',
    description:
      'Keep your agenda moving. Our handheld wrap platters and signature salad trays offer easy meals that allow your team to work through the lunch hour uninterrupted.',
  },
  {
    number: '02',
    title: 'Boardroom Presentations',
    description:
      'Serve high-quality ingredients to your board members or clients. Nothing changes for a catering order. Same scratch-made dressings, same produce, same ahi.',
  },
  {
    number: '03',
    title: 'Morning Huddles',
    description:
      'Start your strategy sessions with something lighter. Our catering options provide a fresh alternative to heavy baked goods or fried foods.',
  },
  {
    number: '04',
    title: 'Accommodating Every Diet',
    description:
      'Ensure every attendee has a meal. We provide dedicated vegetarian options and plant-based trays for your meeting guests.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="Meeting Catering"
    content="Provide fresh food for your next business discussion. We prepare large-format catering trays and wrap platters for board meetings and planning sessions. All meeting orders are available for pickup across our six Oahu locations."
    image={cateringImages.meetings}
    actions={[
      { variant: 'primary', text: 'Order Catering Online', href: CATERING_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'View Full Catering Menu', href: '/catering' },
    ]}
  />

  <section class="not-prose relative w-full overflow-hidden bg-page" aria-label="Meeting catering occasions">

    <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          occasions.map((occ) => (
            <article class="group relative flex flex-col justify-between overflow-hidden bg-section-dark px-8 pb-8 pt-10 md:px-10 md:pb-10 md:pt-12">
              <span
                class="pointer-events-none absolute right-6 top-4 select-none font-rough text-[96px] leading-none text-contrast/[0.07] md:text-[120px]"
                aria-hidden="true"
              >
                {occ.number}
              </span>
              <div class="relative flex flex-col gap-4">
                <span class="font-rough text-[15px] leading-none text-contrast/90">{occ.number}</span>
                <Heading variant="h3" color="white">
                  {occ.title}
                </Heading>
                <Text color="white" class="text-contrast/75 leading-relaxed">
                  {occ.description}
                </Text>
              </div>
              <div class="mt-8 h-px w-12 bg-accent" />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CateringSubNav
    excludeHref="/catering/meetings"
    subtitle="We provide catering services for various event types. Explore our other catering menus below:"
  />

  <FAQs
    isDark={true}
    title="Frequently Asked Questions"
    items={[
      {
        title: 'How much notice is required for a morning meeting?',
        description: 'Please contact your nearest location to confirm specific lead times for early pickup orders.',
      },
      {
        title: 'Are serving utensils included for boardrooms?',
        description: 'Ask the store when you order and they will let you know what is included.',
      },
      {
        title: 'Can I provide meatless options for my attendees?',
        description:
          'Yes. We prepare dedicated plant-based items including the Aloha Mediterranean Tray and the Aloha Passion Tray.',
      },
      {
        title: 'How much food do I need for a board meeting?',
        description:
          'Please contact your nearest location to confirm specific serving sizes and tray yields based on your total headcount.',
      },
      {
        title: 'Can I add individual drinks to the meeting order?',
        description:
          'Yes. You can include bottled beverages and our refreshing Big Island mamaki mint tea to complete your boardroom setup.',
      },
    ]}
  />

  <CTABanner
    title="Ready to Order?"
    subtitle="Order online for pickup. If you need an early collection, call the store first to check timings."
    ctaText="Order Catering Online"
    ctaHref={CATERING_CTA_HREF}
    secondaryCtaText="Find a Location"
    secondaryCtaHref={LOCATION_CTA_HREF}
  />
</PageLayout>
