---
/**
 * Catering hub — all copy, links and photos come from the Sanity "Catering hub"
 * singleton (`cateringContent`); defaults live in src/data/pages/catering.ts.
 * The request form posts through the site contact worker (recipient to be confirmed with the client).
 * Composes shared widgets only.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import BuildSteps from '~/components/widgets/BuildSteps.astro';
import LocationMaps from '~/components/widgets/LocationMaps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import Form from '~/components/ui/Form.astro';
import BulletList from '~/components/ui/BulletList.astro';
import { storeLocations } from '~/data/locations';
import { cateringOptionPages } from '~/data/catering';
import { getCateringHubContent } from '~/lib/content';
import { paragraphsToHtml } from '~/lib/content/inlineLink';
import { RICH_LINK_CLASS, richToHtml, richToHtmlString } from '~/lib/content/richText';

const c = await getCateringHubContent();

const metadata = { title: c.seoTitle, description: c.seoDescription, ignoreTitleTemplate: true };

const cateringOptionLinks = cateringOptionPages
  .map((page) => `<a class="${RICH_LINK_CLASS}" href="${page.href}">${page.label}</a>`)
  .reduce((sentence, link, index, links) => {
    if (index === 0) return link;
    const separator = index === links.length - 1 ? ', and ' : ', ';
    return `${sentence}${separator}${link}`;
  }, '');

// Form inputs are fixed by the contact worker; only the labels around them are editable.
const requestInputs = [
  { type: 'text', name: 'name', label: 'Name', autocomplete: 'name', required: true },
  { type: 'email', name: 'email', label: 'Email', autocomplete: 'email', required: true },
  { type: 'tel', name: 'phone', label: 'Phone', autocomplete: 'tel' },
  { type: 'date', name: 'eventDate', label: 'Event date' },
  { type: 'number', name: 'guests', label: 'Estimated number of guests' },
  {
    type: 'select',
    name: 'location',
    label: 'Preferred location',
    placeholder: 'Select a location',
    options: [
      { label: 'Wahiawa', value: 'wahiawa' },
      { label: 'Kapolei', value: 'kapolei' },
      { label: 'Not sure yet', value: 'not-sure' },
    ],
  },
];

const faqItems = c.faqs.map((faq) => ({ title: faq.question, description: richToHtmlString(faq.answer) }));
const exploreHtml = richToHtml(c.exploreParagraphs);
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    image={c.heroImage}
    title={c.heroTitle}
    content={paragraphsToHtml(c.heroParagraphs)}
    actions={[{ variant: 'primary', text: c.heroButton.text, href: c.heroButton.href }]}
  />

  <TextSplit id="catering-form" heading={c.formHeading} alignTop class="scroll-mt-24">
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-6">
        {c.formParagraphs.map((paragraph) => <Text color="default">{paragraph}</Text>)}
      </div>
      <Form
        inputs={requestInputs}
        textarea={{ name: 'message', label: c.formMessageLabel, rows: 5 }}
        button={c.formButtonLabel}
      />
      <div class="flex flex-col items-start gap-3">
        <Text color="default">{c.callPrompt}</Text>
        <Button
          variant="ghost"
          tone="light"
          text={`Call ${c.phoneDisplay}`}
          href={c.phoneHref}
          hideNote={true}
        />
      </div>
    </div>
  </TextSplit>

  <MenuItemsSection
    id="favorites"
    tone="card"
    columns={4}
    title={c.favoritesTitle}
    intro={c.favoritesIntro}
    items={c.favoritesItems}
    footnote={c.favoritesFootnote}
  />

  <TextSplit id="occasions" heading={c.occasionsHeading} withImage image={c.occasionsImage} imageAspect="4 / 3">
    <div class="flex flex-col gap-6">
      {c.occasionsIntro.map((paragraph) => <Text color="default">{paragraph}</Text>)}
      <BulletList items={c.occasionsBullets} />
      {c.occasionsOutro.map((paragraph) => <Text color="default">{paragraph}</Text>)}
    </div>
  </TextSplit>

  <TextSplit
    id="why-cater"
    heading={c.whyHeading}
    class="bg-card"
    withImage
    image={c.whyImage}
    imageAspect="4 / 3"
    imageReverse
  >
    <div class="flex flex-col gap-6">
      {c.whyParagraphs.map((paragraph) => <Text color="default">{paragraph}</Text>)}
    </div>
  </TextSplit>

  <Testimonials
    id="reviews"
    heading={c.reviewsHeading}
    subtitle={c.reviewsSubtitle}
    testimonials={c.reviews.map((review) => ({ ...review, platform: 'google' as const }))}
    footnote={c.reviewsFootnote}
    actions={c.reviewLinks}
  />

  <BuildSteps id="how-it-works" tone="card" hideImage title={c.stepsTitle} steps={c.steps} />

  <TextSplit id="planning" heading={c.planningHeading} withImage image={c.planningImage} imageAspect="4 / 3">
    <div class="flex flex-col gap-6">
      {c.planningIntro.map((paragraph) => <Text color="default">{paragraph}</Text>)}
      <BulletList items={c.planningChecklist} />
      {c.planningOutro.map((paragraph) => <Text color="default">{paragraph}</Text>)}
    </div>
  </TextSplit>

  <TextSplit
    id="explore-menu"
    heading={c.exploreHeading}
    class="bg-card"
    withImage
    image={c.exploreImage}
    imageAspect="4 / 3"
    imageReverse
  >
    <div class="flex flex-col items-start gap-6">
      {exploreHtml.map((html) => <Text color="default" html={html} />)}
      <Text color="default" html={`${c.exploreOptionsLead} ${cateringOptionLinks}.`} />
      {c.exploreButton.text && <Button variant="primary" text={c.exploreButton.text} href={c.exploreButton.href} hideNote={true} />}
    </div>
  </TextSplit>

  <LocationMaps
    id="locations"
    title={c.locationsTitle}
    subtitle={c.locationsSubtitle}
    stores={storeLocations}
    footnote={c.locationsFootnote}
  />

  <FAQs id="faqs" isDark title={c.faqsTitle} items={faqItems} />

  <CTABanner
    title={c.ctaTitle}
    subtitle={c.ctaSubtitle}
    actions={[{ variant: 'primary', text: c.ctaButton.text, href: c.ctaButton.href }]}
  />
</PageLayout>
