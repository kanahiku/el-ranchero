---
/**
 * Catering — copy from pages-content/Catering.docx.
 * The request form posts through the site contact worker (recipient to be confirmed with the client).
 * The doc lists (808) 621-9000 as the catering phone; the Wahiawa / Kapolei location pages use their own numbers.
 * The optional catering photo gallery is omitted until real catering photography exists.
 * Poster layout. Photos come from the Sanity "Catering" singleton.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import PosterButton from '~/components/home/PosterButton.astro';
import HomePhoto from '~/components/home/HomePhoto.astro';
import Lanterns from '~/components/home/Lanterns.astro';
import Blossom from '~/components/home/Blossom.astro';
import ArtAgave from '~/assets/images/v3/art-agave.svg';
import ArtCactus from '~/assets/images/v3/art-cactus.svg';
import ArtEagle from '~/assets/images/v3/art-eagle.svg';
import ArtFlourish from '~/assets/images/v3/art-flourish.svg';
import Calavera from '~/assets/images/v3/calavera.svg';
import CalaveraSmall from '~/assets/images/v3/calavera2.svg';
import Form from '~/components/ui/Form.astro';
import { storeLocations, storeMapEmbedSrc } from '~/data/locations';
import { cateringOptionPages } from '~/data/catering';
import { getCateringImages } from '~/lib/content';

const images = await getCateringImages();

const cateringOptionLinks = cateringOptionPages
  .map((page) => `<a href="${page.href}">${page.label}</a>`)
  .reduce((sentence, link, index, links) => {
    if (index === 0) return link;
    const separator = index === links.length - 1 ? ', and ' : ', ';
    return `${sentence}${separator}${link}`;
  }, '');

const metadata = {
  title: 'Mexican Catering in Wahiawa & Kapolei | Taqueria El Ranchero',
  description:
    'Planning an event or group meal? Explore Mexican catering from Taqueria El Ranchero in Wahiawa and Kapolei and submit a catering request today.',
  ignoreTitleTemplate: true,
};

const CATERING_PHONE_DISPLAY = '(808) 621-9000';
const CATERING_PHONE_HREF = 'tel:+18086219000';

const requestInputs = [
  { type: 'text', name: 'name', label: 'Name', autocomplete: 'name', required: true },
  { type: 'email', name: 'email', label: 'Email', autocomplete: 'email', required: true },
  { type: 'tel', name: 'phone', label: 'Phone', autocomplete: 'tel' },
  { type: 'date', name: 'eventDate', label: 'Event date' },
  { type: 'number', name: 'guests', label: 'Estimated number of guests' },
  {
    type: 'select',
    name: 'location',
    label: 'Preferred location',
    placeholder: 'Select a location',
    options: [
      { label: 'Wahiawa', value: 'wahiawa' },
      { label: 'Kapolei', value: 'kapolei' },
      { label: 'Not sure yet', value: 'not-sure' },
    ],
  },
];

const favorites = [
  {
    title: 'Tacos',
    image: images.favoriteTacos,
    description:
      'A taqueria favorite that works well when you are feeding a group and want plenty of flavor and variety.',
  },
  {
    title: 'Burritos',
    image: images.favoriteBurritos,
    description: 'Bring a hearty El Ranchero favorite to the table with available burrito options for your gathering.',
  },
  {
    title: 'Mexican Favorites',
    image: images.favoriteMexican,
    description:
      'Ask about available Mexican dishes and group-friendly options that can help round out your catering order.',
  },
  {
    title: 'Sides & More',
    image: images.favoriteSides,
    description: 'Complete your spread with available sides and other additions based on your event needs.',
  },
];

const occasions = [
  'Workplace meals and meetings',
  'Birthday parties',
  'Family celebrations',
  'Team gatherings',
  'Community events',
  'Group lunches and dinners',
  'Other special occasions',
];

const reviews = [
  {
    quote: 'Cold drinks, great food! Fast service and the food is hot and fresh.',
    name: 'Ali V.',
    location: 'Wahiawa',
  },
  {
    quote: 'Great service and spacious atmosphere. The kids menu was a plus. I really enjoyed the quesadilla.',
    name: 'Lawanda M.',
    location: 'Kapolei',
  },
  {
    quote: 'Outstanding food! Best Mexican I’ve had in Hawaii.',
    name: 'John S.',
    location: 'Kapolei',
  },
];

const reviewLinks = [
  {
    text: 'Read Wahiawa Google Reviews',
    href: 'https://www.google.com/maps/place/Taqueria+El+Ranchero/@21.4785894,-157.9185514,12.25z/data=!4m6!3m5!1s0x7c005df2e6157385:0x308420cdf244ff60!8m2!3d21.4971101!4d-158.0255454!16s%2Fg%2F11b77try2q?entry=tts&g_ep=EgoyMDI0MDkxMS4wKgBIAVAD',
  },
  {
    text: 'Read Kapolei Google Reviews',
    href: 'https://www.google.com/maps/place/Taqueria+El+Ranchero/@21.3332283,-158.0501425,15z/data=!4m6!3m5!1s0x7c006312335dd9e7:0x38722efab8df9697!8m2!3d21.3332283!4d-158.0501425!16s%2Fg%2F11nmwp8kf6?entry=ttu&g_ep=EgoyMDI2MDgxMS4wIKXMDSoASAFQAw%3D%3D',
  },
];

const steps = [
  {
    title: 'Tell Us About Your Event',
    description:
      'Complete the catering form with your preferred date, estimated guest count and any details that can help us understand what you are planning.',
  },
  {
    title: 'We’ll Review Your Request',
    description:
      'Our team can follow up to discuss current catering options, availability and other details related to your event.',
  },
  {
    title: 'Finalize Your Catering Order',
    description:
      'Once the details are confirmed, work with the El Ranchero team to finalize your selections and next steps.',
  },
];

const planningChecklist = [
  'Event date and preferred time',
  'Estimated number of guests',
  'Type of event or gathering',
  'Food preferences or requests',
  'Dietary needs we should know about',
  'Preferred location, if applicable',
  'The best way to contact you',
];

const faqs = [
  {
    title: 'How do I request catering from Taqueria El Ranchero?',
    description: `Complete the catering form on this page with information about your event. You can also call ${CATERING_PHONE_DISPLAY} to ask about catering.`,
  },
  {
    title: 'Does Taqueria El Ranchero have a catering menu?',
    description:
      'Catering selections may differ from the regular restaurant menu. Submit a catering request to learn about current food options for your event.',
  },
  {
    title: 'How much does El Ranchero catering cost?',
    description:
      'Catering pricing depends on your selections and the details of your order. Submit a catering request so the El Ranchero team can discuss current options and pricing with you.',
  },
  {
    title: 'How far in advance should I request catering?',
    description:
      'Availability can depend on your event date and the needs of your order. Submit your request as early as possible so the team can confirm availability.',
  },
  {
    title: 'Can El Ranchero cater a large group?',
    description:
      'Include your estimated guest count in your catering request. The El Ranchero team can confirm available options based on the size and needs of your group.',
  },
  {
    title: 'Can I request catering for a workplace event?',
    description:
      'Yes. Tell us about your workplace meal, meeting or gathering using the catering form and include your estimated guest count, date and preferred time.',
  },
  {
    title: 'Is the catering menu the same as the restaurant menu?',
    description:
      'Not necessarily. You can browse the <a href="/menu">El Ranchero menu</a> to explore the food served at our restaurants, but catering selections and availability may differ.',
  },
  {
    title: 'Does El Ranchero offer catering from both Wahiawa and Kapolei?',
    description:
      'Taqueria El Ranchero has locations in both Wahiawa and Kapolei. Include your event details and preferred area when submitting your catering request so the team can help determine the appropriate next steps.',
  },
];
---

<PageLayout metadata={metadata}>
  <div class="v3-interior">
    <section class="v3-menu-hero" aria-labelledby="catering-title">
      <Lanterns class="v3-menu-lanterns" />
      <div class="v3-wrap v3-menu-hero-frame">
        <div class="v3-menu-hero-copy">
          <h1 id="catering-title" class="v3-display">
            Mexican Catering<br />
            from Taqueria<br />
            El Ranchero
          </h1>
          <div class="v3-menu-copy flex flex-col items-start gap-4">
            <p>Bring Ranchero-style Mexican food to your next gathering with catering from Taqueria El Ranchero.</p>
            <p>
              Whether you are feeding coworkers, family, friends or a larger group, tell us what you are planning and
              our team can help you explore catering options for your event.
            </p>
            <PosterButton text="Request Catering" href="#catering-form" tone="gold" class="mt-4" />
          </div>
        </div>
        <div class="v3-menu-hero-media">
          <HomePhoto
            image={images.hero}
            class="v3-menu-hero-photo"
            sizes="(min-width: 768px) 48vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section
      id="catering-form"
      class="v3-section v3-paper v3-on-paper scroll-mt-24"
      aria-labelledby="catering-form-title"
    >
      <Blossom class="v3-art v3-art-bloom-explore" fill="var(--v3-red)" center="var(--v3-red)" />
      <ArtAgave class="v3-art v3-art-agave" aria-hidden="true" />
      <div class="v3-wrap v3-form-split">
        <div>
          <div class="v3-ihead">
            <h2 id="catering-form-title" class="v3-display">Tell Us About Your Catering Needs</h2>
          </div>
          <div class="v3-prose">
            <p>Ready to start planning? Share a few details about your event using the form below.</p>
            <p>
              Let us know your event date, approximately how many people you are feeding and anything else that can help
              our team understand what you are looking for.
            </p>
            <p>Prefer to speak with us directly?</p>
            <PosterButton text={`Call ${CATERING_PHONE_DISPLAY}`} href={CATERING_PHONE_HREF} tone="outline" />
          </div>
        </div>
        <div class="v3-form-panel">
          <Form
            inputs={requestInputs}
            textarea={{
              name: 'message',
              label: 'Tell us about your event, food preferences and any dietary needs',
              rows: 4,
            }}
            button="Request Catering"
          />
        </div>
      </div>
    </section>

    <section id="favorites" class="v3-section" aria-labelledby="favorites-title">
      <div class="v3-wrap">
        <div class="v3-ihead">
          <h2 id="favorites-title" class="v3-display">Catering Favorites</h2>
          <p>
            Planning food for a group? Bring some of the flavors people know from Taqueria El Ranchero to your next
            gathering.
          </p>
          <p>
            Depending on your event and current catering availability, our team can help you explore options inspired by
            the food served at our restaurants.
          </p>
        </div>
        <div class="v3-fav-grid">
          {
            favorites.map((item) => (
              <article class="v3-menu-card">
                <HomePhoto image={item.image} sizes="(min-width: 768px) 50vw, 100vw" />
                <div class="v3-menu-card-body">
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              </article>
            ))
          }
        </div>
        <p class="v3-note">
          Catering selections may differ from our regular restaurant menu. Submit a catering request to confirm current
          options, availability and pricing for your event.
        </p>
      </div>
    </section>

    <section id="occasions" class="v3-section v3-red-band" aria-labelledby="occasions-title">
      <Blossom class="v3-art v3-art-bloom" fill="var(--v3-ink)" center="var(--v3-ink)" />
      <ArtEagle class="v3-art v3-art-eagle" aria-hidden="true" />
      <div class="v3-wrap">
        <div class="v3-ihead">
          <h2 id="occasions-title" class="v3-display">Bring Ranchero Style to Your Next Gathering</h2>
          <p>Good food gives people one more reason to gather around the table.</p>
          <p>El Ranchero catering can be a fit for a range of group occasions, including:</p>
        </div>
        <ul class="v3-occasion-list">
          {occasions.map((item) => <li>{item}</li>)}
        </ul>
        <p class="v3-body">
          Tell us what you are planning and our team can help you explore catering options for your date and group.
        </p>
      </div>
    </section>

    <section
      id="why-cater"
      class="v3-section v3-menu-breakfast v3-scalloped v3-center"
      aria-labelledby="why-cater-title"
    >
      <div class="v3-scallop v3-scallop-red" aria-hidden="true"></div>
      <ArtFlourish class="v3-art v3-art-flourish" aria-hidden="true" />
      <div class="v3-wrap">
        <div class="v3-ihead">
          <h2 id="why-cater-title" class="v3-display">Why Cater with Taqueria El Ranchero?</h2>
        </div>
        <div class="v3-prose">
          <p>
            Taqueria El Ranchero has been serving Oʻahu since 2015, beginning with our original Wahiawa location and
            later expanding to Kapolei.
          </p>
          <p>
            El Ranchero is a veteran-founded local business built around the taqueria experience and Ranchero-style
            Mexican food.
          </p>
          <p>
            The restaurant has also earned local recognition, including Gold for Best Mexican in HONOLULU Magazine’s
            2023 Hale ʻAina Awards.
          </p>
          <p>
            When you are planning food for a group, catering gives you another way to bring El Ranchero flavors to the
            occasion.
          </p>
        </div>
      </div>
    </section>

    <section id="reviews" class="v3-section v3-reviews" aria-labelledby="reviews-title">
      <CalaveraSmall class="v3-calavera v3-calavera-l" aria-hidden="true" />
      <Calavera class="v3-calavera v3-calavera-r" aria-hidden="true" />
      <div class="v3-wrap v3-center">
        <div class="v3-ihead">
          <h2 id="reviews-title" class="v3-display">What Guests Are Saying</h2>
          <p>See what guests have shared about their experiences at Taqueria El Ranchero.</p>
        </div>
        <ul class="v3-review-grid">
          {
            reviews.map((review) => (
              <li>
                <figure class="v3-quote">
                  <p class="stars" aria-label="5 out of 5 stars">
                    ★★★★★
                  </p>
                  <blockquote>
                    <q>{review.quote}</q>
                  </blockquote>
                  <figcaption>
                    <cite>
                      {review.name} · {review.location}
                    </cite>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
        <p class="v3-note">
          Reviews above reflect guests’ restaurant experiences and are not presented as catering-specific testimonials.
        </p>
        <div class="v3-link-row v3-link-row-center">
          {reviewLinks.map((link) => <PosterButton text={link.text} href={link.href} tone="dark" />)}
        </div>
      </div>
    </section>

    <section id="how-it-works" class="v3-section v3-paper" aria-labelledby="how-title">
      <div class="v3-wrap">
        <div class="v3-ihead">
          <h2 id="how-title" class="v3-display">How El Ranchero Catering Works</h2>
        </div>
        <div class="v3-loc-grid">
          {
            steps.map((step) => (
              <article class="v3-menu-card">
                <div class="v3-menu-card-body">
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="planning" class="v3-section v3-center" aria-labelledby="planning-title">
      <div class="v3-wrap">
        <div class="v3-ihead">
          <h2 id="planning-title" class="v3-display">Planning Your Catering Order</h2>
        </div>
        <div class="v3-prose">
          <p>You do not need to have every detail figured out before reaching out.</p>
          <p>When submitting your catering request, it helps to include:</p>
          <ul class="v3-plain-list">
            {planningChecklist.map((item) => <li>{item}</li>)}
          </ul>
          <p>
            Providing these details helps our team better understand what you need and follow up with the right
            information.
          </p>
        </div>
      </div>
    </section>

    <section id="explore-menu" class="v3-section v3-paper v3-scalloped v3-center" aria-labelledby="explore-title">
      <div class="v3-scallop" aria-hidden="true"></div>
      <div class="v3-wrap">
        <div class="v3-ihead">
          <h2 id="explore-title" class="v3-display">Explore the El Ranchero Menu</h2>
        </div>
        <div class="v3-prose">
          <p>Want to get a feel for the food before planning your catering order?</p>
          <p>
            Explore the <a href="/menu">Taqueria El Ranchero menu</a> to see the Ranchero-style Mexican dishes served at our
            restaurants.
          </p>
          <p>
            Keep in mind that catering selections may differ from the regular restaurant menu. Submit a catering request
            to confirm what is currently available for your group.
          </p>
          <p set:html={`Looking for a specific catering option? See ${cateringOptionLinks}.`} />
          <PosterButton text="Explore Our Menu" href="/menu" tone="gold" />
        </div>
      </div>
    </section>

    <section id="locations" class="v3-section" aria-labelledby="catering-locations-title">
      <div class="v3-wrap">
        <div class="v3-ihead">
          <h2 id="catering-locations-title" class="v3-display">Catering in Wahiawa & Kapolei</h2>
          <p>Taqueria El Ranchero has two Oʻahu locations serving Wahiawa, Kapolei and surrounding communities.</p>
        </div>
        <div class="v3-loc-grid">
          {
            storeLocations.map((store) => (
              <article class="v3-loc-card">
                <div class="v3-loc-body">
                  <h2>{store.name}</h2>
                  <address class="v3-loc-address">
                    <span>{store.addressLine1}</span>
                    <span>{store.addressLine2}</span>
                  </address>
                  <div class="v3-loc-actions">
                    <PosterButton text={`Visit Our ${store.name} Location`} href={store.href} tone="gold" />
                  </div>
                </div>
                <iframe
                  class="v3-map"
                  title={`Map of Taqueria El Ranchero ${store.name}`}
                  src={storeMapEmbedSrc(store)}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                />
              </article>
            ))
          }
        </div>
        <p class="v3-note">
          Not sure which location to contact about your event? Submit your catering request with the event details and
          our team can help with the next steps.
        </p>
      </div>
    </section>

    <section id="faqs" class="v3-section v3-paper v3-plain" aria-labelledby="faqs-title">
      <ArtCactus class="v3-art v3-art-cactus" aria-hidden="true" />
      <div class="v3-wrap">
        <div class="v3-ihead">
          <h2 id="faqs-title" class="v3-display">Catering FAQs</h2>
        </div>
        <div class="v3-faq">
          {
            faqs.map((item) => (
              <details>
                <summary>{item.title}</summary>
                <div class="v3-body" set:html={item.description} />
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="v3-section v3-center" aria-labelledby="catering-cta-title">
      <div class="v3-wrap">
        <div class="v3-ihead">
          <h2 id="catering-cta-title" class="v3-display">Ready to Plan Your Catering Order?</h2>
        </div>
        <div class="v3-menu-copy flex max-w-3xl flex-col gap-4">
          <p>
            Tell us about your event, your group and what you have in mind. Submit the catering form and the El Ranchero
            team can help you explore the options available for your gathering.
          </p>
          <PosterButton text="Request Catering" href="#catering-form" tone="gold" class="mt-4" />
        </div>
      </div>
    </section>
  </div>
</PageLayout>
