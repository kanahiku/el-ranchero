---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CateringSubNav from '~/components/widgets/CateringSubNav.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import { CATERING_CTA_HREF, LOCATION_CTA_HREF } from '~/config/cta';
import { getSanityCateringImages } from '~/lib/content/sanity';

const cateringImages = await getSanityCateringImages();

const metadata = {
  title: 'Large Group Catering Oahu | Salads & Wraps | El Ranchero',
  description:
    'Order fresh catering for your large group. We prepare salad trays, wrap platters, fresh soups, and beverages for pickup across our six Oahu locations.',
  ignoreTitleTemplate: true,
};

const occasions = [
  {
    number: '01',
    title: 'Flexible Menu Options',
    description:
      'Feed your crowd with fresh, healthy meals. Our signature salad trays and sandwich platters offer easy sharing for big groups with varying tastes.',
  },
  {
    number: '02',
    title: 'Dietary Accommodations',
    description:
      'Ensure every guest has a meal they can enjoy. We provide dedicated vegetarian options and plant-based trays to meet diverse dietary requirements within your large group.',
  },
  {
    number: '03',
    title: 'Same Ingredients, Bigger Trays',
    description:
      "Scaling up does not change what goes in. Scratch-made dressings, vine-ripe Hauula tomatoes, never-frozen local ahi.",
  },
  {
    number: '04',
    title: 'Seamless Pickup',
    description:
      'We package large orders efficiently so you can transport your food safely. You can retrieve your catering trays from any of our six neighborhood restaurants.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="Large Group Catering"
    content="Provide fresh food for your large gathering. We prepare large-format catering trays and wrap platters for groups of all sizes. All large group orders are available for pickup across our six Oahu locations."
    image={cateringImages.largeGroups}
    actions={[
      { variant: 'primary', text: 'Order Catering Online', href: CATERING_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'View Full Catering Menu', href: '/catering' },
    ]}
  />

  <section class="not-prose relative w-full overflow-hidden bg-page" aria-label="Large group catering occasions">

    <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          occasions.map((occ) => (
            <article class="group relative flex flex-col justify-between overflow-hidden bg-section-dark px-8 pb-8 pt-10 md:px-10 md:pb-10 md:pt-12">
              <span
                class="pointer-events-none absolute right-6 top-4 select-none font-rough text-[96px] leading-none text-contrast/[0.07] md:text-[120px]"
                aria-hidden="true"
              >
                {occ.number}
              </span>
              <div class="relative flex flex-col gap-4">
                <span class="font-rough text-[15px] leading-none text-contrast/90">{occ.number}</span>
                <Heading variant="h3" color="white">
                  {occ.title}
                </Heading>
                <Text color="white" class="text-contrast/75 leading-relaxed">
                  {occ.description}
                </Text>
              </div>
              <div class="mt-8 h-px w-12 bg-accent" />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CateringSubNav
    excludeHref="/catering/large-groups"
    subtitle="We provide catering services for various event types. Explore our other catering menus below:"
  />

  <FAQs
    isDark={true}
    title="Frequently Asked Questions"
    items={[
      {
        title: 'How much notice is required for a large group order?',
        description:
          'Please contact your nearest location to confirm the required lead time for your specific headcount.',
      },
      {
        title: 'How do I calculate serving sizes for a large crowd?',
        description:
          'Please contact your nearest location to confirm specific serving sizes and tray yields based on your total guest count.',
      },
      {
        title: 'Are serving utensils included for large orders?',
        description: 'Ask the store when you order and they will let you know what is included.',
      },
      {
        title: 'Can I order meatless options for a large group?',
        description:
          'Yes. We prepare dedicated plant-based items including the Aloha Mediterranean Tray and the Aloha Passion Tray.',
      },
      {
        title: 'Do you provide drinks for large group catering?',
        description:
          'Yes. You can include bottled beverages and our refreshing Big Island mamaki mint tea with your catering order.',
      },
    ]}
  />

  <CTABanner
    title="Ready to Order?"
    subtitle="Order online for pickup. Call the store first on anything over a few trays so we can plan it properly."
    ctaText="Order Catering Online"
    ctaHref={CATERING_CTA_HREF}
    secondaryCtaText="Find a Location"
    secondaryCtaHref={LOCATION_CTA_HREF}
  />
</PageLayout>
