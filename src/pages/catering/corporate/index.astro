---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CateringSubNav from '~/components/widgets/CateringSubNav.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import { CATERING_CTA_HREF, LOCATION_CTA_HREF } from '~/config/cta';
import { getSanityCateringImages } from '~/lib/content/sanity';

const cateringImages = await getSanityCateringImages();

const metadata = {
  title: 'Corporate Catering Oahu | Seminars & Events | El Ranchero',
  description:
    'Order fresh corporate catering for your Oahu business. We prepare salad trays and wrap platters for seminars, training days, client presentations, and company milestones.',
  ignoreTitleTemplate: true,
};

const occasions = [
  {
    number: '01',
    title: 'Seminars and Conferences',
    description:
      'Keep your attendees focused with light, fresh meals. Our signature salad trays provide a light, fresh alternative to heavy corporate event food.',
  },
  {
    number: '02',
    title: 'Client Presentations',
    description:
      'Serve a professional meal during your next client pitch. Our sandwich platters and custom wrap trays offer easy, handheld options that allow your meeting to continue uninterrupted.',
  },
  {
    number: '03',
    title: 'Employee Appreciation',
    description:
      "Reward your team with high-quality ingredients. The trays are the same food we serve over the counter, just scaled up. Scratch-made dressings, vine-ripe Hauula tomatoes, never-frozen local ahi.",
  },
  {
    number: '04',
    title: 'Company Milestones',
    description:
      'Celebrate your organizational achievements with a fresh menu. We offer scaled-up versions of our signature items to feed your entire department or branch.',
  },
];
---

<PageLayout metadata={metadata}>
  {/* ── 1. Hero ───────────────────────────────────────────── */}
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="Corporate Catering"
    content="Provide fresh meals for your next business event. We prepare large-format catering trays and wrap platters designed for corporate groups. All corporate orders are available for pickup across our six Oahu locations."
    image={cateringImages.corporate}
    actions={[
      { variant: 'primary', text: 'Order Catering Online', href: CATERING_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'View Full Catering Menu', href: '/catering' },
    ]}
  />

  {/* ── 2. Corporate occasions — 2×2 editorial card grid ─── */}
  <section class="not-prose relative w-full overflow-hidden bg-page" aria-label="Corporate catering occasions">

    <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
      {/* 2×2 card grid */}
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          occasions.map((occ) => (
            <article class="group relative flex flex-col justify-between overflow-hidden bg-section-dark px-8 pb-8 pt-10 md:px-10 md:pb-10 md:pt-12">
              {/* Large ghosted number — top-right decorative */}
              <span
                class="pointer-events-none absolute right-6 top-4 select-none font-rough text-[96px] leading-none text-contrast/[0.07] md:text-[120px]"
                aria-hidden="true"
              >
                {occ.number}
              </span>

              {/* Content */}
              <div class="relative flex flex-col gap-4">
                {/* Small accent number badge */}
                <span class="font-rough text-[15px] leading-none text-contrast/90">{occ.number}</span>
                <Heading variant="h3" color="white">
                  {occ.title}
                </Heading>
                <Text color="white" class="text-contrast/75 leading-relaxed">
                  {occ.description}
                </Text>
              </div>

              {/* Bottom accent rule */}
              <div class="mt-8 h-px w-12 bg-accent" />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── 3. Other catering sub-pages ───────────────────────── */}
  <CateringSubNav
    excludeHref="/catering/corporate"
    subtitle="We provide catering services for various event types. Explore our other catering menus below:"
  />

  {/* ── 4. FAQs ──────────────────────────────────────────── */}
  <FAQs
    isDark={true}
    title="Frequently Asked Questions"
    items={[
      {
        title: 'Do you provide corporate catering for multiple days?',
        description: 'Yes. We can schedule pickup orders for multi-day seminars and training events.',
      },
      {
        title: 'Can I accommodate vegetarian and vegan employees?',
        description: 'Yes. We prepare dedicated plant-based options including the meatless Aloha Passion Tray.',
      },
      {
        title: 'Are serving utensils included for office setups?',
        description: 'Ask the store when you order and they will let you know what is included.',
      },
      {
        title: 'How do I request an invoice for corporate billing?',
        description:
          'Please contact your nearest location directly to discuss payment options and receipt requirements for your accounting department.',
      },
      {
        title: 'Can we add individual drinks to a corporate order?',
        description:
          'Yes. You can include bottled beverages and our refreshing Big Island mamaki mint tea with your catering trays.',
      },
    ]}
  />

  {/* ── 5. Ready to order CTA ────────────────────────────── */}
  <CTABanner
    title="Ready to Order?"
    subtitle="Order online for pickup. For anything about timing or quantities on a big corporate order, call the store direct."
    ctaText="Order Catering Online"
    ctaHref={CATERING_CTA_HREF}
    secondaryCtaText="Find a Location"
    secondaryCtaHref={LOCATION_CTA_HREF}
  />
</PageLayout>
