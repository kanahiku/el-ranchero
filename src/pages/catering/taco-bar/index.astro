---
/**
 * Taco Bar Catering — copy from the Drive doc "/catering/taco-bar - Taco Bar Catering".
 * The request button goes to the catering hub form.
 * Composes shared widgets only. Photos come from the Sanity "Catering" singleton
 * (`cateringContent`); a missing photo renders the grey placeholder.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Button from '~/components/ui/Button.astro';
import Text from '~/components/ui/Text.astro';
import { getCateringImages } from '~/lib/content';
import { CATERING_REQUEST_HREF, cateringOptionPages } from '~/data/catering';

const images = await getCateringImages();
const currentHref = '/catering/taco-bar';

const metadata = {
  title: 'Taco Bar Catering on Oʻahu | Taqueria El Ranchero',
  description:
    "Bring our taqueria-style tacos to your next gathering. Ask about El Ranchero's taco bar catering packages, availability and options for your group.",
  ignoreTitleTemplate: true,
};

const linkClass = 'text-accent underline underline-offset-4 transition-opacity hover:opacity-80';
const requestHref = CATERING_REQUEST_HREF;

const faqs = [
  {
    title: "What's included in your taco bar catering packages?",
    description:
      "We offer taco bar catering packages, and we'll help you review the current options and what's included when you submit your request.",
  },
  {
    title: 'Can I request specific meats or toppings for my taco bar?',
    description:
      "Let us know which meats, toppings or other selections you're interested in. We'll confirm which options are available with our current catering packages.",
  },
  {
    title: 'Do you offer taco bar catering for larger groups?',
    description:
      "We're experienced in catering gatherings of different sizes. Share your estimated guest count, and we'll help you determine which taco bar options may work for your event.",
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    image={images.tacoBarHero}
    title="Taco Bar Catering from Taqueria El Ranchero"
    content="When tacos are the main event, we've got a catering option built around them.<br /><br />Our taco bar catering packages are a signature part of what we offer at Taqueria El Ranchero. Whether you're feeding coworkers or bringing people together for a celebration, we'd love to hear what you're planning.<br /><br />Tell us about your event, and we'll help you find out which taco bar options are available for your group."
    actions={[{ variant: 'primary', text: 'Request Taco Bar Catering', href: requestHref }]}
  />

  <TextSplit
    id="packages"
    heading="Our Taco Bar Catering"
    withImage
    image={images.tacoBarPackages}
    imageAspect="4 / 3"
    class="bg-card"
  >
    <div class="flex flex-col gap-6">
      <Text color="default">
        Our food takes inspiration from the taquerias of Northern California, where the tacos are the focus.
      </Text>
      <Text color="default">
        At our restaurants, we grill our meats fresh every morning, prepare our vegetables daily, and make our own salsas.
      </Text>
      <Text color="default">
        We also offer taco bar catering packages. Package selections and arrangements may differ from our regular restaurant menu, so we'll help you confirm what's currently available for your event.
      </Text>
      <Text color="default">
        Want to see the tacos we serve at our restaurants? <a class={linkClass} href="/menu/tacos">Browse our Tacos & Birria menu</a>. Regular-menu selections aren't necessarily part of a catering package.
      </Text>
    </div>
  </TextSplit>

  <TextSplit id="planning" heading="Planning Your Taco Bar Catering" withImage imageAspect="4 / 3" imageReverse>
    <div class="flex flex-col gap-6">
      <Text color="default">
        You don't need to have everything figured out before contacting us. It helps to know your event date, estimated guest count, where your gathering will take place, and any food preferences or dietary requests.
      </Text>
      <Text color="default">
        Once we have those details, we can discuss available taco bar packages, timing, and fulfillment arrangements for your event.
      </Text>
    </div>
  </TextSplit>

  <TextSplit id="more-catering" heading="More Catering Options at El Ranchero" class="bg-card" withImage imageAspect="4 / 3">
    <div class="flex flex-col gap-6">
      <Text color="default">
        Taco bar catering is one of the ways we help feed groups. You can also learn more about our other catering options:
      </Text>
      <ul class="flex flex-col gap-3">
        {
          cateringOptionPages.map((option) => (
            <li class="flex items-start gap-3 font-sans text-body text-default">
              <span class="mt-[0.45em] size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              {option.href === currentHref ? (
                <span>{option.label} — You're here</span>
              ) : (
                <a class={linkClass} href={option.href}>
                  {option.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <div>
        <Button variant="primary" text="View all catering options" href="/catering" hideNote={true} />
      </div>
    </div>
  </TextSplit>

  <FAQs id="faqs" isDark title="Taco Bar Catering FAQs" items={faqs} />

  <CTABanner
    title="Ready to Plan Your Taco Bar?"
    subtitle="Tell us how many people you're feeding and what you have in mind. We'll help you review the available taco bar catering options and discuss the next steps for your gathering."
    actions={[{ variant: 'primary', text: 'Request Taco Bar Catering', href: requestHref }]}
  />
</PageLayout>
