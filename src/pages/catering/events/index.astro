---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CateringSubNav from '~/components/widgets/CateringSubNav.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import { CATERING_CTA_HREF, LOCATION_CTA_HREF } from '~/config/cta';
import { getSanityCateringImages } from '~/lib/content/sanity';

const cateringImages = await getSanityCateringImages();

const metadata = {
  title: 'Event Catering Oahu | Large Gatherings & Banquets | El Ranchero',
  description:
    'Order fresh event catering for your gathering. We prepare salad trays, wrap platters, fresh soups, and beverages for pickup across our six Oahu locations.',
  ignoreTitleTemplate: true,
};

const occasions = [
  {
    number: '01',
    title: 'Community Gatherings',
    description:
      'Feed your crowd with fresh and healthy meals. Our signature salad trays and wrap platters provide a fresh alternative to heavy event food for local gatherings.',
  },
  {
    number: '02',
    title: 'Private Functions',
    description:
      'Serve a quality menu at your family reunion or banquet. We offer scaled-up versions of our signature items designed to accommodate large groups easily.',
  },
  {
    number: '03',
    title: 'Accommodating Every Diet',
    description:
      'Ensure every guest has a meal they can enjoy. We provide dedicated vegetarian options and plant-based trays to meet the dietary requirements of your attendees.',
  },
  {
    number: '04',
    title: 'Quality Event Food',
    description:
      "A catering tray is our standard menu in a bigger format. Scratch-made dressings and vine-ripe Hauula tomatoes throughout.",
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="Event Catering"
    content="Provide fresh food for your next gathering. We prepare large-format catering trays and wrap platters for events of all sizes. All event orders are available for pickup across our six Oahu locations."
    image={cateringImages.events}
    actions={[
      { variant: 'primary', text: 'Order Catering Online', href: CATERING_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'View Full Catering Menu', href: '/catering' },
    ]}
  />

  <section class="not-prose relative w-full overflow-hidden bg-page" aria-label="Event catering occasions">

    <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          occasions.map((occ) => (
            <article class="group relative flex flex-col justify-between overflow-hidden bg-section-dark px-8 pb-8 pt-10 md:px-10 md:pb-10 md:pt-12">
              <span
                class="pointer-events-none absolute right-6 top-4 select-none font-rough text-[96px] leading-none text-contrast/[0.07] md:text-[120px]"
                aria-hidden="true"
              >
                {occ.number}
              </span>
              <div class="relative flex flex-col gap-4">
                <span class="font-rough text-[15px] leading-none text-contrast/90">{occ.number}</span>
                <Heading variant="h3" color="white">
                  {occ.title}
                </Heading>
                <Text color="white" class="text-contrast/75 leading-relaxed">
                  {occ.description}
                </Text>
              </div>
              <div class="mt-8 h-px w-12 bg-accent" />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CateringSubNav
    excludeHref="/catering/events"
    subtitle="We provide catering services for various event types. Explore our other catering menus below:"
  />

  <FAQs
    isDark={true}
    title="Frequently Asked Questions"
    items={[
      {
        title: 'How far in advance should I order for a large event?',
        description:
          'Please contact your nearest location to confirm the required lead time for your specific event size.',
      },
      {
        title: 'Do you provide serving utensils for events?',
        description: 'Ask the store when you order and they will let you know what is included.',
      },
      {
        title: 'Can I customize event catering trays?',
        description:
          'Yes. We can modify our catering trays to accommodate specific dietary requirements for your event guests.',
      },
      {
        title: 'Do you offer meatless event catering options?',
        description:
          'Yes. We prepare dedicated plant-based items including the Aloha Mediterranean Tray and the Aloha Passion Tray.',
      },
      {
        title: 'Where do I pick up my event catering order?',
        description: "You can pick up your catering order at any of our six neighborhood restaurants across Oahu.",
      },
    ]}
  />

  <CTABanner
    title="Ready to Order?"
    subtitle="Order online for pickup. For a large event, call the store to talk through quantities and timing."
    ctaText="Order Catering Online"
    ctaHref={CATERING_CTA_HREF}
    secondaryCtaText="Find a Location"
    secondaryCtaHref={LOCATION_CTA_HREF}
  />
</PageLayout>
