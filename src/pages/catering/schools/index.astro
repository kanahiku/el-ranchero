---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CateringSubNav from '~/components/widgets/CateringSubNav.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import { CATERING_CTA_HREF, LOCATION_CTA_HREF } from '~/config/cta';
import { getSanityCateringImages } from '~/lib/content/sanity';

const cateringImages = await getSanityCateringImages();

const metadata = {
  title: 'School Catering Oahu | Teachers & Athletics | El Ranchero',
  description:
    'Order fresh school catering for your campus. We prepare salad trays, wrap platters, fresh soups, and beverages for pickup across our six Oahu locations.',
  ignoreTitleTemplate: true,
};

const occasions = [
  {
    number: '01',
    title: 'Faculty and Staff Lunches',
    description:
      'Keep your teachers going with healthy meals. Our signature salad trays provide a fresh alternative to heavy breakroom food during teacher appreciation days or planning sessions.',
  },
  {
    number: '02',
    title: 'Athletic Team Meals',
    description:
      'Provide quality fuel for your student-athletes. Our catering trays offer lean protein and fresh vegetables for pre-game meals or end-of-season banquets.',
  },
  {
    number: '03',
    title: 'Accommodating Every Diet',
    description:
      'Ensure every student and faculty member has a meal. We provide dedicated vegetarian options and plant-based trays to meet diverse dietary requirements across your campus.',
  },
  {
    number: '04',
    title: 'Quality Ingredients',
    description:
      "Campus orders come off the same line as everything else, with our scratch-made dressings and vine-ripe Hau\u02BBula tomatoes.",
  },
];
---

<PageLayout metadata={metadata}>
  {/* ── 1. Hero ───────────────────────────────────────────── */}
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="School Catering"
    content="Provide fresh food for your campus. We prepare large-format catering trays and wrap platters for school events and faculty lunches. All school orders are available for pickup across our six O\u02BBahu locations."
    image={cateringImages.events}
    actions={[
      { variant: 'primary', text: 'Order Catering Online', href: CATERING_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'View Full Catering Menu', href: '/catering' },
    ]}
  />

  {/* ── 2. Occasions — 2×2 editorial card grid ─── */}
  <section class="not-prose relative w-full overflow-hidden bg-page" aria-label="School catering occasions">

    <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          occasions.map((occ) => (
            <article class="group relative flex flex-col justify-between overflow-hidden bg-section-dark px-8 pb-8 pt-10 md:px-10 md:pb-10 md:pt-12">
              <span
                class="pointer-events-none absolute right-6 top-4 select-none font-rough text-[96px] leading-none text-contrast/[0.07] md:text-[120px]"
                aria-hidden="true"
              >
                {occ.number}
              </span>

              <div class="relative flex flex-col gap-4">
                <span class="font-rough text-[15px] leading-none text-contrast/90">{occ.number}</span>
                <Heading variant="h3" color="white">
                  {occ.title}
                </Heading>
                <Text color="white" class="text-contrast/75 leading-relaxed">
                  {occ.description}
                </Text>
              </div>

              <div class="mt-8 h-px w-12 bg-accent" />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── 3. Other catering sub-pages ───────────────────────── */}
  <CateringSubNav
    excludeHref="/catering/schools"
    subtitle="We provide catering services for various event types. Explore our other catering menus below:"
  />

  {/* ── 4. FAQs ──────────────────────────────────────────── */}
  <FAQs
    isDark={true}
    title="Frequently Asked Questions"
    items={[
      {
        title: 'How far in advance should I order for a school event?',
        description: 'Please contact your nearest location to confirm the required lead time for your specific campus headcount.',
      },
      {
        title: 'Are serving utensils included for school orders?',
        description: 'Ask the store when you order and they will let you know what is included.',
      },
      {
        title: 'Do you offer meatless options for students and staff?',
        description: 'Yes. We prepare dedicated plant-based items including the Aloha Mediterranean Tray and the Aloha Passion Tray.',
      },
      {
        title: 'Can we accommodate specific food allergies?',
        description: 'Yes. We can modify our catering trays to accommodate specific dietary requirements for your school group.',
      },
      {
        title: 'Do you provide drinks for school catering?',
        description: 'Yes. You can include bottled beverages and our refreshing Big Island m\u0101maki mint tea with your catering order.',
      },
    ]}
  />

  {/* ── 5. Ready to order CTA ────────────────────────────── */}
  <CTABanner
    title="Ready to Order?"
    subtitle="Order online for pickup. For campus-sized orders, call the store to sort timing and quantities."
    ctaText="Order Catering Online"
    ctaHref={CATERING_CTA_HREF}
    secondaryCtaText="Find a Location"
    secondaryCtaHref={LOCATION_CTA_HREF}
  />
</PageLayout>
