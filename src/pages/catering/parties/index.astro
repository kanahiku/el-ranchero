---
/**
 * Party Catering — copy from the Drive doc "/catering/parties - Party Catering".
 * Photos come from the Sanity "Catering" singleton.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Button from '~/components/ui/Button.astro';
import Text from '~/components/ui/Text.astro';
import { getCateringImages } from '~/lib/content';
import { CATERING_REQUEST_HREF, cateringOptionPages } from '~/data/catering';

const images = await getCateringImages();
const currentHref = '/catering/parties';
const linkClass = 'text-accent underline underline-offset-4 transition-opacity hover:opacity-80';

const metadata = {
  title: 'Party Catering on Oʻahu | Taqueria El Ranchero',
  description:
    "Planning a birthday, graduation, baby shower or team party? Ask us about El Ranchero party catering and tell us what you're planning for your group.",
  ignoreTitleTemplate: true,
};

const faqs = [
  {
    title: 'Can we request a taco bar for a birthday or graduation party?',
    description:
      "Yes. We offer taco bar catering packages that you can ask about for your celebration. We'll confirm the available packages and what's included when you contact us.",
  },
  {
    title: 'Do you have catering options for parties with kids?',
    description:
      "Our regular restaurant menu includes a Kids Menu, but catering selections may differ. Tell us if children will be attending, and we'll help you confirm which food options are available.",
  },
  {
    title: 'Can we host our party at El Ranchero too?',
    description:
      'We also offer <a class="text-accent underline underline-offset-4" href="/events/event-space-rental">Event Space Rental</a> at our Kapolei location. Venue rental is separate from catering, so contact us to discuss the arrangements for each.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    image={images.partyHero}
    title="Party Catering for Birthdays, Graduations & More"
    content="Good food is part of a good celebration. Whether you're hosting a birthday party, graduation, baby shower, or family gathering, bring the flavors of our taqueria to your next event.<br /><br />We offer catering for groups and can help you explore the options available for your celebration."
    actions={[{ variant: 'primary', text: 'Request Party Catering', href: CATERING_REQUEST_HREF }]}
  />

  <TextSplit id="birthday" heading="Birthday Party Catering" withImage imageAspect="4 / 3">
    <div class="flex flex-col gap-6">
      <Text color="default">
        Celebrating another year with family and friends? Whether it's a casual birthday get-together or a party with guests of different ages, we'd love to help you plan the food.
      </Text>
      <Text color="default">
        If tacos are on your birthday menu, ask us about our <a class={linkClass} href="/catering/taco-bar">Taco Bar Catering</a> packages. We'll help you confirm the available selections and arrangements for your celebration.
      </Text>
    </div>
  </TextSplit>

  <TextSplit id="graduation" heading="Graduation Party Catering" class="bg-card" withImage imageAspect="4 / 3" imageReverse>
    <div class="flex flex-col gap-6">
      <Text color="default">
        Graduation parties bring together family, friends, and classmates to celebrate a big milestone. Some celebrations have everyone sitting down for a meal, while others are open houses with guests arriving throughout the day.
      </Text>
      <Text color="default">
        Tell us how your graduation party is planned, and we'll help you review the catering options available for your guest count and schedule.
      </Text>
    </div>
  </TextSplit>

  <TextSplit id="baby-shower" heading="Baby Shower Catering" withImage imageAspect="4 / 3">
    <div class="flex flex-col gap-6">
      <Text color="default">
        Between games, opening gifts, and spending time with guests, a baby shower has its own rhythm.
      </Text>
      <Text color="default">
        If you're planning to serve a meal, let us know when your guests will be eating and whether there are any food preferences we should know about. We'll help you discuss the catering selections available for your celebration.
      </Text>
      <Text color="default">
        If you're also looking for a venue, we offer <a class={linkClass} href="/events/event-space-rental">Event Space Rental at our Kapolei location</a>, which is arranged separately from catering.
      </Text>
    </div>
  </TextSplit>

  <TextSplit
    id="family"
    heading="Family Party Catering"
    withImage
    image={images.partyFamily}
    imageAspect="4 / 3"
    class="bg-card"
  
    imageReverse
  >
    <div class="flex flex-col gap-6">
      <Text color="default">
        Family reunions, anniversary celebrations, and weekend get-togethers are all good reasons to share a meal.
      </Text>
      <Text color="default">
        If you're bringing together relatives of different ages, let us know what kinds of food your group enjoys. You can browse <a class={linkClass} href="/menu">our restaurant menu</a> for inspiration. Catering selections may differ, so we'll help you confirm what's currently available for your gathering.
      </Text>
    </div>
  </TextSplit>

  <TextSplit id="sports" heading="Sports Team Catering" withImage imageAspect="4 / 3">
    <div class="flex flex-col gap-6">
      <Text color="default">
        Celebrating a win, wrapping up the season, or planning a team appreciation meal? Whether you're feeding just the players or inviting coaches and families too, the size of your group can make a difference when planning the food.
      </Text>
      <Text color="default">
        Let us know who's attending and when your team plans to eat. We'll help you review the available catering options for your gathering.
      </Text>
    </div>
  </TextSplit>

  <TextSplit id="more-catering" heading="More Catering Options at El Ranchero" class="bg-card" withImage imageAspect="4 / 3" imageReverse>
    <div class="flex flex-col gap-6">
      <Text color="default">Looking for another way to feed your group? Take a look at our catering options:</Text>
      <ul class="flex flex-col gap-3">
        {
          cateringOptionPages.map((option) => (
            <li class="flex items-start gap-3 font-sans text-body text-default">
              <span class="mt-[0.45em] size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              {option.href === currentHref ? (
                <span>{option.label} — You're here</span>
              ) : (
                <a class={linkClass} href={option.href}>
                  {option.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <div>
        <Button variant="primary" text="View all catering options" href="/catering" hideNote={true} />
      </div>
    </div>
  </TextSplit>

  <FAQs id="faqs" isDark title="Party Catering FAQs" items={faqs} />

  <CTABanner
    title="Ready to Plan Your Party Catering?"
    subtitle="Have a celebration coming up? Tell us what you're celebrating, approximately how many guests you're expecting, and what you have in mind for the food. We'll help you explore the catering options available for your gathering."
    actions={[{ variant: 'primary', text: 'Request Party Catering', href: CATERING_REQUEST_HREF }]}
  />
</PageLayout>
