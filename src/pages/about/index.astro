---
/**
 * About / Our Story — all copy, links and photos come from the Sanity "About"
 * singleton (`aboutContent`); defaults live in src/data/pages/about.ts.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import LocationsBlocks from '~/components/widgets/LocationsBlocks.astro';
import { getAboutContent } from '~/lib/content';
import { paragraphsToHtml } from '~/lib/content/inlineLink';

const c = await getAboutContent();
const metadata = { title: c.seoTitle, description: c.seoDescription, ignoreTitleTemplate: true };
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    image={c.heroImage}
    overlapHeader={false}
    title={c.heroTitle}
    content={paragraphsToHtml(c.heroParagraphs)}
  />

  <LocationsBlocks blocks={c.blocks} />
</PageLayout>
