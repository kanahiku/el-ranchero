---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import BlogCard from '~/components/ui/BlogCard.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { getBlogIndexContent, getBlogPosts } from '~/lib/content';

export const prerender = false;

const [c, posts] = await Promise.all([getBlogIndexContent(), getBlogPosts()]);

const metadata = { title: c.seoTitle, description: c.seoDescription, ignoreTitleTemplate: true };
---

<Layout metadata={metadata}>
  <WidgetWrapper containerClass="max-w-container mx-auto">
    <h1
      class="text-[42px] md:text-[56px] font-normal leading-[105%] tracking-tighter font-heading text-heading mb-[30px]"
    >
      {c.heading}
    </h1>
    {
      posts.length ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
          {posts.map((post) => (
            <BlogCard post={post} variant="dark" />
          ))}
        </div>
      ) : (
        <p class="text-[16px] font-normal leading-[160%] text-muted">
          {c.emptyText}
        </p>
      )
    }
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <CTABanner
    title={c.ctaTitle}
    subtitle={c.ctaSubtitle}
    actions={[{ variant: 'primary', text: c.ctaButton.text, href: c.ctaButton.href }]}
  />
</Layout>
