---
import Layout from '~/layouts/PageLayout.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { storeLocations } from '~/data/locations';

const metadata = {
  title: 'Order Online | El Ranchero',
  description:
    "Order El Ranchero online for pickup or delivery from any of our six Oahu locations.",
  ignoreTitleTemplate: true,
};

// Arrow icon shared across cards
const ArrowRight = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="shrink-0"><path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<Layout metadata={metadata}>
  <!-- Location cards grid -->
  <section
    class="not-prose relative w-full bg-section-grey"
    aria-label="Order from a location"
  >

    <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
      <!-- Section header -->
      <div class="mb-10 flex flex-col gap-4 md:mb-14">
        <Heading variant="eyebrow">Choose your location</Heading>
        <Heading variant="h2">Order from a store</Heading>
        <Text variant="body-lg" color="default" class="max-w-2xl">
          Select a location to order pickup directly through our ordering system, or choose delivery through our delivery partner.
        </Text>
      </div>

      <!-- 3-col grid on desktop, 2-col on tablet, 1-col on mobile -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {storeLocations.map((store) => (
          <div class="flex flex-col bg-section-dark">
            <!-- Card info block -->
            <div class="flex flex-1 flex-col gap-4 px-5 pb-5 pt-6">
              <div class="flex items-start justify-between gap-3">
                <Heading variant="h3" color="white" as="p">{store.name}</Heading>
                <a
                  href={store.href}
                  class="font-heading text-small font-normal leading-none text-contrast/60 underline-offset-2 hover:text-contrast hover:underline"
                >
                  View location
                </a>
              </div>
              <div class="flex flex-col gap-1">
                <Text variant="small" color="white" as="p" class="text-contrast/70">{store.shopName}</Text>
                <Text variant="small" color="white" as="p" class="text-contrast/70">{store.addressLine1}</Text>
                <Text variant="small" color="white" as="p" class="text-contrast/70">{store.addressLine2}</Text>
                {store.landmark && (
                  <Text variant="small" color="white" as="p" class="text-contrast/50 italic">{store.landmark}</Text>
                )}
              </div>
              <div class="flex flex-col gap-0.5">
                {store.hours.split('·').map((line) => (
                  <Text variant="small" color="white" as="p" class="text-contrast/60">{line.trim()}</Text>
                ))}
              </div>
            </div>

            <!-- Two action buttons -->
            <div class="grid grid-cols-2 gap-3 px-5 pb-5 pt-2">
              <a
                href={store.orderPickupHref}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col items-center justify-center gap-1 bg-page px-3 py-4 text-center transition-colors duration-200 hover:bg-accent hover:text-contrast"
              >
                <span class="font-heading text-[10px] font-normal uppercase tracking-widest text-heading/50 group-hover:text-contrast/70">Pickup</span>
                <span class="flex items-center gap-1.5 font-heading text-button font-medium leading-none text-heading group-hover:text-contrast">
                  Order Now
                  <Fragment set:html={ArrowRight} />
                </span>
              </a>
              <a
                href={store.orderDeliveryHref}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col items-center justify-center gap-1 border border-contrast/25 px-3 py-4 text-center transition-colors duration-200 hover:border-contrast/60 hover:bg-page/10"
              >
                <span class="font-heading text-[10px] font-normal uppercase tracking-widest text-contrast/50 group-hover:text-contrast/70">Delivery</span>
                <span class="flex items-center gap-1.5 font-heading text-button font-medium leading-none text-contrast group-hover:text-contrast">
                  Order Now
                  <Fragment set:html={ArrowRight} />
                </span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    title="Visit Us In Store"
    subtitle="Prefer to order in person? Find your nearest El Ranchero and stop by for a fresh meal."
    ctaText="Find a Location"
    ctaHref="/locations"
    secondaryCtaText="View Full Menu"
    secondaryCtaHref="/menu"
  />
</Layout>
