---
/**
 * Order Online — all copy, links and storefront photos come from the Sanity
 * "Order Online page" singleton (`orderOnlineContent`); defaults live in
 * src/data/pages/sitePages.ts. Takeout buttons open each restaurant's DoorDash menu.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Locations from '~/components/widgets/Locations.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Button from '~/components/ui/Button.astro';
import Text from '~/components/ui/Text.astro';
import Heading from '~/components/ui/Heading.astro';
import { getOrderOnlineContent } from '~/lib/content';
import { paragraphsToHtml } from '~/lib/content/inlineLink';

const c = await getOrderOnlineContent();
const metadata = { title: c.seoTitle, description: c.seoDescription, ignoreTitleTemplate: true };
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    hideImage
    title={c.heroTitle}
    content={paragraphsToHtml(c.heroParagraphs)}
  />

  <Locations
    id="choose-location"
    variant="detailed"
    eyebrow=""
    title={c.chooseTitle}
    headerAlign="center"
    subtitle=""
    locations={c.cards.map((card) => ({
      name: card.name,
      heading: card.heading,
      image: card.image,
      shopName: card.shopName,
      addressLine1: card.addressLine1,
      addressLine2: card.addressLine2,
      description: card.paragraphs,
      actions: card.actions.map((action) => ({ text: action.text, href: action.href, variant: action.variant ?? 'primary' })),
    }))}
    note={c.note}
  />

  <section id="order-by-phone" class="not-prose w-full">
    <div class="mx-auto flex w-full max-w-container flex-col items-center gap-6 px-5 py-16 text-center sm:px-8 md:px-16 md:py-[120px]">
      <Heading variant="h2">{c.phoneHeading}</Heading>
      <Text color="default" class="max-w-2xl">{c.phoneText}</Text>
      <div class="flex flex-row flex-wrap items-center justify-center gap-3">
        {
          c.phoneButtons.map((button) => (
            <Button
              variant={button.variant === 'ghost' ? 'ghost' : 'primary'}
              text={button.text}
              href={button.href}
              target={isExternal(button.href) ? '_blank' : undefined}
              hideNote={true}
            />
          ))
        }
      </div>
    </div>
  </section>

  <CTABanner
    title={c.ctaTitle}
    subtitle={c.ctaSubtitle}
    actions={[{ variant: 'primary', text: c.ctaButton.text, href: c.ctaButton.href }]}
  />
</PageLayout>
