---
/**
 * Drinks & Margaritas — copy from pages-content/Menu Pages/_ menu_drinks - Drinks & Margaritas.docx.
 * Poster layout. Photos come from Sanity.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import MenuHero from '~/components/menu/MenuHero.astro';
import MenuItemGrid from '~/components/menu/MenuItemGrid.astro';
import MenuOrder from '~/components/menu/MenuOrder.astro';
import MenuMore from '~/components/menu/MenuMore.astro';
import MenuAllergy from '~/components/menu/MenuAllergy.astro';
import { getMenuPagesImages, getMenuSections } from '~/lib/content';

const metadata = {
  title: 'Drinks & Margaritas in Wahiawa & Kapolei | El Ranchero',
  description:
    'Explore Black Diamond and Mahalo Margaritas, Michelada, aguas frescas, Jarritos, Mexican sodas and Café Mexicano at El Ranchero in Wahiawa and Kapolei.',
  ignoreTitleTemplate: true,
};

const sections = await getMenuSections('drinks');
const images = await getMenuPagesImages();
---

<PageLayout metadata={metadata}>
  <div class="v3-interior">
    <MenuHero
      titleId="drinks-title"
      lines={['Drinks &', 'Margaritas in', 'Wahiawa & Kapolei']}
      image={images.drinksHero}
      paragraphs={[
        'From margaritas and Micheladas to aguas frescas, Mexican sodas and coffee, there’s a drink to pair with your meal at Taqueria El Ranchero.',
        'Explore the beverages featured on our menu at our Wahiawa and Kapolei restaurants. For additional bar selections, ask your server for our complete Drinks Menu.',
      ]}
    />
    <MenuItemGrid id="margaritas" title="Signature Margaritas" items={sections.margaritas} />
    <MenuItemGrid id="other-drinks" tone="ink" title="Aguas Frescas & Other Drinks" items={sections['other-drinks']} />
    <section id="hours" class="v3-section v3-paper v3-scalloped v3-center" aria-labelledby="hours-title">
      <div class="v3-scallop" aria-hidden="true"></div>
      <div class="v3-wrap">
        <div class="v3-ihead">
          <h2 id="hours-title" class="v3-display">Bar & Kitchen Hours</h2>
        </div>
        <div class="v3-prose">
          <p>
            Kitchen hours are 7 a.m. to 10 p.m. daily. Bar service is listed through midnight each day; Friday and
            Saturday closing times may be later. Please confirm late-night bar availability with your preferred
            location.
          </p>
          <p>For our complete Drinks Menu, including selections beyond those listed here, please ask your server.</p>
        </div>
      </div>
    </section>
    <MenuOrder
      tone="ink"
      subtitle="Both Taqueria El Ranchero restaurants use the same menu. Select your preferred location to check current availability and takeout options through DoorDash."
    />
    <MenuMore
      excludeHref="/menu/drinks"
      tone="paper"
      scallop
      cactus
      subtitle="Find more Mexican food and drinks at Taqueria El Ranchero. Browse other sections of our menu."
    />
    <MenuAllergy />
  </div>
</PageLayout>
