---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import MenuCategories from '~/components/widgets/MenuCategories.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { PRIMARY_CTA_HREF, LOCATION_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { getMenuCategory } from '~/lib/content';
import { getSanityMenuPagesImages } from '~/lib/content/sanity';

const menuPagesImages = await getSanityMenuPagesImages().catch(() => ({} as Awaited<ReturnType<typeof getSanityMenuPagesImages>>));

const metadata = {
  title: 'Drinks, Beverages & Local Mamaki Tea | El Ranchero Oahu',
  description:
    'Complete your meal with our beverage selection, featuring Guava Lemonade and Big Island mamaki mint tea. Order online across our six Oahu locations.',
  ignoreTitleTemplate: true,
};

const heroTitle = 'Drinks and Beverages';
const heroContent =
  "Pair your meal with our selection of chilled beverages. We offer a variety of refreshing options available for pickup across our six Oahu locations.";

const drinkItems = [
  {
    title: 'Big Island Mamaki Mint Tea',
    description:
      'We serve chilled mamaki mint tea brewed fresh in-store. We source our mamaki from a company in Hilo on the Big Island to provide this traditional Hawaiian herbal beverage.',
  },
  {
    title: 'Guava Lemonade',
    description: 'A sweet and tart island favorite.',
  },
  {
    title: 'Fountain Drink',
    description: 'A selection of carbonated beverages.',
  },
  {
    title: 'Bottle Water',
    description: 'Chilled still water.',
  },
];

const cmsCategory = await getMenuCategory('drinks');
const menuItems = cmsCategory?.items.length ? cmsCategory.items : drinkItems;

const faqs = [
  {
    title: 'Do you serve local Hawaiian tea?',
    description: 'Yes. We serve freshly brewed mamaki mint tea sourced directly from the Big Island.',
  },
  {
    title: 'What is mamaki?',
    description:
      'Mamaki is a plant native to Hawaii. Its leaves are traditionally brewed to create a mild, caffeine-free herbal tea.',
  },
  {
    title: 'Can I order drinks online?',
    description: 'Yes. You can add any of our beverages to your online order for fast pickup.',
  },
  {
    title: 'Are drinks included with kids meals?',
    description: 'Yes. Our Keiki Combo includes a designated keiki drink.',
  },
  {
    title: 'Where can I pick up my order?',
    description: "Our full beverage menu is available at our six neighborhood restaurants across Oahu.",
  },
];
---

<PageLayout metadata={metadata}>
  {/* ── Hero ─────────────────────────────────────────────────────── */}
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title={heroTitle}
    content={heroContent}
    image={menuPagesImages.drinksHero}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Find a Location', href: LOCATION_CTA_HREF },
    ]}
  />

  {/* ── Drink Menu ───────────────────────────────────────────────── */}
  <MenuItemsSection id="our-drink-menu" title="Our Drink Menu" items={menuItems} />

  <LocalSourcing
    title="Big Island Mamaki"
    subtitle="Our chilled mamaki mint tea is brewed fresh in-store using mamaki sourced from Hilo on the Big Island, alongside the same quality-first sourcing we use across the menu."
    ctaText="Learn More About Our Ingredients"
    ctaHref="/ingredients"
    withPhoto={true}
    image={menuPagesImages.drinksIngredients}
  />

  {/* ── Explore Other Menu Categories ────────────────────────────── */}
  <MenuCategories
    title="Explore Other Menu Categories"
    subtitle="Browse our full menu to find your meal:"
    excludeHref="/menu/drinks"
    ctaText=""
  />

  {/* ── CTA Banner ───────────────────────────────────────────────── */}
  <CTABanner
    title="Ready to Order?"
    subtitle="Skip the line and place your order online for fast pickup. Planning a group event? We also offer a variety of catering options."
    ctaText="Order Online"
    ctaHref={PRIMARY_CTA_HREF}
    secondaryCtaText="Order Catering"
    secondaryCtaHref={CATERING_CTA_HREF}
  />

  {/* ── FAQs ─────────────────────────────────────────────────────── */}
  <FAQs title="Frequently Asked Questions" items={faqs} isDark={true} />
</PageLayout>
