---
/**
 * Specials — copy from pages-content/Menu Pages/_ menu_specials - Specials.docx.
 * Poster layout. Photos come from Sanity.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import MenuHero from '~/components/menu/MenuHero.astro';
import MenuItemGrid from '~/components/menu/MenuItemGrid.astro';
import MenuMeatBand from '~/components/menu/MenuMeatBand.astro';
import MenuOrder from '~/components/menu/MenuOrder.astro';
import MenuMore from '~/components/menu/MenuMore.astro';
import MenuAllergy from '~/components/menu/MenuAllergy.astro';
import { getMeatOptions, getMenuPagesImages, getMenuSections } from '~/lib/content';

const metadata = {
  title: 'Mexican Food Specials in Wahiawa & Kapolei | El Ranchero',
  description:
    'Explore Mexican food specials at El Ranchero in Wahiawa and Kapolei, including tortas, tamales, California Fries and weekend-only pozole and menudo.',
  ignoreTitleTemplate: true,
};

const sections = await getMenuSections('specials');
const meatOptions = await getMeatOptions();
const images = await getMenuPagesImages();
---

<PageLayout metadata={metadata}>
  <div class="v3-interior">
    <MenuHero
      titleId="specials-title"
      lines={['Mexican Food', 'Specials in', 'Wahiawa & Kapolei']}
      image={images.specialsHero}
      paragraphs={[
        'Explore more of the Mexican food menu at Taqueria El Ranchero, from Tortas and California Fries to Tamales, Elote and seafood dishes.',
        'Our specials menu also includes traditional Mexican favorites available on Saturdays and Sundays, including Pozole, Menudo, Campechana and Chile Relleno. Browse the options below and check current availability when ordering from our Wahiawa or Kapolei restaurant.',
      ]}
    />
    <MenuItemGrid
      id="daily-specials"
      title="Daily Specials"
      intro="Explore the dishes listed under Daily Specials on our menu, including Mexican-style sandwiches, savory snacks and other favorites."
      items={sections.daily}
    />
    <MenuMeatBand
      title="Meat Choices for Select Specials"
      intro="The Sope, Torta and California Fries are listed with your choice of meat. El Ranchero’s general menu includes:"
      note="Check which meat selections are available for your preferred dish when ordering."
      rows={meatOptions}
    />
    <MenuItemGrid
      id="weekend-specials"
      tone="ink"
      flower={false}
      scallop
      scallopRed
      title="Weekend Specials — Saturday & Sunday Only"
      intro="Looking for Pozole, Menudo or another traditional Mexican weekend favorite? El Ranchero’s Weekend Specials are available Saturday and Sunday only. Explore the dishes below."
      items={sections.weekend}
    />
    <MenuOrder
      scallop
      subtitle="Explore our specials menu at either El Ranchero location. Choose your preferred restaurant to check current availability and takeout options through DoorDash."
    />
    <MenuMore
      excludeHref="/menu/specials"
      subtitle="Looking for something else? Explore more of Taqueria El Ranchero’s menu, from Mexican breakfast and burritos to tacos, entrées, appetizers, drinks and more."
    />
    <MenuAllergy />
  </div>
</PageLayout>
