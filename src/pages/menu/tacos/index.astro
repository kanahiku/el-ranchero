---
/**
 * Tacos & Birria — copy from pages-content/Menu Pages/_ menu_tacos - Tacos & Birria.docx.
 * Poster layout. Photos come from Sanity.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import MenuHero from '~/components/menu/MenuHero.astro';
import MenuItemGrid from '~/components/menu/MenuItemGrid.astro';
import MenuMeatBand from '~/components/menu/MenuMeatBand.astro';
import MenuOrder from '~/components/menu/MenuOrder.astro';
import MenuMore from '~/components/menu/MenuMore.astro';
import MenuAllergy from '~/components/menu/MenuAllergy.astro';
import { getMenuPagesImages, getMenuSections, getMeatOptions } from '~/lib/content';

const metadata = {
  title: 'Tacos & Birria Tacos in Wahiawa & Kapolei | El Ranchero',
  description:
    'Explore tacos, birria tacos and Mulitas de Birria at El Ranchero in Wahiawa and Kapolei. Choose from meat, veggie and seafood taco options.',
  ignoreTitleTemplate: true,
};

const sections = await getMenuSections('tacos');
const meatOptions = await getMeatOptions();
const images = await getMenuPagesImages();
---

<PageLayout metadata={metadata}>
  <div class="v3-interior">
    <MenuHero
      titleId="tacos-title"
      lines={['Tacos & Birria', 'in Wahiawa &', 'Kapolei']}
      image={images.tacosHero}
      paragraphs={[
        'Explore the taco menu at Taqueria El Ranchero, inspired by the taquerias of Northern California. Choose from our traditional Taco with onion, cilantro and salsa, or explore options with beans, cheese, seafood and more.',
        'Looking for birria tacos? We also serve Tacos de Birria and Mulitas de Birria at both our Wahiawa and Kapolei restaurants.',
      ]}
    />
    <MenuItemGrid
      id="taco-menu"
      title="Explore Our Tacos"
      intro="From a traditional Taco to veggie and seafood options, explore the different tacos available at El Ranchero."
      items={sections.main}
    />
    <MenuItemGrid
      id="birria"
      tone="ink"
      title="Birria Tacos & Mulitas de Birria"
      intro="Looking for birria? Explore our birria options, each listed as a three-piece order on our menu."
      items={sections.birria}
    />
    <MenuMeatBand
      title="Choose Your Meat"
      intro="For tacos that offer a choice of meat, El Ranchero’s menu includes the following options:"
      note="These choices apply to tacos listed with a choice of meat. The Seafood Taco offers a choice of shrimp or fish."
      rows={meatOptions}
    />
    <MenuOrder
      scallop
      scallopRed
      subtitle="Both El Ranchero locations serve the same taco and birria menu. Choose your preferred restaurant to check available takeout options through DoorDash."
    />
    <MenuMore
      excludeHref="/menu/tacos"
      subtitle="Looking for something else? Explore more of Taqueria El Ranchero’s menu, from Mexican breakfast and burritos to entrées, appetizers, drinks and more."
    />
    <MenuAllergy />
  </div>
</PageLayout>
