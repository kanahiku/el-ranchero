---
/**
 * Burritos — copy from pages-content/Menu Pages/_ menu_burritos - Burritos.docx.
 * Composes shared widgets only. Photos come from the Sanity "Menu Pages" singleton
 * (`menuPagesContent`) and the menu category / item documents; a missing photo renders
 * the grey placeholder.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import OptionsTable from '~/components/widgets/OptionsTable.astro';
import Locations from '~/components/widgets/Locations.astro';
import MenuCategories from '~/components/widgets/MenuCategories.astro';
import Note from '~/components/widgets/Note.astro';
import { PRIMARY_CTA_HREF } from '~/config/cta';
import { getMenuSections, getMeatOptions, getMenuPagesImages } from '~/lib/content';
import { allergyNotice, locationsFootnote, orderLocations } from '~/data/menu';
import RelatedBlogs from '~/components/widgets/RelatedBlogs.astro';

const metadata = {
  title: 'Burritos in Wahiawa & Kapolei | Taqueria El Ranchero',
  description:
    "Explore burritos at El Ranchero in Wahiawa and Kapolei, including California Burrito, Burrito Grande, seafood and Wet Burrito options. Order through DoorDash.",
  ignoreTitleTemplate: true,
};

const sections = await getMenuSections('burritos');
const meatOptions = await getMeatOptions();
const images = await getMenuPagesImages();

---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    image={images.burritosHero}
    title="Burritos in Wahiawa & Kapolei"
    content="Explore the burritos at Taqueria El Ranchero, where our Northern California-inspired menu offers different combinations of meats, beans, rice, vegetables and sauces.<br /><br />Whether you prefer a classic burrito, a California Burrito with fries or a burrito covered in red or green sauce, you’ll find options at both our Wahiawa and Kapolei restaurants."
    actions={[{ variant: 'primary', text: 'Order Now', href: PRIMARY_CTA_HREF }]}
  />

  <MenuItemsSection id="burrito-menu" tone="page" title="Explore Our Burritos" intro="Choose from our burrito menu below. For a different way to enjoy your favorite, any burrito can also be prepared as a Wet Burrito." items={sections.main} />

  <OptionsTable
    id="choose-your-meat"
    tone="card"
    heading="Choose Your Meat"
    intro="Several of our burritos allow you to choose your preferred meat. Options listed on our menu include:"
    note="These choices apply to burritos listed with a choice of meat. The Seafood Burrito offers a choice of shrimp or fish."
    rows={meatOptions}
  />

  <Locations
    id="order"
    variant="order"
    eyebrow=""
    title="Order From Your Nearest El Ranchero"
    subtitle="Both El Ranchero locations serve the same burrito menu. Choose your preferred restaurant to check available options and order through DoorDash."
    locations={orderLocations}
    footnote={locationsFootnote}
  />

  <MenuCategories
    id="more-menu"
    tone="page"
    title="Explore More of Our Menu"
    subtitle="Looking for something else? Explore more of Taqueria El Ranchero’s menu, from Mexican breakfast and tacos to appetizers, drinks and more."
    excludeHref="/menu/burritos"
    ctaText="View Full Menu"
    ctaHref="/menu"
  />

  <Note tone="card" title={allergyNotice.title} description={allergyNotice.description} />
  <RelatedBlogs pageSlug="menu/burritos" surface="grey" />
</PageLayout>
