---
/**
 * Burritos — copy from pages-content/Menu Pages/_ menu_burritos - Burritos.docx.
 * Poster layout. Photos come from Sanity.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import MenuHero from '~/components/menu/MenuHero.astro';
import MenuItemGrid from '~/components/menu/MenuItemGrid.astro';
import MenuMeatBand from '~/components/menu/MenuMeatBand.astro';
import MenuOrder from '~/components/menu/MenuOrder.astro';
import MenuMore from '~/components/menu/MenuMore.astro';
import MenuAllergy from '~/components/menu/MenuAllergy.astro';
import { getMenuPagesImages, getMenuSections, getMeatOptions } from '~/lib/content';

const metadata = {
  title: 'Burritos in Wahiawa & Kapolei | Taqueria El Ranchero',
  description:
    'Explore burritos at El Ranchero in Wahiawa and Kapolei, including California Burrito, Burrito Grande, seafood and Wet Burrito options. Order through DoorDash.',
  ignoreTitleTemplate: true,
};

const sections = await getMenuSections('burritos');
const meatOptions = await getMeatOptions();
const images = await getMenuPagesImages();
---

<PageLayout metadata={metadata}>
  <div class="v3-interior">
    <MenuHero
      titleId="burritos-title"
      lines={['Burritos', 'in Wahiawa &', 'Kapolei']}
      image={images.burritosHero}
      paragraphs={[
        'Explore the burritos at Taqueria El Ranchero, where our Northern California-inspired menu offers different combinations of meats, beans, rice, vegetables and sauces.',
        'Whether you prefer a classic burrito, a California Burrito with fries or a burrito covered in red or green sauce, you’ll find options at both our Wahiawa and Kapolei restaurants.',
      ]}
    />
    <MenuItemGrid
      id="burrito-menu"
      title="Explore Our Burritos"
      intro="Choose from our burrito menu below. For a different way to enjoy your favorite, any burrito can also be prepared as a Wet Burrito."
      items={sections.main}
    />
    <MenuMeatBand
      title="Choose Your Meat"
      intro="Several of our burritos allow you to choose your preferred meat. Options listed on our menu include:"
      note="These choices apply to burritos listed with a choice of meat. The Seafood Burrito offers a choice of shrimp or fish."
      rows={meatOptions}
    />
    <MenuOrder
      scallop
      scallopRed
      subtitle="Both El Ranchero locations serve the same burrito menu. Choose your preferred restaurant to check available options and order through DoorDash."
    />
    <MenuMore
      excludeHref="/menu/burritos"
      subtitle="Looking for something else? Explore more of Taqueria El Ranchero’s menu, from Mexican breakfast and tacos to appetizers, drinks and more."
    />
    <MenuAllergy />
  </div>
</PageLayout>
