---
/**
 * Appetizers & Sides — copy from pages-content/Menu Pages/_ menu_appetizers-sides - Appetizers & Sides.docx.
 * Poster layout. Photos come from Sanity.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import MenuHero from '~/components/menu/MenuHero.astro';
import MenuItemGrid from '~/components/menu/MenuItemGrid.astro';
import MenuOrder from '~/components/menu/MenuOrder.astro';
import MenuMore from '~/components/menu/MenuMore.astro';
import MenuAllergy from '~/components/menu/MenuAllergy.astro';
import Blossom from '~/components/home/Blossom.astro';
import ArtEagle from '~/assets/images/v3/art-eagle.svg';
import { getMenuPagesImages, getMenuSections } from '~/lib/content';

const metadata = {
  title: 'Appetizers & Sides in Wahiawa & Kapolei | El Ranchero',
  description:
    'Explore freshly made guacamole, Chorizo Queso, Bean Dip, pico de gallo, rice, beans and more at El Ranchero in Wahiawa and Kapolei.',
  ignoreTitleTemplate: true,
};

const sections = await getMenuSections('appetizers-sides');
const images = await getMenuPagesImages();
const addOns = ['Meat', 'Pico de gallo', 'Guacamole', 'Sour cream', 'Cheese (tacos only)'];
---

<PageLayout metadata={metadata}>
  <div class="v3-interior">
    <MenuHero
      titleId="appetizers-title"
      lines={['Appetizers &', 'Sides in', 'Wahiawa & Kapolei']}
      image={images.appetizersSidesHero}
      paragraphs={[
        'Looking for something to enjoy alongside your favorite Mexican dish? Explore the appetizers and sides at Taqueria El Ranchero.',
        'Choose from freshly made Guacamole, Chorizo Queso or Bean Dip, or add a side of pico de gallo, queso sauce, rice or beans to your meal.',
      ]}
    />
    <MenuItemGrid id="appetizers" title="Explore Our Appetizers" items={sections.appetizers} />
    <MenuItemGrid
      id="sides"
      tone="ink"
      title="Explore Our Sides"
      intro="Looking for something extra to go with your meal? El Ranchero offers the following sides."
      items={sections.sides}
    />
    <section id="add-ons" class="v3-section v3-red-band" aria-labelledby="add-ons-title">
      <Blossom class="v3-art v3-art-bloom" fill="var(--v3-ink)" center="var(--v3-ink)" />
      <ArtEagle class="v3-art v3-art-eagle" aria-hidden="true" />
      <div class="v3-wrap">
        <div class="v3-ihead">
          <h2 id="add-ons-title" class="v3-display">Add-Ons for Your Order</h2>
          <p class="v3-body">
            Want to customize your meal? Depending on the dish, El Ranchero’s listed add-on options include:
          </p>
        </div>
        <ul class="v3-occasion-list">
          {addOns.map((addOn) => <li>{addOn}</li>)}
        </ul>
        <p class="v3-body">
          Available add-ons depend on the menu item. Check the options offered when placing your order.
        </p>
      </div>
    </section>
    <MenuOrder
      scallop
      scallopRed
      subtitle="Both El Ranchero locations serve the same appetizers and sides menu. Choose your preferred restaurant to check available takeout options and order through DoorDash."
    />
    <MenuMore
      excludeHref="/menu/appetizers-sides"
      subtitle="Looking for something else? Explore more of Taqueria El Ranchero’s menu, from Mexican breakfast and burritos to tacos, entrées, drinks and more."
    />
    <MenuAllergy />
  </div>
</PageLayout>
