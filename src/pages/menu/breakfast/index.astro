---
/**
 * Breakfast — copy from pages-content/Menu Pages/_ menu_breakfast - Breakfast.docx.
 * Composes shared widgets only. Photos are grey placeholders until the
 * client photography pass.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import Text from '~/components/ui/Text.astro';
import Locations from '~/components/widgets/Locations.astro';
import MenuCategories from '~/components/widgets/MenuCategories.astro';
import Note from '~/components/widgets/Note.astro';
import { PRIMARY_CTA_HREF } from '~/config/cta';
import { getMenuSections } from '~/lib/content';
import { allergyNotice, locationsFootnote, orderLocations } from '~/data/menu';

const metadata = {
  title: 'Mexican Breakfast in Wahiawa & Kapolei | El Ranchero',
  description:
    "Explore Mexican breakfast at El Ranchero in Wahiawa and Kapolei, served every day from 7 AM to noon. See breakfast burritos, chilaquiles, tacos and eggs.",
  ignoreTitleTemplate: true,
};

const sections = await getMenuSections('breakfast');

---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline="Every day, 7 AM to 12 PM"
    title="Mexican Breakfast in Wahiawa & Kapolei"
    content="Start your morning with Mexican breakfast at Taqueria El Ranchero, served daily at both our Wahiawa and Kapolei locations. If you’re heading to work, school or out for the day, our Breakfast Burrito is an easy choice to take with you.<br /><br />Prefer a sit-down breakfast? Explore chilaquiles, egg plates and more."
    actions={[{ variant: 'primary', text: 'Order Now', href: PRIMARY_CTA_HREF }]}
  />

  <MenuItemsSection id="breakfast-menu" tone="page" title="Explore Our Breakfast Menu" intro="Choose from our breakfast dishes, including burritos, tacos and traditional egg-based plates." items={sections.main} />

  <TextSplit id="takeout-or-sit-down" heading="Breakfast for Takeout or a Sit-Down Meal" withImage imageAspect="4 / 3" class="bg-card">
    <div class="flex flex-col gap-6">
      <Text color="default">
        For breakfast on the go, the Breakfast Burrito and Breakfast Taco offer a choice of bacon, ham, chorizo or veggie. If you have time to sit down, explore Chilaquiles, Huevos Rancheros, Huevos con Chorizo or another breakfast plate.
      </Text>
      <Text color="default">
        The breakfast menu is served from 7 AM to 12 PM every day at both El Ranchero restaurants.
      </Text>
    </div>
  </TextSplit>

  <Locations
    id="order"
    variant="order"
    eyebrow=""
    title="Order From Your Nearest El Ranchero"
    subtitle="Choose your location to check available takeout options and order through DoorDash."
    locations={orderLocations}
    footnote={locationsFootnote}
  />

  <MenuCategories
    id="more-menu"
    tone="page"
    title="Explore More of Our Menu"
    subtitle="Looking for something else? Explore more of Taqueria El Ranchero’s menu, from tacos and burritos to appetizers, drinks and more."
    excludeHref="/menu/breakfast"
    ctaText="View Full Menu"
    ctaHref="/menu"
  />

  <Note tone="card" title={allergyNotice.title} description={allergyNotice.description} />
</PageLayout>
