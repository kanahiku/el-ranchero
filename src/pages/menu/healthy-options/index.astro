---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import MenuCategories from '~/components/widgets/MenuCategories.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { PRIMARY_CTA_HREF, LOCATION_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { getSanityMenuPagesImages } from '~/lib/content/sanity';

const menuPagesImages = await getSanityMenuPagesImages().catch(() => ({} as Awaited<ReturnType<typeof getSanityMenuPagesImages>>));

const metadata = {
  title: 'Healthy Food & Menu Options | El Ranchero Oahu',
  description:
    'Looking for a healthy meal? Discover fresh salads, lean proteins, and custom bowls at El Ranchero. Order online across our six Oahu locations.',
  ignoreTitleTemplate: true,
};

const approachItems = [
  {
    title: 'Signature Salads',
    description: 'Choose from our established recipes featuring fresh greens and lean proteins.',
  },
  {
    title: 'Plant-Based Meals',
    description: 'Explore our dedicated vegan and vegetarian menus.',
  },
  {
    title: 'Design Your Own Salad',
    description:
      'Build a custom bowl. You control exactly which ingredients and dressings go into your meal to meet your specific dietary goals.',
  },
];

const faqs = [
  {
    title: 'What are your healthiest menu options?',
    description:
      'Our signature salads and custom-built bowls offer the highest concentration of fresh vegetables and lean proteins.',
  },
  {
    title: 'Can I customize a meal to fit my diet?',
    description:
      'Yes. Our Design Your Own Salad option allows you to select every ingredient to perfectly match your specific nutritional requirements.',
  },
  {
    title: 'Are your dressings made in-house?',
    description: 'Yes. All of our signature salad dressings are crafted from scratch daily in our kitchens.',
  },
  {
    title: 'Do you serve local ingredients?',
    description:
      "Yes. We feature local produce including vine-ripe tomatoes from Hauula, as well as fresh, vessel-tracked local ahi.",
  },
  {
    title: 'Where can I pick up a healthy meal?',
    description:
      "Our full menu is available to order online for fast pickup at all six of our neighborhood restaurants across Oahu.",
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="Healthy Food and Menu Options"
    content="Finding a healthy meal should be simple. We serve fresh, nutrient-dense bowls and wraps made from quality ingredients across our six Oahu locations."
    image={menuPagesImages.healthyOptionsHero}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Find a Location', href: LOCATION_CTA_HREF },
    ]}
  />

  <MenuItemsSection
    title="Our Approach to Healthy Eating"
    intro="We focus on clean preparation and fresh components. Whether you are tracking your macros or just looking for a lighter lunch, our menu provides total control over your meal."
    items={approachItems}
  />

  <LocalSourcing
    title="Quality Ingredients"
    subtitle="Healthy food requires quality sourcing. Every item is built on a foundation of premium ingredients, including our house-made dressings, vine-ripe Hauula tomatoes, and vessel-tracked local ahi."
    ctaText="Learn More About Our Ingredients"
    ctaHref="/ingredients"
    withPhoto={true}
    image={menuPagesImages.healthyOptionsIngredients}
  />

  <MenuCategories
    title="Explore Other Menu Categories"
    subtitle="Browse our full menu to find exactly what you are looking for:"
    excludeHref="/menu/healthy-options"
    ctaText=""
  />

  <CTABanner
    title="Ready to Order?"
    subtitle="Skip the line and place your order online for fast pickup. Planning a wellness event or office lunch? We also offer a variety of fresh catering options."
    ctaText="Order Online"
    ctaHref={PRIMARY_CTA_HREF}
    secondaryCtaText="Order Catering"
    secondaryCtaHref={CATERING_CTA_HREF}
  />

  <FAQs title="Frequently Asked Questions" items={faqs} isDark={true} />
</PageLayout>
