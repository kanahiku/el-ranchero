---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title={heroTitle}
    content={heroContent}
    image={menuPagesImages.menuHubHero}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Find a Location', href: LOCATION_CTA_HREF },
    ]}
  />

  <FullMenuSection
    id="full-menu"
    title="Full Menu"
    subtitle="Browse the dishes and drinks available across our menu."
    categories={menuCategories}
    ctaText="Order Online"
    ctaHref={PRIMARY_CTA_HREF}
  />

  <LocalSourcing
    title="Quality Ingredients"
    subtitle={sourcingSubtitle}
    ctaText="Our Ingredients"
    ctaHref="/ingredients"
    withPhoto={true}
    image={menuPagesImages.saladsIngredients}
  />

  <CTABanner
    title="Ready to Order?"
    subtitle="Skip the line and order your favorite meal for quick pickup today."
    ctaText="Order Online"
    ctaHref={PRIMARY_CTA_HREF}
  />

  <FAQs title="Frequently Asked Questions" items={faqs} isDark={true} />
</PageLayout>
