---
/**
 * Menu hub — all copy, links and photos come from the Sanity "Menu hub"
 * singleton (`menuHubContent`); defaults live in src/data/pages/menu.ts.
 * Category cards come from Menu categories, the meat table from Meat options.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import MenuCategories from '~/components/widgets/MenuCategories.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import FeaturedDishes from '~/components/widgets/FeaturedDishes.astro';
import OptionsTable from '~/components/widgets/OptionsTable.astro';
import Locations from '~/components/widgets/Locations.astro';
import Note from '~/components/widgets/Note.astro';
import Text from '~/components/ui/Text.astro';
import { getMeatOptions, getMenuHubContent, getMenuSharedContent } from '~/lib/content';
import { inlineLinkHtml, paragraphsToHtml } from '~/lib/content/inlineLink';

const [c, shared, meatOptions] = await Promise.all([getMenuHubContent(), getMenuSharedContent(), getMeatOptions()]);

const metadata = { title: c.seoTitle, description: c.seoDescription, ignoreTitleTemplate: true };
const linkClass = 'text-accent underline underline-offset-4 transition-opacity hover:opacity-80';

const orderLocations = shared.orderLocations.map((location) => ({
  name: location.name,
  shopName: '',
  addressLine1: location.address,
  addressLine2: '',
  actions: [{ text: location.buttonText, href: location.buttonHref }],
}));
const footnote = inlineLinkHtml(shared.footnoteBefore, shared.footnoteLink, shared.footnoteAfter, linkClass);
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    image={c.heroImage}
    title={c.heroTitle}
    content={paragraphsToHtml(c.heroParagraphs)}
    actions={c.heroActions.map((action) => ({ ...action, variant: action.variant ?? 'primary' }))}
  />

  <MenuCategories id="menu-categories" title={c.categoriesTitle} subtitle={c.categoriesSubtitle} />

  <TextSplit
    id="breakfast"
    heading={c.breakfastHeading}
    withImage
    image={c.breakfastImage}
    imageAspect="4 / 3"
    class="bg-card"
  >
    <div class="flex flex-col gap-6">
      {
        c.breakfastParagraphs.map((paragraph) => (
          <Text variant="body" color="default">
            {paragraph}
          </Text>
        ))
      }
    </div>
  </TextSplit>

  <FeaturedDishes
    id="featured-dishes"
    eyebrow=""
    title={c.featuredTitle}
    subtitle=""
    ctaText=""
    dishes={c.featuredDishes.map((dish) => ({
      title: dish.title,
      image: dish.image,
      href: dish.href,
      description: dish.paragraphs,
    }))}
  />

  <OptionsTable
    id="choose-your-meat"
    tone="card"
    heading={c.meatHeading}
    intro={c.meatIntro}
    note={c.meatNote}
    rows={meatOptions}
  />

  <Locations
    id="order"
    variant="order"
    eyebrow=""
    title={c.orderTitle}
    subtitle={c.orderSubtitle}
    locations={orderLocations}
    footnote={footnote}
  />

  <Note tone="card" title={shared.allergyTitle} description={shared.allergyDescription} />
</PageLayout>
