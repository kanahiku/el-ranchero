---
/**
 * Menu hub — copy from pages-content/Menu Pages/_ menu - Menu Hub.docx.
 * Poster layout for review. Photos come from the Sanity "Menu Pages" singleton
 * (`menuPagesContent`) and the menu category documents; a missing photo renders
 * the grey photo frame.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import PosterButton from '~/components/home/PosterButton.astro';
import HomePhoto from '~/components/home/HomePhoto.astro';
import Lanterns from '~/components/home/Lanterns.astro';
import Calavera from '~/assets/images/v3/calavera.svg';
import CalaveraSmall from '~/assets/images/v3/calavera2.svg';
import ArtEagle from '~/assets/images/v3/art-eagle.svg';
import ArtCactus from '~/assets/images/v3/art-cactus.svg';
import ArtAgave from '~/assets/images/v3/art-agave.svg';
import ArtFlourish from '~/assets/images/v3/art-flourish.svg';
import Blossom from '~/components/home/Blossom.astro';
import { PRIMARY_CTA_HREF } from '~/config/cta';
import { getMeatOptions, getMenuCategories, getMenuPagesImages } from '~/lib/content';
import { allergyNotice, locationsFootnote } from '~/data/menu';

const metadata = {
  title: 'Mexican Food Menu in Wahiawa & Kapolei | El Ranchero',
  description:
    "Explore Taqueria El Ranchero's menu, from Mexican breakfast and burritos to tacos, birria, fajitas and drinks. Order from Wahiawa or Kapolei.",
  ignoreTitleTemplate: true,
};

const meatOptions = await getMeatOptions();
const images = await getMenuPagesImages();
const categories = (await getMenuCategories()).filter((category) => category.href);

const dishes = [
  {
    title: 'Molcajete',
    image: images.featuredMolcajete,
    href: '/menu/entrees',
    description: [
      'Our signature Molcajete brings grilled meats, vegetables and savory sauces together in a traditional volcanic stone mortar.',
      'Served with beans, rice and your choice of corn or flour tortillas, the Molcajete is designed for sharing between two to three people.',
      'Explore Entrees & Fajitas.',
    ],
  },
  {
    title: 'Taco',
    image: images.featuredTaco,
    href: '/menu/tacos',
    description: [
      'Our Taco comes with your choice of meat, onion, cilantro and salsa. You can choose from the meat options listed below.',
      'Explore Tacos & Birria.',
    ],
  },
  {
    title: 'California Burrito',
    image: images.featuredCaliforniaBurrito,
    href: '/menu/burritos',
    description: [
      'Our California Burrito combines your choice of meat with cheese, fries, guacamole and sour cream.',
      'Explore Burritos.',
    ],
  },
];

const orderLocations = [
  {
    name: 'Wahiawa',
    address: '823 California Ave, Unit A5, Wahiawa, HI 96786',
    text: 'Order Wahiawa Takeout',
    href: 'https://www.doordash.com/store/taqueria-el-ranchero-wahiawa-276575/',
  },
  {
    name: 'Kapolei',
    address: '91-5431 Kapolei Pkwy #501, Kapolei, HI 96707',
    text: 'Order Kapolei Takeout',
    href: 'https://www.doordash.com/store/taqueria-el-ranchero-kapolei-2390257/',
  },
];
---

<PageLayout metadata={metadata}>
  <div class="v3-interior">
    <section class="v3-menu-hero" aria-labelledby="menu-title">
      <Lanterns class="v3-menu-lanterns" />
      <div class="v3-wrap v3-menu-hero-frame">
        <div class="v3-menu-hero-copy">
          <h1 id="menu-title" class="v3-display">
            Mexican Food Menu<br />
            in Wahiawa &<br />
            Kapolei
          </h1>
          <div class="v3-menu-copy flex flex-col gap-4">
            <p>
              Explore the Mexican food menu at Taqueria El Ranchero, inspired by the taquerias of Northern California.
              From tacos and burritos to our signature Molcajete, our dishes reflect the straightforward cooking and
              fresh daily preparation behind El Ranchero.
            </p>
            <p>
              Both our Wahiawa and Kapolei restaurants serve the same menu. Browse by category below, then choose your
              location when you’re ready to order.
            </p>
          </div>
          <PosterButton text="Order Now" href={PRIMARY_CTA_HREF} tone="gold" class="mt-8" />
        </div>
        <div class="v3-menu-hero-media">
          <HomePhoto
            image={images.menuHubHero}
            class="v3-menu-hero-photo"
            sizes="(min-width: 768px) 48vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section id="menu-categories" class="v3-section v3-paper" aria-labelledby="menu-categories-title">
      <Blossom class="v3-art v3-art-bloom-explore" fill="var(--v3-red)" center="var(--v3-red)" />
      <ArtAgave class="v3-art v3-art-agave" aria-hidden="true" />
      <div class="v3-wrap">
        <div class="v3-ihead">
          <h2 id="menu-categories-title" class="v3-display">Explore Our Menu</h2>
          <p class="v3-body">Find the dishes you’re looking for with our menu categories.</p>
        </div>
        <div class="v3-menu-grid">
          {
            categories.map((category) => {
              const photo = category.image ?? category.exploreMoreImage;
              return (
                <article class:list={['v3-menu-card', category.hubSpan === 6 && 'v3-menu-card-wide']}>
                  <HomePhoto
                    image={photo}
                    sizes={category.hubSpan === 6 ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 33vw, 100vw'}
                  />
                  <div class="v3-menu-card-body">
                    <h3>
                      <a href={category.href}>{category.title}</a>
                    </h3>
                    {category.description && <p>{category.description}</p>}
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <section id="breakfast" class="v3-section v3-menu-breakfast" aria-labelledby="breakfast-menu-title">
      <ArtFlourish class="v3-art v3-art-flourish" aria-hidden="true" />
      <ArtCactus class="v3-art v3-art-cactus v3-art-cactus-breakfast" aria-hidden="true" />
      <div class="v3-wrap v3-menu-split">
        <HomePhoto
          image={images.breakfastEveryDay}
          class="v3-menu-split-photo"
          sizes="(min-width: 768px) 46vw, 100vw"
        />
        <div class="v3-menu-copy flex flex-col items-start gap-4">
          <h2 id="breakfast-menu-title" class="v3-display">Breakfast Every Day, Starting at 7 AM</h2>
          <p>Breakfast is available at both El Ranchero locations from 7 AM to 12 PM daily.</p>
          <p>
            Our Breakfast Burrito is a convenient option when you’re picking up food on the go. It comes with your
            choice of bacon, ham, chorizo or veggie, along with eggs, beans, cheese, potatoes, tomato, onion and
            jalapeño.
          </p>
          <p>
            If you’re sitting down for breakfast, explore dishes such as Chilaquiles, Huevos con Chorizo and Asada and
            Eggs.
          </p>
        </div>
      </div>
    </section>

    <section
      id="featured-dishes"
      class="v3-section v3-paper v3-menu-feature v3-scalloped"
      aria-labelledby="featured-dishes-title"
    >
      <div class="v3-scallop" aria-hidden="true"></div>
      <div class="v3-wrap">
        <div class="v3-ihead">
          <h2 id="featured-dishes-title" class="v3-display">Featured Dishes From Our Menu</h2>
        </div>
        <div class="v3-feature-grid">
          {
            dishes.map((dish) => (
              <article class="v3-feature-card">
                <HomePhoto image={dish.image} sizes="(min-width: 768px) 33vw, 100vw" />
                <div class="v3-feature-card-body">
                  <h3>
                    <a href={dish.href}>{dish.title}</a>
                  </h3>
                  {dish.description.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="choose-your-meat" class="v3-section v3-red-band" aria-labelledby="meat-title">
      <Blossom class="v3-art v3-art-bloom" fill="var(--v3-ink)" center="var(--v3-ink)" />
      <ArtEagle class="v3-art v3-art-eagle" aria-hidden="true" />
      <div class="v3-wrap">
        <div class="v3-ihead">
          <h2 id="meat-title" class="v3-display">Choose Your Meat</h2>
          <p class="v3-body">
            For dishes that offer a choice of meat, El Ranchero’s menu includes the following options:
          </p>
        </div>
        <ul class="v3-meat-list">
          {
            meatOptions.map((option) => (
              <li>
                <strong>{option.name}</strong>
                <span>{option.description}</span>
              </li>
            ))
          }
        </ul>
        <p class="v3-body mt-6">
          Available choices depend on the dish. Check the relevant menu category or ordering options for details.
        </p>
      </div>
    </section>

    <section id="order" class="v3-section v3-paper v3-scalloped" aria-labelledby="order-title">
      <div class="v3-scallop v3-scallop-red" aria-hidden="true"></div>
      <ArtCactus class="v3-art v3-art-cactus" aria-hidden="true" />
      <div class="v3-wrap">
        <div class="v3-ihead">
          <h2 id="order-title" class="v3-display">Order From Your Nearest El Ranchero</h2>
          <p class="v3-body">Ready to order? Choose your preferred location to view its DoorDash takeout menu.</p>
        </div>
        <div class="v3-menu-order-grid">
          {
            orderLocations.map((location) => (
              <article class="v3-menu-order-card">
                <h3>{location.name}</h3>
                <p>{location.address}</p>
                <PosterButton text={location.text} href={location.href} tone="gold" class="mt-2" />
              </article>
            ))
          }
        </div>
        <p class="v3-body mt-8" set:html={locationsFootnote} />
      </div>
    </section>

    <section class="v3-allergy" aria-labelledby="allergy-title">
      <CalaveraSmall class="v3-allergy-skull v3-allergy-skull-l" aria-hidden="true" />
      <Calavera class="v3-allergy-skull v3-allergy-skull-r" aria-hidden="true" />
      <div class="v3-allergy-card">
        <h2 id="allergy-title" class="v3-display">{allergyNotice.title}</h2>
        <p>{allergyNotice.description}</p>
      </div>
    </section>
  </div>
</PageLayout>
