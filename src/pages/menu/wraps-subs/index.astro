---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import MenuCategories from '~/components/widgets/MenuCategories.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { PRIMARY_CTA_HREF, LOCATION_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { getMenuCategory } from '~/lib/content';
import { getSanityMenuPagesImages } from '~/lib/content/sanity';

const menuPagesImages = await getSanityMenuPagesImages().catch(() => ({} as Awaited<ReturnType<typeof getSanityMenuPagesImages>>));

const metadata = {
  title: 'Fresh Wraps & Subs | El Ranchero Oahu',
  description:
    'Explore our hearty wraps and subs, including the Grilled Steak Wrap, Fresh Island Ahi Wrap, and Club Sub. Order online for pickup across our six Oahu locations.',
  ignoreTitleTemplate: true,
};

const wrapItems = [
  {
    title: 'Grilled Steak Wrap',
    description: 'Grilled steak, mushrooms, red onion, provolone, romaine, sundried tomatoes, and goddess dressing.',
  },
  {
    title: 'Pastrami Melt',
  },
  {
    title: 'Aloha Gyro Wrap',
    description:
      'Thinly sliced Mediterranean seasoned lamb and beef with grilled onions, feta cheese, dill, mixed greens, and our famous goddess dressing.',
  },
  {
    title: 'Curried Chicken Wrap',
    description: 'Curried chicken, mango chutney, carrots, cranberries, grapes, coconut, romaine, and pita.',
  },
  {
    title: 'Club Sub',
    description: 'Turkey bacon, avocado, lettuce, tomato, and mayo on your choice of bread.',
  },
  {
    title: 'Chicken Pesto Sandwich',
    description: 'Grilled chicken, pesto, basil, mixed greens, tomatoes, and mayo on your choice of bread.',
  },
  {
    title: "Tutus Chicken Salad Tortilla Wrap",
    description: 'Chicken breast, romaine, red onions, red grapes, envy apples, celery, and mayo.',
  },
  {
    title: 'Fresh Island Ahi Wrap',
    description:
      'Never-frozen local ahi, grape tomatoes, red onion, mixed greens, capers, and champagne dressing in a pita.',
  },
  {
    title: 'Hummus Pita Wrap',
    description:
      'Hummus, feta, kalamata olives, cucumbers, sundried tomatoes, red and green bell peppers, red onions, dill, grape tomatoes, and romaine.',
  },
  {
    title: 'Caprese Sub',
    description:
      'Fresh mozzarella, tomatoes, basil, red onion, mixed greens, balsamic vinaigrette, and balsamic glaze.',
  },
  {
    title: 'Grilled Cheese Soup Combo',
    description: 'Havarti, cheddar, and fresh mozzarella on sourdough bread, served with a 6oz tomato bisque.',
  },
  {
    title: 'Poke Wrap',
    badge: 'Coming soon',
  },
];

const cmsCategory = await getMenuCategory('wraps-subs');
const menuItems = cmsCategory?.items.length ? cmsCategory.items : wrapItems;

const faqs = [
  {
    title: 'Can I choose the bread for my sub?',
    description: 'Yes. Items like our Club Sub and Chicken Pesto Sandwich are prepared on your choice of bread.',
  },
  {
    title: 'Does the Fresh Island Ahi Wrap use local seafood?',
    description:
      'Yes. We exclusively feature never-frozen local ahi sourced through a Honolulu seafood supplier with full vessel-level traceability.',
  },
  {
    title: 'What comes with the Grilled Cheese Soup Combo?',
    description:
      'The combo includes a grilled cheese sandwich made with havarti, cheddar, and fresh mozzarella on sourdough bread, paired with a 6oz serving of our tomato bisque.',
  },
  {
    title: 'Are there vegetarian wrap options?',
    description:
      'Yes. Our Hummus Pita Wrap and Caprese Sub are excellent meatless options packed with fresh vegetables and cheeses.',
  },
  {
    title: 'Where can I pick up my order?',
    description: "You can order online for fast pickup at any of our six neighborhood restaurants across Oahu.",
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="Wraps and Subs"
    content="Our wraps and subs offer hearty, satisfying meal options built with the same high-quality ingredients and house-made dressings as our signature bowls."
    image={menuPagesImages.wrapsHero}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Find a Location', href: LOCATION_CTA_HREF },
    ]}
  />

  <MenuItemsSection title="Our Wraps & Subs Menu" items={menuItems} />

  <LocalSourcing
    title="Quality Ingredients"
    subtitle="Every wrap and sub is crafted using fresh produce and premium proteins, including our vessel-tracked local ahi."
    ctaText="Learn More About Our Ingredients"
    ctaHref="/ingredients"
    withPhoto={true}
    image={menuPagesImages.wrapsIngredients}
  />

  <MenuCategories
    title="Explore Other Menu Categories"
    subtitle="Looking for a different option? Browse the rest of our menu:"
    excludeHrefs={['/menu/wraps-subs', '/menu/design-your-own-salad']}
    ctaText=""
  />

  <CTABanner
    title="Ready to Order?"
    subtitle="Skip the line and place your order online for fast pickup. Planning a group event? We also offer a variety of sandwich platters."
    ctaText="Order Online"
    ctaHref={PRIMARY_CTA_HREF}
    secondaryCtaText="Order Catering"
    secondaryCtaHref={CATERING_CTA_HREF}
  />

  <FAQs title="Frequently Asked Questions" items={faqs} isDark={true} />
</PageLayout>
