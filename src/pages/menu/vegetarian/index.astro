---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import MenuCategories from '~/components/widgets/MenuCategories.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { PRIMARY_CTA_HREF, LOCATION_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { getMenuCategory } from '~/lib/content';
import { getSanityMenuPagesImages } from '~/lib/content/sanity';

const menuPagesImages = await getSanityMenuPagesImages().catch(() => ({} as Awaited<ReturnType<typeof getSanityMenuPagesImages>>));

const metadata = {
  title: 'Vegetarian Salads & Wraps | El Ranchero Oahu',
  description:
    'Discover our meatless meal selections including the Aloha Passion salad, Hummus Pita Wrap, and Caprese Sub. Order online for fast pickup across our six Oahu locations.',
  ignoreTitleTemplate: true,
};

const vegetarianItems = [
  {
    title: 'Aloha Passion',
    description:
      'Mixed greens, mango, apples, red grapes, cranberries, blue cheese, candied walnuts, and passion orange vinaigrette.',
  },
  {
    title: 'Aloha Mediterranean',
    description:
      'Romaine, grape tomatoes, kalamata olives, feta, bell peppers, red onion, cucumbers, garbanzo beans, dill, and Mediterranean dressing.',
  },
  {
    title: 'The Paniolo',
    description:
      'Romaine, grape tomatoes, avocado, jicama, corn, black beans, green onions, cheddar cheese, cilantro, and BBQ ranch.',
  },
  {
    title: 'Maui Mozzarella',
    description:
      'Mixed greens, tomatoes, fresh mozzarella, red onions, basil, balsamic vinaigrette, and balsamic glaze.',
  },
  {
    title: 'Hummus Pita Wrap',
    description:
      'Hummus, feta, kalamata olives, cucumbers, sundried tomatoes, red and green bell peppers, red onions, dill, grape tomatoes, and romaine.',
  },
  {
    title: 'Caprese Sub',
    description: 'Fresh mozzarella, tomatoes, basil, red onion, mixed greens, balsamic vinaigrette.',
  },
  {
    title: 'Vegan Aloha Mediterranean',
    description:
      'Grape tomatoes, cucumbers, red and green bell peppers, red onions, kalamata olives, dill, garbanzo beans, romaine, and champagne dressing.',
  },
  {
    title: 'Vegan Mandarin Ginger',
    description:
      'Mandarin oranges, carrots, green onions, cilantro, wonton strips, roasted almonds, mixed greens, grilled tofu, and Asian ginger dressing.',
  },
  {
    title: 'Sides',
    description: 'A warm pita, dessert and chips as sides.',
  },
  {
    title: 'Design Your Own Salad',
    description: 'Build a custom vegetarian bowl with your choice of greens, cheeses, and meatless toppings.',
  },
];

const cmsCategory = await getMenuCategory('vegetarian');
const menuItems = cmsCategory?.items.length ? cmsCategory.items : vegetarianItems;

const faqs = [
  {
    title: 'What kind of vegetarian wraps do you serve?',
    description: 'We serve a Hummus Pita Wrap packed with feta, kalamata olives, and fresh vegetables.',
  },
  {
    title: 'Can I adapt a regular menu item to be vegetarian?',
    description:
      "Yes. Some of our signature dishes can be adapted by leaving out the protein. Ask our team when you order and we will talk you through the options.",
  },
  {
    title: 'Can I customize my vegetarian salad?',
    description:
      'Yes. You can use the Design Your Own Salad option to build a bowl exactly how you want it using our vegetarian ingredients and cheeses.',
  },
  {
    title: 'Do your vegetarian salads contain local produce?',
    description: "Yes. We feature local produce including vine-ripe tomatoes grown in Hauula.",
  },
  {
    title: 'Where can I order vegetarian meals for takeout?',
    description:
      "Our full vegetarian menu is available to order online for fast pickup at all six of our neighborhood restaurants across Oahu.",
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="Vegetarian Menu Options"
    content="Our vegetarian menu offers a wide variety of meat-free meals. Choose from our established recipes or build your own bowl using our daily selection of fresh cheeses and produce."
    image={menuPagesImages.vegetarianHero}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Find a Location', href: LOCATION_CTA_HREF },
    ]}
  />

  <MenuItemsSection title="Our Vegetarian Menu" items={menuItems} />

  <LocalSourcing
    title="Quality Ingredients"
    subtitle="Every vegetarian item is built using the same high-quality components as the rest of our menu, including our house-made dressings and vine-ripe Hauula tomatoes."
    ctaText="Learn More About Our Ingredients"
    ctaHref="/ingredients"
    withPhoto={true}
    image={menuPagesImages.vegetarianIngredients}
  />

  <MenuCategories
    title="Explore Other Menu Categories"
    subtitle="Looking for a different meal option? Browse the rest of our menu:"
    excludeHref="/menu/vegetarian"
    ctaText=""
  />

  <CTABanner
    title="Ready to Order?"
    subtitle="Skip the line and place your order online for fast pickup. Planning a group event? We also offer a variety of meatless catering trays."
    ctaText="Order Online"
    ctaHref={PRIMARY_CTA_HREF}
    secondaryCtaText="Order Catering"
    secondaryCtaHref={CATERING_CTA_HREF}
  />

  <FAQs title="Frequently Asked Questions" items={faqs} isDark={true} />
</PageLayout>
