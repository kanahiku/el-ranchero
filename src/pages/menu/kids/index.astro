---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import MenuCategories from '~/components/widgets/MenuCategories.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { PRIMARY_CTA_HREF, LOCATION_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { getMenuCategory } from '~/lib/content';
import { getSanityMenuPagesImages } from '~/lib/content/sanity';

const menuPagesImages = await getSanityMenuPagesImages().catch(() => ({} as Awaited<ReturnType<typeof getSanityMenuPagesImages>>));

const metadata = {
  title: 'Keiki Menu & Kids Meals | El Ranchero Oahu',
  description:
    'Discover our Keiki Combo, featuring a wholesome pita sandwich, fresh fruit, a drink, and an organic lollipop. Available across our six Oahu locations.',
  ignoreTitleTemplate: true,
};

const kidsItems = [
  {
    title: 'Keiki Combo',
    description: 'Pita sandwich, fruit, keiki drink, and an organic lollipop.',
  },
];

const cmsCategory = await getMenuCategory('kids');
const menuItems = cmsCategory?.items.length ? cmsCategory.items : kidsItems;

const faqs = [
  {
    title: 'What is included in the Keiki Combo?',
    description: 'The combo includes a pita sandwich, fresh fruit, a keiki drink, and an organic lollipop.',
  },
  {
    title: 'Are the lollipops organic?',
    description: 'Yes. Every Keiki Combo comes with an organic lollipop.',
  },
  {
    title: 'Can I order the Keiki Combo for takeout?',
    description: 'Yes. You can place your order online for fast pickup at your nearest location.',
  },
  {
    title: 'Is the Keiki Menu available at all restaurants?',
    description: "Yes. Our keiki options are available across all six of our neighborhood restaurants on Oahu.",
  },
  {
    title: 'Where are your Oahu locations?',
    description:
      'We operate six neighborhood restaurants located in Kailua, Kahala, Kaneohe, Kapolei, Mililani, and Pearlridge.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="Keiki Menu"
    content="Wholesome and portioned for children, our keiki options offer balanced meals built with the same quality ingredients found across our entire menu."
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Find a Location', href: LOCATION_CTA_HREF },
    ]}
  />

  <MenuItemsSection title="Our Keiki Menu" items={menuItems} />

  <LocalSourcing
    title="Quality Ingredients"
    subtitle="Every item on our menu is built on a foundation of quality ingredients and careful preparation."
    ctaText="Learn More About Our Ingredients"
    ctaHref="/ingredients"
    withPhoto={true}
    image={menuPagesImages.kidsIngredients}
  />

  <MenuCategories
    title="Explore Other Menu Categories"
    subtitle="Looking to complete your family order? Browse the rest of our menu:"
    excludeHrefs={['/menu/kids', '/menu/design-your-own-salad']}
    ctaText=""
  />

  <CTABanner
    title="Ready to Order?"
    subtitle="Skip the line and place your family order online for fast pickup. Planning a group event? We also offer a variety of catering options."
    ctaText="Order Online"
    ctaHref={PRIMARY_CTA_HREF}
    secondaryCtaText="Order Catering"
    secondaryCtaHref={CATERING_CTA_HREF}
  />

  <FAQs title="Frequently Asked Questions" items={faqs} isDark={true} />
</PageLayout>
