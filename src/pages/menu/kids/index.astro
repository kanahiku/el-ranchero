---
/**
 * Kids Menu — copy from pages-content/Menu Pages/_ menu_kids - Kids Menu.docx.
 * Poster layout. Photos come from Sanity.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import MenuHero from '~/components/menu/MenuHero.astro';
import MenuItemGrid from '~/components/menu/MenuItemGrid.astro';
import MenuOrder from '~/components/menu/MenuOrder.astro';
import MenuMore from '~/components/menu/MenuMore.astro';
import MenuAllergy from '~/components/menu/MenuAllergy.astro';
import { getMenuPagesImages, getMenuSections } from '~/lib/content';

const metadata = {
  title: 'Kids Menu in Wahiawa & Kapolei | El Ranchero',
  description:
    'Explore the Kids Menu at El Ranchero in Wahiawa and Kapolei, including a Cheese Quesadilla with fries, a Taco with rice and beans, and a Niño Burrito.',
  ignoreTitleTemplate: true,
};

const sections = await getMenuSections('kids');
const images = await getMenuPagesImages();
---

<PageLayout metadata={metadata}>
  <div class="v3-interior">
    <MenuHero
      titleId="kids-title"
      lines={['Kids Menu', 'in Wahiawa &', 'Kapolei']}
      image={images.kidsHero}
      paragraphs={[
        'Dining with kids? Taqueria El Ranchero has three Kids Menu choices, each listed with its own simple combination of food and sides.',
        'Find the Kids Menu at our Wahiawa and Kapolei locations, and check ordering availability at your preferred restaurant.',
      ]}
    />
    <MenuItemGrid id="kids-menu" title="Explore Our Kids Menu" items={sections.main} />
    <MenuOrder
      tone="ink"
      subtitle="Both Taqueria El Ranchero restaurants use the same menu. Select your preferred location to check current availability and takeout options through DoorDash."
    />
    <MenuMore
      excludeHref="/menu/kids"
      tone="paper"
      scallop
      cactus
      subtitle="Find more Mexican food and drinks at Taqueria El Ranchero. Browse other sections of our menu."
    />
    <MenuAllergy />
  </div>
</PageLayout>
