---
/**
 * Kids Menu — copy from pages-content/Menu Pages/_ menu_kids - Kids Menu.docx.
 * Composes shared widgets only. Photos are grey placeholders until the
 * client photography pass.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import Locations from '~/components/widgets/Locations.astro';
import MenuCategories from '~/components/widgets/MenuCategories.astro';
import Note from '~/components/widgets/Note.astro';
import { PRIMARY_CTA_HREF } from '~/config/cta';
import { getMenuSections } from '~/lib/content';
import { allergyNotice, locationsFootnote, orderLocations } from '~/data/menu';

const metadata = {
  title: 'Kids Menu in Wahiawa & Kapolei | El Ranchero',
  description:
    'Explore the Kids Menu at El Ranchero in Wahiawa and Kapolei, including a Cheese Quesadilla with fries, a Taco with rice and beans, and a Niño Burrito.',
  ignoreTitleTemplate: true,
};

const sections = await getMenuSections('kids');

---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="Kids Menu in Wahiawa & Kapolei"
    content="Dining with kids? Taqueria El Ranchero has three Kids Menu choices, each listed with its own simple combination of food and sides.<br /><br />Find the Kids Menu at our Wahiawa and Kapolei locations, and check ordering availability at your preferred restaurant."
    actions={[{ variant: 'primary', text: 'Order Now', href: PRIMARY_CTA_HREF }]}
  />

  <MenuItemsSection id="kids-menu" tone="page" title="Explore Our Kids Menu" items={sections.main} />

  <Locations
    id="order"
    variant="order"
    eyebrow=""
    title="Order From Your Nearest El Ranchero"
    subtitle="Both Taqueria El Ranchero restaurants use the same menu. Select your preferred location to check current availability and takeout options through DoorDash."
    locations={orderLocations}
    footnote={locationsFootnote}
  />

  <MenuCategories
    id="more-menu"
    tone="page"
    title="Explore More of Our Menu"
    subtitle="Find more Mexican food and drinks at Taqueria El Ranchero. Browse other sections of our menu."
    excludeHref="/menu/kids"
    ctaText="View Full Menu"
    ctaHref="/menu"
  />

  <Note tone="card" title={allergyNotice.title} description={allergyNotice.description} />
</PageLayout>
