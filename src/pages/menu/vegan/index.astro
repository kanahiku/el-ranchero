---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import MenuCategories from '~/components/widgets/MenuCategories.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { PRIMARY_CTA_HREF, LOCATION_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { getMenuCategory } from '~/lib/content';
import { getSanityMenuPagesImages } from '~/lib/content/sanity';

const menuPagesImages = await getSanityMenuPagesImages().catch(() => ({} as Awaited<ReturnType<typeof getSanityMenuPagesImages>>));

const metadata = {
  title: 'Vegan Salads & Bowls | El Ranchero Oahu',
  description:
    'Explore dedicated plant-based options including the Vegan Aloha Mediterranean. Order online across our six Oahu locations.',
  ignoreTitleTemplate: true,
};

const veganItems = [
  {
    title: 'Vegan Aloha Mediterranean',
    description:
      'Grape tomatoes, cucumbers, red & green bell peppers, red onions, olives, dill, garbanzo beans, romaine, and champagne dressing.',
  },
  {
    title: 'Vegan Mandarin Ginger',
    description:
      'Mandarin oranges, carrots, green onions, cilantro, wonton strips, roasted almonds, mixed greens, grilled tofu, and Asian ginger dressing.',
  },
  {
    title: 'Design Your Own Salad',
    description: 'Build a custom vegan bowl with your choice of greens and plant-based toppings.',
  },
];

const cmsCategory = await getMenuCategory('vegan');
const menuItems = cmsCategory?.items.length ? cmsCategory.items : veganItems;

const faqs = [
  {
    title: 'Can I customize my vegan salad?',
    description:
      'Yes. You can use the Design Your Own Salad option to build a bowl exactly how you want it using our plant-based ingredients.',
  },
  {
    title: 'Are your vegan dressings made in-house?',
    description: 'Yes. All of our signature salad dressings are crafted from scratch daily in our kitchens.',
  },
  {
    title: 'Do your vegan options contain local produce?',
    description: "Yes. We feature local produce including vine-ripe tomatoes grown in Hauula.",
  },
  {
    title: 'Can I order a vegan meal for takeout?',
    description: "Yes. You can order online for fast pickup at any of our six neighborhood restaurants across Oahu.",
  },
  {
    title: 'Do you offer catering for vegan diets?',
    description: 'Yes. We offer catering trays that can accommodate plant-based dietary requirements for group events.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="Vegan Menu Options"
    content="Our vegan menu features dedicated plant-based bowls. Choose from our signature recipes or build your own salad using our house-made dressings."
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Find a Location', href: LOCATION_CTA_HREF },
    ]}
  />

  <MenuItemsSection title="Our Vegan Menu" items={menuItems} />

  <LocalSourcing
    title="Quality Ingredients"
    subtitle="Our plant-based options are built using the same high-quality components as the rest of our menu, including our house-made vegan dressings and vine-ripe Hauula tomatoes."
    ctaText="Learn More About Our Ingredients"
    ctaHref="/ingredients"
    withPhoto={true}
    image={menuPagesImages.veganIngredients}
  />

  <MenuCategories
    title="Explore Other Menu Categories"
    subtitle="Looking for a different meal option? Browse the rest of our menu:"
    excludeHref="/menu/vegan"
    ctaText=""
  />

  <CTABanner
    title="Ready to Order?"
    subtitle="Skip the line and place your order online for fast pickup. Planning a group event? We also offer a variety of catering options."
    ctaText="Order Online"
    ctaHref={PRIMARY_CTA_HREF}
    secondaryCtaText="Order Catering"
    secondaryCtaHref={CATERING_CTA_HREF}
  />

  <FAQs title="Frequently Asked Questions" items={faqs} isDark={true} />
</PageLayout>
