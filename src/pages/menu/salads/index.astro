---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import MenuCategories from '~/components/widgets/MenuCategories.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { PRIMARY_CTA_HREF, LOCATION_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { getMenuCategory } from '~/lib/content';
import { getSanityMenuPagesImages } from '~/lib/content/sanity';

const menuPagesImages = await getSanityMenuPagesImages().catch(() => ({} as Awaited<ReturnType<typeof getSanityMenuPagesImages>>));

const metadata = {
  title: 'Signature Salads & Bowls | El Ranchero Oahu',
  description:
    'Explore our signature salads including the Ono Island Ahi and Kamuela Cobb. Built with fresh ingredients and house-made dressings across our six Oahu locations.',
  ignoreTitleTemplate: true,
};

const saladItems = [
  {
    title: 'Aloha Passion',
    description:
      'Mixed greens, mango, apples, red grapes, cranberries, blue cheese, candied walnuts, and passion orange vinaigrette.',
  },
  {
    title: 'Ono Island Ahi',
    description:
      'Mixed greens, never-frozen local ahi, mango, avocado, coconut, strawberries, green onions, bean sprouts, and passion orange vinaigrette.',
  },
  {
    title: 'Kamuela Cobb',
    description: 'Mixed greens, avocado, grape tomatoes, egg, bacon, blue cheese, chicken, and herb ranch.',
  },
  {
    title: 'Big Island Beet',
    note: 'Not available at Kaneohe',
  },
  {
    title: 'Aloha Caesar',
    description: 'Romaine, parmesan, croutons, Caesar dressing, and your choice of protein.',
  },
  {
    title: 'Mandarin Ginger',
    description:
      'Mixed greens, mandarin oranges, carrots, cilantro, green onions, wontons, almonds, chicken, and Asian ginger dressing.',
  },
  {
    title: 'Aloha Mediterranean',
    description:
      'Romaine, grape tomatoes, kalamata olives, feta, bell peppers, red onion, cucumbers, garbanzo beans, dill, and Mediterranean dressing.',
  },
  {
    title: 'The Paniolo',
    description:
      'Romaine, grape tomatoes, avocado, jicama, corn, black beans, green onions, cheddar cheese, cilantro, and BBQ ranch.',
  },
  {
    title: 'Maui Mozzarella',
    description:
      'Mixed greens, tomatoes, fresh mozzarella, red onions, basil, balsamic vinaigrette, and balsamic glaze.',
  },
  {
    title: 'Design Your Own Salad',
    description:
      'Includes your choice of lettuce, four regular toppings, one cheese, and one dressing (additional charge for extra items).',
  },
  {
    title: 'Poke Bowl',
    badge: 'Coming soon',
  },
  {
    title: 'Poke Salad',
    badge: 'Coming soon',
  },
];

const cmsCategory = await getMenuCategory('salads');
const menuItems = cmsCategory?.items.length ? cmsCategory.items : saladItems;

const faqs = [
  {
    title: 'Can I customize my salad?',
    description:
      'Yes. You can use the Design Your Own Salad option to choose your preferred lettuce, four regular toppings, one cheese, and one dressing.',
  },
  {
    title: 'Where does your ahi come from?',
    description:
      'We exclusively feature never-frozen local ahi sourced through a Honolulu seafood supplier with full vessel-level traceability.',
  },
  {
    title: 'Are your salad dressings made in-house?',
    description: 'Yes. All of our signature salad dressings are crafted from scratch daily in our kitchens.',
  },
  {
    title: 'Do your salads contain local produce?',
    description: "Yes. We feature local produce including vine-ripe tomatoes grown in Hauula.",
  },
  {
    title: 'Where can I order a salad for pickup?',
    description: "You can order online for fast pickup at any of our six neighborhood restaurants across Oahu.",
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="Signature Salads"
    content="Our salads are built with quality produce and seafood delivered directly to our kitchens across Oahu. We prepare all of our signature dressings from scratch daily."
    image={menuPagesImages.saladsHero}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Find a Location', href: LOCATION_CTA_HREF },
    ]}
  />

  <MenuItemsSection title="Our Salad Menu" items={menuItems} />

  <LocalSourcing
    title="Sourced with Care"
    subtitle="We maintain a standing weekly order for vine-ripe tomatoes from Hauula and exclusively feature never-frozen local ahi with vessel-level catch traceability."
    ctaText="Learn More About Our Ingredients"
    ctaHref="/ingredients"
    withPhoto={true}
    image={menuPagesImages.saladsIngredients}
  />

  <MenuCategories
    title="Explore Other Menu Categories"
    subtitle="Looking for something else? Browse the rest of our menu:"
    excludeHrefs={['/menu/salads', '/menu/design-your-own-salad']}
    ctaText=""
  />

  <CTABanner
    title="Ready to Order?"
    subtitle="Skip the line and place your order online for fast pickup. Planning a group event? We also offer a variety of priced catering trays."
    ctaText="Order Online"
    ctaHref={PRIMARY_CTA_HREF}
    secondaryCtaText="Order Catering"
    secondaryCtaHref={CATERING_CTA_HREF}
  />

  <FAQs title="Frequently Asked Questions" items={faqs} isDark={true} />
</PageLayout>
