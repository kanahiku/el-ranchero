---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import MenuCategories from '~/components/widgets/MenuCategories.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { PRIMARY_CTA_HREF, LOCATION_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { getMenuCategory } from '~/lib/content';
import { getSanityMenuPagesImages } from '~/lib/content/sanity';

const menuPagesImages = await getSanityMenuPagesImages().catch(() => ({} as Awaited<ReturnType<typeof getSanityMenuPagesImages>>));

const metadata = {
  title: 'Fresh Soups & Tomato Bisque | El Ranchero Oahu',
  description:
    'Warm up with our signature thick and creamy Tomato Bisque, available daily across our six Oahu locations. Order online for fast pickup.',
  ignoreTitleTemplate: true,
};

const soupItems = [
  {
    title: 'Tomato Bisque',
    description: 'Our signature thick and creamy soup.',
  },
  {
    title: 'Extra Pita',
    description: 'A warm side option perfect for dipping.',
  },
];

const cmsCategory = await getMenuCategory('soups');
const menuItems = cmsCategory?.items.length ? cmsCategory.items : soupItems;

const faqs = [
  {
    title: 'What kind of soup do you serve?',
    description: 'We serve our signature Tomato Bisque, which is a thick and creamy classic.',
  },
  {
    title: 'Can I pair my soup with a sandwich?',
    description:
      'Yes. You can order our Grilled Cheese Soup Combo from the Wraps and Subs menu, which includes havarti, cheddar, and fresh mozzarella on sourdough bread served alongside a 6oz portion of Tomato Bisque.',
  },
  {
    title: 'Do you offer sides with the soup?',
    description: 'Yes. You can order an extra side of pita bread to accompany your soup.',
  },
  {
    title: 'Is the soup available at all locations?',
    description: "Yes. Our menu is available across all six of our neighborhood restaurants on Oahu.",
  },
  {
    title: 'Can I order soup for takeout?',
    description: 'Yes. You can place your order online for fast pickup at your nearest location.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="Soups"
    content="Our seasonal soups are crafted to perfectly complement our signature salads and wraps."
    image={menuPagesImages.soupsHero}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Find a Location', href: LOCATION_CTA_HREF },
    ]}
  />

  <MenuItemsSection title="Our Soup Menu" items={menuItems} />

  <LocalSourcing
    title="Quality Ingredients"
    subtitle="Every item on our menu is built on a foundation of quality ingredients and careful preparation."
    ctaText="Learn More About Our Ingredients"
    ctaHref="/ingredients"
    withPhoto={true}
    image={menuPagesImages.soupsIngredients}
  />

  <MenuCategories
    title="Explore Other Menu Categories"
    subtitle="Looking to complete your meal? Browse the rest of our menu:"
    excludeHrefs={['/menu/soups', '/menu/design-your-own-salad']}
    ctaText=""
  />

  <CTABanner
    title="Ready to Order?"
    subtitle="Skip the line and place your order online for fast pickup. Planning a group event? We also offer a variety of catering options."
    ctaText="Order Online"
    ctaHref={PRIMARY_CTA_HREF}
    secondaryCtaText="Order Catering"
    secondaryCtaHref={CATERING_CTA_HREF}
  />

  <FAQs title="Frequently Asked Questions" items={faqs} isDark={true} />
</PageLayout>
