---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import StoreVisit from '~/components/widgets/StoreVisit.astro';
import LocationDirectory from '~/components/widgets/LocationDirectory.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Text from '~/components/ui/Text.astro';
import { PRIMARY_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { findStore } from '~/data/locations';
import { getSanityLocationImages } from '~/lib/content/sanity';

const store = findStore('kailua');
if (!store) throw new Error('Missing Kailua store');
const locationImages = await getSanityLocationImages();

const metadata = {
  title: 'Kailua Location | El Ranchero Oahu',
  description:
    'Visit El Ranchero at the Kailua Shopping Center. We serve fresh salads, signature wraps, healthy soups, and local beverages for dine-in or pickup.',
  ignoreTitleTemplate: true,
};

const faqs = [
  {
    title: 'Is parking available at the Kailua location?',
    description: 'Yes. The Kailua Shopping Center provides ample free parking for our restaurant guests.',
  },
  {
    title: 'Can I dine in at El Ranchero Kailua?',
    description: 'Yes. We offer a dedicated dining area for guests who prefer to eat their meals on site.',
  },
  {
    title: 'Can I pick up catering orders in Kailua?',
    description: 'Yes. You can schedule large party trays and corporate catering orders for pickup at this location.',
  },
  {
    title: 'Can I collect a catering order from Kailua?',
    description: 'Yes. Catering trays can be collected from this store. Call ahead to arrange it.',
  },
  {
    title: 'Do you deliver to the Kailua area?',
    description:
      'We partner with third-party delivery services to bring our meals to local residents. Delivery availability depends on your exact address.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="El Ranchero Kailua"
    content="Visit our neighborhood restaurant for a fresh meal on the Windward coast. We serve custom bowls and signature wraps for fast pickup or casual dine-in."
    image={locationImages.kailua}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Order Catering', href: CATERING_CTA_HREF },
    ]}
  />

  <TextSplit heading="Our Original Home in Kailua">
    <div class="flex flex-col gap-6">
      <Text variant="body-lg" color="default">
        Kailua is where the El Ranchero story began in May 2006. We opened our doors on the Windward coast with a
        mission to serve healthy meals using ingredients from Hawaii farmers and fishermen. Whether you are grabbing
        lunch after a morning at Kailua Beach or picking up dinner, our menu features crisp greens and never-frozen
        local ahi. We proudly serve the community that helped us grow into a local staple. Enjoy easy parking and a
        welcoming space for your next meal.
      </Text>
    </div>
  </TextSplit>

  <StoreVisit store={store} id="visit" title="Location Details" />

  <LocationDirectory
    title="More Oahu Locations"
    subtitle="Find us across the island. Explore our other neighborhood restaurants below:"
    excludeHref={store.href}
  />

  <FAQs isDark={true} title="Frequently Asked Questions" items={faqs} />

  <CTABanner
    title="Visit Us in Kailua"
    subtitle="Stop by the Kailua Shopping Center for a fresh meal or place your order online to skip the line."
    ctaText="View Full Menu"
    ctaHref="/menu"
    secondaryCtaText="Order Online"
    secondaryCtaHref={PRIMARY_CTA_HREF}
  />
</PageLayout>
