---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import StoreVisit from '~/components/widgets/StoreVisit.astro';
import LocationDirectory from '~/components/widgets/LocationDirectory.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Text from '~/components/ui/Text.astro';
import { PRIMARY_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { findStore } from '~/data/locations';
import { getSanityLocationImages } from '~/lib/content/sanity';

const store = findStore('kahala');
if (!store) throw new Error('Missing Kahala store');
const locationImages = await getSanityLocationImages();

const metadata = {
  title: 'Kahala Location | El Ranchero Oahu',
  description:
    'Visit El Ranchero at Kahala Mall in Honolulu. We serve fresh salads, signature wraps, healthy soups, and local beverages for dine-in or pickup.',
  ignoreTitleTemplate: true,
};

const faqs = [
  {
    title: 'Is parking available at the Kahala location?',
    description: 'Yes. Kahala Mall provides ample free parking for our restaurant guests.',
  },
  {
    title: 'Can I dine in at El Ranchero Kahala?',
    description: 'Yes. We offer a dedicated dining area for guests who prefer to eat their meals on site.',
  },
  {
    title: 'Can I pick up catering orders in Kahala?',
    description: 'Yes. You can schedule large party trays and corporate catering orders for pickup at this location.',
  },
  {
    title: 'Can I collect a catering order from Kahala?',
    description: 'Yes. Catering trays can be collected from this store. Call ahead to arrange it.',
  },
  {
    title: 'Do you deliver to the Kahala area?',
    description:
      'We partner with third-party delivery services to bring our meals to local residents. Delivery availability depends on your exact address.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="El Ranchero Kahala"
    content="Visit our Honolulu restaurant for a fresh meal at Kahala Mall. We serve custom bowls and signature wraps for fast pickup or casual dine-in."
    image={locationImages.kahala}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Order Catering', href: CATERING_CTA_HREF },
    ]}
  />

  <TextSplit heading="Your Kahala Neighborhood Stop">
    <div class="flex flex-col gap-6">
      <Text variant="body-lg" color="default">
        Kahala Mall is your local destination for crisp greens and fresh local fish. Whether you are taking a break from
        shopping or grabbing a healthy meal after work, our menu features house-made dressings and never-frozen local
        ahi. We proudly serve the Honolulu community with convenient grab-and-go options and a welcoming space to enjoy
        your food.
      </Text>
    </div>
  </TextSplit>

  <StoreVisit store={store} id="visit" title="Location Details" />

  <LocationDirectory
    title="More Oahu Locations"
    subtitle="Find us across the island. Explore our other neighborhood restaurants below:"
    excludeHref={store.href}
  />

  <FAQs isDark={true} title="Frequently Asked Questions" items={faqs} />

  <CTABanner
    title="Visit Us in Kahala"
    subtitle="Stop by Kahala Mall for a fresh meal or place your order online to skip the line."
    ctaText="View Full Menu"
    ctaHref="/menu"
    secondaryCtaText="Order Online"
    secondaryCtaHref={PRIMARY_CTA_HREF}
  />
</PageLayout>
