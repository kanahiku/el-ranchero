---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import StoreVisit from '~/components/widgets/StoreVisit.astro';
import LocationDirectory from '~/components/widgets/LocationDirectory.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Text from '~/components/ui/Text.astro';
import { PRIMARY_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { findStore } from '~/data/locations';
import { getSanityLocationImages } from '~/lib/content/sanity';

const store = findStore('mililani');
if (!store) throw new Error('Missing Mililani store');
const locationImages = await getSanityLocationImages();

const metadata = {
  title: 'Mililani Location | El Ranchero Oahu',
  description:
    'Visit El Ranchero at Mililani Town Center. We serve fresh salads, signature wraps, healthy soups, and local beverages for dine-in or pickup.',
  ignoreTitleTemplate: true,
};

const faqs = [
  {
    title: 'Is parking available at the Mililani location?',
    description: 'Yes. Mililani Town Center provides ample free parking for our restaurant guests.',
  },
  {
    title: 'Can I dine in at El Ranchero Mililani?',
    description: 'Yes. We offer a dedicated dining area for guests who prefer to eat their meals on site.',
  },
  {
    title: 'Can I pick up catering orders in Mililani?',
    description: 'Yes. You can schedule large party trays and corporate catering orders for pickup at this location.',
  },
  {
    title: 'Can I collect a catering order from Mililani?',
    description: 'Yes. Catering trays can be collected from this store. Call ahead to arrange it.',
  },
  {
    title: 'Do you deliver to the Mililani area?',
    description:
      'We partner with third-party delivery services to bring our meals to local residents. Delivery availability depends on your exact address.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="El Ranchero Mililani"
    content="Visit our central Oahu restaurant for a fresh meal at Mililani Town Center. We serve custom bowls and signature wraps for fast pickup or casual dine-in."
    image={locationImages.mililani}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Order Catering', href: CATERING_CTA_HREF },
    ]}
  />

  <TextSplit heading="Your Mililani Neighborhood Stop">
    <div class="flex flex-col gap-6">
      <Text variant="body-lg" color="default">
        Mililani Town Center is your local destination for wholesome, scratch-made food featuring ingredients sourced
        from Hawaii farmers. Whether you are running errands around the central community or picking up a healthy
        dinner, our menu features crisp greens, house-made dressings, and vibrant local flavors. We proudly serve the
        Mililani area with a welcoming space to enjoy your food.
      </Text>
    </div>
  </TextSplit>

  <StoreVisit store={store} id="visit" title="Location Details" />

  <LocationDirectory
    title="More Oahu Locations"
    subtitle="Find us across the island. Explore our other neighborhood restaurants below:"
    excludeHref={store.href}
  />

  <FAQs isDark={true} title="Frequently Asked Questions" items={faqs} />

  <CTABanner
    title="Visit Us in Mililani"
    subtitle="Stop by Mililani Town Center for a fresh meal or place your order online to skip the line."
    ctaText="View Full Menu"
    ctaHref="/menu"
    secondaryCtaText="Order Online"
    secondaryCtaHref={PRIMARY_CTA_HREF}
  />
</PageLayout>
