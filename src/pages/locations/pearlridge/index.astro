---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import StoreVisit from '~/components/widgets/StoreVisit.astro';
import LocationDirectory from '~/components/widgets/LocationDirectory.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Text from '~/components/ui/Text.astro';
import { PRIMARY_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { findStore } from '~/data/locations';
import { getSanityLocationImages } from '~/lib/content/sanity';

const store = findStore('pearlridge');
if (!store) throw new Error('Missing Pearlridge store');
const locationImages = await getSanityLocationImages();

const metadata = {
  title: 'Pearlridge Location | El Ranchero Oahu',
  description:
    'Visit El Ranchero at Pearlridge Center Downtown. We serve fresh salads, signature wraps, healthy soups, and local beverages for dine-in or pickup.',
  ignoreTitleTemplate: true,
};

const faqs = [
  {
    title: 'Is parking available at the Pearlridge location?',
    description: 'Yes. Pearlridge Center provides ample free parking for our restaurant guests.',
  },
  {
    title: 'Can I dine in at El Ranchero Pearlridge?',
    description: 'Yes. We offer a dedicated dining area for guests who prefer to eat their meals on site.',
  },
  {
    title: 'Can I pick up catering orders in Pearlridge?',
    description: 'Yes. You can schedule large party trays and corporate catering orders for pickup at this location.',
  },
  {
    title: 'Can I collect a catering order from Pearlridge?',
    description: 'Yes. Catering trays can be collected from this store. Call ahead to arrange it.',
  },
  {
    title: 'Do you deliver to the Pearlridge area?',
    description:
      'We partner with third-party delivery services to bring our meals to local residents. Delivery availability depends on your exact address.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="El Ranchero Pearlridge"
    content="Visit our Aiea restaurant for a fresh meal at Pearlridge Center Downtown. We serve custom bowls and signature wraps for fast pickup or casual dine-in."
    image={locationImages.pearlridge}
    actions={[
      { variant: 'primary', text: 'Order Online for Pickup', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Order Catering', href: CATERING_CTA_HREF },
    ]}
  />

  <TextSplit heading="Your Pearlridge Neighborhood Stop">
    <div class="flex flex-col gap-6">
      <Text variant="body-lg" color="default">
        Pearlridge and Aiea feature custom salad bowls packed with fresh ingredients and local flavors right in the
        heart of the community. Whether you are shopping at the center or taking a lunch break during a busy workday,
        our menu features crisp greens, house-made dressings, and vibrant ingredients. We proudly serve the central
        community with a welcoming space to enjoy wholesome food.
      </Text>
    </div>
  </TextSplit>

  <StoreVisit store={store} id="visit" title="Location Details" />

  <LocationDirectory
    title="More Oahu Locations"
    subtitle="Find us across the island. Explore our other neighborhood restaurants below:"
    excludeHref={store.href}
  />

  <FAQs isDark={true} title="Frequently Asked Questions" items={faqs} />

  <CTABanner
    title="Visit Us in Pearlridge"
    subtitle="Stop by Pearlridge Center for a fresh meal or place your order online to skip the line."
    ctaText="View Full Menu"
    ctaHref="/menu"
    secondaryCtaText="Order Online"
    secondaryCtaHref={PRIMARY_CTA_HREF}
  />
</PageLayout>
