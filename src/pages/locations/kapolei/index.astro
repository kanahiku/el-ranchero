---
/**
 * Kapolei location — copy from pages-content/Locations/Location - Kapolei.docx.
 * Composes shared widgets only. The storefront photo is a grey placeholder
 * until the client photography pass ("keep existing storefront image").
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import StoreVisit from '~/components/widgets/StoreVisit.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import { CATERING_CTA_HREF } from '~/config/cta';
import { EVENTS_INSTAGRAM_HANDLE, EVENTS_INSTAGRAM_HREF } from '~/data/events';
import { findStore, storeDirectionsHref } from '~/data/locations';

const store = findStore('kapolei');
if (!store) throw new Error('Missing Kapolei store');
const directionsHref = storeDirectionsHref(store);

const metadata = {
  title: 'Mexican Restaurant in Kapolei, HI | Taqueria El Ranchero',
  description:
    'Visit Taqueria El Ranchero in Kapolei for tacos, burritos, Mexican breakfast and more at Ka Makana Aliʻi. View the menu or order on DoorDash.',
  ignoreTitleTemplate: true,
};

const favorites = [
  {
    title: 'Tacos',
    description: 'Go classic or try something different with available meat, seafood and vegetarian options.',
  },
  {
    title: 'California Burrito',
    description: 'A filling burrito favorite for when you want something hearty.',
  },
  {
    title: 'Birria',
    description: 'Look for savory birria among the Mexican favorites available on the Kapolei menu.',
  },
  {
    title: 'Quesadillas',
    description: 'A simple favorite with available fillings and options to make it your own.',
  },
  {
    title: 'Mexican Plates',
    description: 'Sit down to a full meal with available dishes such as enchiladas, carne asada, fajitas and other Mexican favorites.',
  },
];

const faqs = [
  {
    title: 'Where is Taqueria El Ranchero in Kapolei?',
    description:
      'Taqueria El Ranchero is located at 91-5431 Kapolei Pkwy #501, Kapolei, HI 96707, at Ka Makana Aliʻi.',
  },
  {
    title: 'What are Taqueria El Ranchero Kapolei\'s hours?',
    description:
      'The Kapolei location is open Monday through Sunday from 10:00 AM to 9:00 PM.',
  },
  {
    title: 'Can I order Taqueria El Ranchero Kapolei online?',
    description:
      'Yes. Online ordering is available through DoorDash. Visit the Kapolei DoorDash menu to see current selections, availability and pricing.',
  },
  {
    title: 'Does Taqueria El Ranchero Kapolei serve breakfast?',
    description:
      'The Kapolei menu includes Mexican breakfast favorites such as breakfast burritos, chilaquiles, huevos rancheros and breakfast tacos. Menu selections may vary, so check DoorDash for current availability.',
  },
  {
    title: 'Can I view the El Ranchero menu before visiting?',
    description:
      'Yes. Explore the Taqueria El Ranchero <a href="/menu" class="text-contrast underline underline-offset-4">menu</a> to see the types of dishes served, then visit DoorDash for current pricing and availability.',
  },
  {
    title: 'Does Taqueria El Ranchero offer catering in Kapolei?',
    description:
      'Yes. Taqueria El Ranchero offers catering for group occasions, including parties, workplace meals and celebrations. Visit our <a href="/catering" class="text-contrast underline underline-offset-4">Catering page</a> to learn more.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="Mexican Restaurant in Kapolei, HI"
    content='Looking for Mexican food in Kapolei? Visit Taqueria El Ranchero at Ka Makana Aliʻi for Ranchero-style tacos, burritos, Mexican breakfast favorites and more.<br /><br />Stop by for breakfast, lunch or dinner, explore our menu before your visit, or order online through DoorDash.'
    actions={[
      { variant: 'primary', text: 'View the Menu', href: '/menu' },
      { variant: 'ghost', text: 'Order on DoorDash', href: store.orderPickupHref, target: '_blank' },
    ]}
  />

  <StoreVisit store={store} id="visit" title="Visit Taqueria El Ranchero in Kapolei" />

  <TextSplit id="food" heading="Ranchero-Style Mexican Food in Kapolei" class="bg-card">
    <div class="flex flex-col gap-6">
      <Text color="default">
        When tacos, burritos or a full Mexican meal are calling, Taqueria El Ranchero brings Ranchero-style Mexican food to Kapolei.
      </Text>
      <Text color="default">
        Explore tacos with a variety of meat and filling options, burritos, quesadillas, birria, Mexican plates and other El Ranchero favorites. Whether you are stopping in for a quick meal or sitting down with family and friends, there is plenty to choose from throughout the day.
      </Text>
      <Text variant="small" color="muted">
        Menu selections and availability may vary. Visit our menu to explore El Ranchero favorites, then check DoorDash for current pricing and online ordering.
      </Text>
    </div>
  </TextSplit>

  <TextSplit id="why-visit" heading="Why Visit Taqueria El Ranchero Kapolei?">
    <div class="flex flex-col gap-6">
      <Text color="default">
        Taqueria El Ranchero has been serving Oʻahu since 2015, bringing the taqueria experience to Hawaiʻi with Mexican flavors, a wide-ranging menu and a casual place to gather over good food.
      </Text>
      <Text color="default">
        Our Kapolei location at Ka Makana Aliʻi makes it easy to stop in while shopping, meeting friends or spending the day in West Oʻahu. From tacos and burritos to breakfast and hearty Mexican plates, you can find something for an everyday meal, a quick bite or a group outing.
      </Text>
      <Text color="default">
        El Ranchero is also a veteran-founded local business with roots right here on Oʻahu.
      </Text>
    </div>
  </TextSplit>

  <MenuItemsSection
    id="favorites"
    tone="card"
    title="Kapolei Favorites"
    intro="Not sure where to start? Explore some of the favorites you may find on the Taqueria El Ranchero Kapolei menu."
    items={favorites}
    footnote="Menu items and availability may change. Visit our menu to explore more."
    ctaText="View the Menu"
    ctaHref="/menu"
  />

  <TextSplit id="breakfast" eyebrow="Mexican Breakfast in Kapolei" heading="Start Your Morning Ranchero Style">
    <div class="flex flex-col gap-6">
      <Text color="default">
        Start the day with Mexican breakfast favorites at Taqueria El Ranchero Kapolei.
      </Text>
      <Text color="default">
        Explore options such as breakfast burritos, chilaquiles, huevos rancheros, huevos con chorizo, breakfast tacos and other morning favorites.
      </Text>
      <Text color="default">
        Breakfast selections may vary. Check DoorDash for the current Kapolei menu, availability and pricing.
      </Text>
      <Button variant="primary" text="View Kapolei Menu on DoorDash" href={store.orderPickupHref} target="_blank" hideNote={true} class="self-start" />
    </div>
  </TextSplit>

  <TextSplit id="find-us" heading="Find Us at Ka Makana Aliʻi" class="bg-card">
    <div class="flex flex-col gap-6">
      <Text color="default">
        Taqueria El Ranchero is located at Ka Makana Aliʻi in Kapolei, serving customers throughout Kapolei and West Oʻahu.
      </Text>
      <Text color="default">
        Whether you are already visiting the shopping center or making El Ranchero your destination, you can find us at:
      </Text>
      <address class="not-italic font-sans text-body-lg font-semibold text-heading">
        {store.addressLine1}<br />{store.addressLine2}
      </address>
      <Button variant="primary" text="Get Directions" href={directionsHref} target="_blank" hideNote={true} class="self-start" />
    </div>
  </TextSplit>

  <TextSplit id="catering" heading="Mexican Catering in Kapolei">
    <div class="flex flex-col gap-6">
      <Text color="default">
        Feeding a group? Taqueria El Ranchero offers catering for parties, workplace meals, celebrations and other gatherings.
      </Text>
      <Text color="default">
        Bring El Ranchero favorites to your next event and make feeding a crowd a little easier.
      </Text>
      <Button variant="primary" text="Explore Catering" href={CATERING_CTA_HREF} hideNote={true} class="self-start" />
    </div>
  </TextSplit>

  <TextSplit id="events" heading="Events at El Ranchero Kapolei" class="bg-card">
    <div class="flex flex-col gap-6">
      <Text color="default">
        There is more happening at El Ranchero Kapolei than what is on the menu.
      </Text>
      <Text color="default">
        Follow {EVENTS_INSTAGRAM_HANDLE} on Instagram for current event announcements, entertainment and updates from the Kapolei location.
      </Text>
      <Button variant="primary" text={`Follow ${EVENTS_INSTAGRAM_HANDLE}`} href={EVENTS_INSTAGRAM_HREF} target="_blank" hideNote={true} class="self-start" />
    </div>
  </TextSplit>

  <FAQs isDark={true} title="Frequently Asked Questions" items={faqs} />

  <CTABanner
    title="Hungry Yet?"
    subtitle="Visit Taqueria El Ranchero in Kapolei or order your favorites online through DoorDash."
    actions={[{ variant: 'primary', text: 'Order Kapolei on DoorDash', href: store.orderPickupHref }]}
  />
</PageLayout>
