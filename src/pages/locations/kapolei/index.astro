---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import StoreVisit from '~/components/widgets/StoreVisit.astro';
import LocationDirectory from '~/components/widgets/LocationDirectory.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Text from '~/components/ui/Text.astro';
import { PRIMARY_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { findStore } from '~/data/locations';
import { getSanityLocationImages } from '~/lib/content/sanity';

const store = findStore('kapolei');
if (!store) throw new Error('Missing Kapolei store');
const locationImages = await getSanityLocationImages();

const metadata = {
  title: 'Kapolei Location | El Ranchero Oahu',
  description:
    'Visit El Ranchero at Kapolei Commons. We serve fresh salads, signature wraps, healthy soups, and local beverages for dine-in or pickup.',
  ignoreTitleTemplate: true,
};

const faqs = [
  {
    title: 'Is parking available at the Kapolei location?',
    description: 'Yes. Kapolei Commons provides ample free parking for our restaurant guests.',
  },
  {
    title: 'Can I dine in at El Ranchero Kapolei?',
    description: 'Yes. We offer a dedicated dining area for guests who prefer to eat their meals on site.',
  },
  {
    title: 'Can I pick up catering orders in Kapolei?',
    description: 'Yes. You can schedule large party trays and corporate catering orders for pickup at this location.',
  },
  {
    title: 'Can I collect a catering order from Kapolei?',
    description: 'Yes. Catering trays can be collected from this store. Call ahead to arrange it.',
  },
  {
    title: 'Do you deliver to the Kapolei area?',
    description:
      'We partner with third-party delivery services to bring our meals to local residents. Delivery availability depends on your exact address.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="El Ranchero Kapolei"
    content="Visit our West Oahu restaurant for a fresh meal at Kapolei Commons. We serve custom bowls and signature wraps for fast pickup or casual dine-in."
    image={locationImages.kapolei}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Order Catering', href: CATERING_CTA_HREF },
    ]}
  />

  <TextSplit heading="Your Kapolei Neighborhood Stop">
    <div class="flex flex-col gap-6">
      <Text variant="body-lg" color="default">
        Kapolei Commons serves West Oahu with hearty salads alongside refreshing Big Island mamaki mint tea. Whether
        you are catching a movie or running errands near Target, our menu features crisp greens, house-made dressings,
        and never-frozen local ahi. We proudly serve the growing Kapolei community with a welcoming space to enjoy
        wholesome food.
      </Text>
    </div>
  </TextSplit>

  <StoreVisit store={store} id="visit" title="Location Details" />

  <LocationDirectory
    title="More Oahu Locations"
    subtitle="Find us across the island. Explore our other neighborhood restaurants below:"
    excludeHref={store.href}
  />

  <FAQs isDark={true} title="Frequently Asked Questions" items={faqs} />

  <CTABanner
    title="Visit Us in Kapolei"
    subtitle="Stop by Kapolei Commons for a fresh meal or place your order online to skip the line."
    ctaText="View Full Menu"
    ctaHref="/menu"
    secondaryCtaText="Order Online"
    secondaryCtaHref={PRIMARY_CTA_HREF}
  />
</PageLayout>
