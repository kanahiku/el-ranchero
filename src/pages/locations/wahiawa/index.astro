---
/**
 * Wahiawa location — copy from pages-content/Locations/Location - Wahiawa.docx.
 * Composes shared widgets only. The storefront photo is a grey placeholder
 * until the client photography pass ("keep existing storefront image").
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import StoreVisit from '~/components/widgets/StoreVisit.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import { CATERING_CTA_HREF } from '~/config/cta';
import { findStore, storeDirectionsHref } from '~/data/locations';

const store = findStore('wahiawa');
if (!store) throw new Error('Missing Wahiawa store');
const directionsHref = storeDirectionsHref(store);

const metadata = {
  title: 'Mexican Restaurant in Wahiawa, HI | Taqueria El Ranchero',
  description:
    'Visit Taqueria El Ranchero in Wahiawa for tacos, burritos, Mexican breakfast and more. View the menu, get directions or order on DoorDash.',
  ignoreTitleTemplate: true,
};

const favorites = [
  {
    title: 'Tacos',
    description: 'Choose from available meat, seafood and vegetarian options for a taco order that fits what you are craving.',
  },
  {
    title: 'California Burrito',
    description: 'Go for something hearty with one of El Ranchero’s popular burrito options.',
  },
  {
    title: 'Birria',
    description: 'Look for savory birria among the Mexican dishes available on the current Wahiawa menu.',
  },
  {
    title: 'Quesadillas',
    description: 'Keep it simple or choose from available fillings and options to make it your own.',
  },
  {
    title: 'Mexican Plates',
    description: 'Sit down to a full meal with available Mexican plates and other El Ranchero favorites.',
  },
];

const faqs = [
  {
    title: 'Where is Taqueria El Ranchero in Wahiawa?',
    description:
      'Taqueria El Ranchero is located at 823 California Ave, Wahiawa, HI 96786.',
  },
  {
    title: 'What are Taqueria El Ranchero Wahiawa\'s hours?',
    description:
      'The Wahiawa location is open Monday through Sunday from 9:00 AM to 8:30 PM.',
  },
  {
    title: 'Can I order Taqueria El Ranchero Wahiawa online?',
    description:
      'Yes. Online ordering is available through DoorDash. Visit the Wahiawa DoorDash menu to see current selections, availability and pricing.',
  },
  {
    title: 'Does Taqueria El Ranchero Wahiawa serve breakfast?',
    description:
      'The Wahiawa menu includes Mexican breakfast favorites such as breakfast burritos, chilaquiles, huevos rancheros and breakfast tacos. Menu selections may vary, so check DoorDash for current availability.',
  },
  {
    title: 'Is Taqueria El Ranchero near Schofield Barracks?',
    description:
      'Taqueria El Ranchero is located in Wahiawa on California Avenue, a short drive from the Schofield Barracks area. Use our Google Maps directions to plan your visit.',
  },
  {
    title: 'Can I view the El Ranchero menu before visiting?',
    description:
      'Yes. Explore the Taqueria El Ranchero <a href="/menu" class="text-contrast underline underline-offset-4">menu</a> to see the types of dishes served, then check DoorDash for current availability and pricing.',
  },
  {
    title: 'Does Taqueria El Ranchero offer catering in Wahiawa?',
    description:
      'Yes. Taqueria El Ranchero offers catering for parties, workplace meals, celebrations and other group occasions. Visit our <a href="/catering" class="text-contrast underline underline-offset-4">Catering page</a> to learn more.',
  },
  {
    title: 'Does Taqueria El Ranchero have another Oʻahu location?',
    description:
      'Yes. Taqueria El Ranchero also has a location in Kapolei at Ka Makana Aliʻi. <a href="/locations/kapolei" class="text-contrast underline underline-offset-4">Visit our Kapolei location</a>.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="Mexican Restaurant in Wahiawa, HI"
    content='Craving Mexican food in Wahiawa? Visit Taqueria El Ranchero on California Avenue for Ranchero-style tacos, burritos, Mexican breakfast favorites and more.<br /><br />Stop by for a meal, explore our menu before your visit or order online through DoorDash.'
    actions={[
      { variant: 'primary', text: 'View the Menu', href: '/menu' },
      { variant: 'ghost', text: 'Order on DoorDash', href: store.orderPickupHref, target: '_blank' },
    ]}
  />

  <StoreVisit store={store} id="visit" title="Visit Taqueria El Ranchero in Wahiawa" />

  <TextSplit id="food" heading="Ranchero-Style Mexican Food in Wahiawa" class="bg-card">
    <div class="flex flex-col gap-6">
      <Text color="default">
        From tacos and burritos to quesadillas, Mexican plates and breakfast favorites, Taqueria El Ranchero brings a wide range of Mexican dishes to Wahiawa.
      </Text>
      <Text color="default">
        Choose from available meats and fillings, try one of the restaurant’s hearty favorites or stop in for a quick meal before continuing your day.
      </Text>
      <Text variant="small" color="muted">
        Menu selections and availability may vary. Explore our menu to see more of what El Ranchero serves, then visit DoorDash for current pricing and online ordering.
      </Text>
    </div>
  </TextSplit>

  <TextSplit id="why-visit" heading="Why Visit Taqueria El Ranchero Wahiawa?">
    <div class="flex flex-col gap-6">
      <Text color="default">
        Wahiawa is where the El Ranchero story began. Taqueria El Ranchero opened its first location here in 2015 and has been serving the Central Oʻahu community ever since.
      </Text>
      <Text color="default">
        Located on California Avenue, the restaurant is convenient for Wahiawa residents, families, visitors and customers coming from nearby areas such as Schofield Barracks and Mililani.
      </Text>
      <Text color="default">
        Whether you are stopping in for tacos, grabbing a burrito to go or starting the day with Mexican breakfast, the Wahiawa location offers plenty of ways to enjoy El Ranchero.
      </Text>
      <Text color="default">
        El Ranchero is also a veteran-founded local business with roots in the Wahiawa community.
      </Text>
    </div>
  </TextSplit>

  <MenuItemsSection
    id="favorites"
    tone="card"
    title="Wahiawa Favorites"
    intro="Not sure where to start? Explore some of the Mexican favorites you may find on the Taqueria El Ranchero Wahiawa menu."
    items={favorites}
    footnote="Menu items and availability may change. Visit our menu to explore more."
    ctaText="View the Menu"
    ctaHref="/menu"
  />

  <TextSplit id="breakfast" eyebrow="Mexican Breakfast in Wahiawa" heading="Start Your Morning Ranchero Style">
    <div class="flex flex-col gap-6">
      <Text color="default">
        Looking for Mexican breakfast in Wahiawa? Start your day at Taqueria El Ranchero with morning favorites that go beyond the usual breakfast stop.
      </Text>
      <Text color="default">
        Explore options such as breakfast burritos, chilaquiles, huevos rancheros, huevos con chorizo, breakfast tacos and other breakfast dishes.
      </Text>
      <Text color="default">
        Selections may vary. Check DoorDash for the current Wahiawa menu, availability and pricing.
      </Text>
      <Button variant="primary" text="View Wahiawa Menu on DoorDash" href={store.orderPickupHref} target="_blank" hideNote={true} class="self-start" />
    </div>
  </TextSplit>

  <TextSplit id="find-us" heading="Find Us on California Avenue" class="bg-card">
    <div class="flex flex-col gap-6">
      <Text color="default">
        Taqueria El Ranchero is located at 823 California Avenue in Wahiawa, serving customers throughout Wahiawa and Central Oʻahu.
      </Text>
      <Text color="default">
        Whether you live nearby, are visiting the area or are coming from Schofield Barracks or another nearby community, use the link below to get directions to the restaurant.
      </Text>
      <address class="not-italic font-sans text-body-lg font-semibold text-heading">
        {store.addressLine1}<br />{store.addressLine2}
      </address>
      <Button variant="primary" text="Get Directions" href={directionsHref} target="_blank" hideNote={true} class="self-start" />
    </div>
  </TextSplit>

  <TextSplit id="catering" heading="Mexican Catering in Wahiawa">
    <div class="flex flex-col gap-6">
      <Text color="default">
        Feeding a group? Taqueria El Ranchero offers catering for parties, workplace meals, celebrations and other gatherings.
      </Text>
      <Text color="default">
        Bring El Ranchero favorites to your next event and give your guests plenty to dig into.
      </Text>
      <Button variant="primary" text="Explore Catering" href={CATERING_CTA_HREF} hideNote={true} class="self-start" />
    </div>
  </TextSplit>

  <FAQs isDark={true} title="Frequently Asked Questions" items={faqs} />

  <CTABanner
    title="Hungry Yet?"
    subtitle="Stop by Taqueria El Ranchero in Wahiawa or order your favorites online through DoorDash."
    actions={[{ variant: 'primary', text: 'Order Wahiawa on DoorDash', href: store.orderPickupHref }]}
  />
</PageLayout>
