---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import LocationDirectory from '~/components/widgets/LocationDirectory.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { PRIMARY_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { getSanityLocationImages } from '~/lib/content/sanity';

const locationImages = await getSanityLocationImages();

const metadata = {
  title: 'El Ranchero Locations | Find Our 6 Oahu Restaurants',
  description:
    'Find an El Ranchero location near you. We operate six restaurants across Oahu offering fresh meals for dine-in or fast pickup.',
  ignoreTitleTemplate: true,
};

const heroTitle = 'El Ranchero Locations<br/>on Oahu';
const heroContent =
  "Find your nearest El Ranchero. We operate six neighborhood restaurants across Oahu. Every location offers online ordering for fast pickup and convenient dine-in seating.";

const faqs = [
  {
    title: 'Do all locations offer dine-in seating?',
    description:
      "Yes. All six of our Oahu restaurants feature dedicated dining areas for guests who prefer to eat in.",
  },
  {
    title: 'Is parking available at your restaurants?',
    description: 'Yes. Each of our mall and shopping center locations provides ample free parking for our guests.',
  },
  {
    title: 'Can I collect a catering order from the stores?',
    description: 'Yes. Catering trays can be collected from this store. Call ahead to arrange it.',
  },
  {
    title: 'Do you offer delivery from these locations?',
    description:
      'We partner with third-party delivery services to bring our meals directly to you. Delivery availability depends on your proximity to a specific restaurant.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline="Visit Now"
    title={heroTitle}
    content={heroContent}
    image={locationImages.directory}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Order Catering', href: CATERING_CTA_HREF },
    ]}
  />

  <LocationDirectory id="find-a-location" />

  <FAQs title="Frequently Asked Questions" items={faqs} isDark={true} />

  <CTABanner
    title="Visit Us Today"
    subtitle="Stop by your neighborhood restaurant for a fresh meal or place your order online for convenient pickup."
    ctaText="View Full Menu"
    ctaHref="/menu"
    secondaryCtaText="Order Online"
    secondaryCtaHref={PRIMARY_CTA_HREF}
  />
</PageLayout>
