---
/**
 * Locations hub — all copy, links and photos come from the Sanity "Locations hub"
 * singleton (`locationsContent`); defaults live in src/data/pages/locations.ts.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Locations from '~/components/widgets/Locations.astro';
import LocationsBlocks from '~/components/widgets/LocationsBlocks.astro';
import { getLocationsHubContent } from '~/lib/content';
import { paragraphsToHtml } from '~/lib/content/inlineLink';

const c = await getLocationsHubContent();
const metadata = { title: c.seoTitle, description: c.seoDescription, ignoreTitleTemplate: true };
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    image={c.heroImage}
    title={c.heroTitle}
    content={paragraphsToHtml(c.heroParagraphs)}
  />

  <Locations
    id="find-a-location"
    variant="detailed"
    eyebrow=""
    title=""
    subtitle=""
    ctaText=""
    locations={c.cards.map((card) => ({
      name: card.name,
      image: card.image,
      tagline: card.tagline,
      heading: card.heading,
      shopName: card.shopName,
      addressLine1: card.addressLine1,
      addressLine2: card.addressLine2,
      description: card.paragraphs,
      hours: card.hours,
      actions: card.actions.map((action) => ({ text: action.text, href: action.href, variant: action.variant ?? 'primary' })),
    }))}
  />

  <LocationsBlocks blocks={c.blocks} />
</PageLayout>
