---
/**
 * Contact — copy from the Drive doc "/contact - Contact".
 * The message form stays on this page. Location details come from the store list.
 */
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Contact from '~/components/widgets/Contact.astro';
import Heading from '~/components/ui/Heading.astro';
import Button from '~/components/ui/Button.astro';
import Text from '~/components/ui/Text.astro';
import { findStore, storeDirectionsHref } from '~/data/locations';
import { getContactPageContent } from '~/lib/content';
import { richToHtmlString } from '~/lib/content/richText';
import { contactHelpOptions } from '~/data/pages/contact';

const wahiawa = findStore('wahiawa');
const kapolei = findStore('kapolei');
if (!wahiawa || !kapolei) throw new Error('Missing store data');

const linkClass = 'text-accent underline underline-offset-4 transition-opacity hover:opacity-80';
const labelClass = 'font-semibold text-heading';
const actionClass = 'whitespace-nowrap !px-4 !py-3 sm:!px-5';

const c = await getContactPageContent();
const metadata = { title: c.seoTitle, description: c.seoDescription, ignoreTitleTemplate: true };

// Phone numbers and links come from the store list; the words come from Sanity.
const stores = c.locations.map((copy) => ({ copy, store: copy.name.toLowerCase() === 'kapolei' ? kapolei : wahiawa }));
---

<Layout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    hideImage
    title={c.heroTitle}
    content={c.heroIntro}
  />

  <Contact
    id="contact-form"
    title={c.formTitle}
    subtitle={richToHtmlString(c.formIntro)}
    button={c.formButton}
    inputs={[
      { type: 'text', name: 'name', label: 'Name', autocomplete: 'name', placeholder: 'Your name', required: true },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        autocomplete: 'email',
        placeholder: 'you@email.com',
        required: true,
      },
      { type: 'tel', name: 'phone', label: 'Phone', autocomplete: 'tel', placeholder: 'Your phone' },
      {
        type: 'select',
        name: 'topic',
        label: 'How can we help?',
        placeholder: 'Select a topic',
        required: true,
        options: contactHelpOptions,
      },
    ]}
    textarea={{ label: 'Message', name: 'message', placeholder: 'How can we help?' }}
  >
    <div slot="aside" class="flex flex-col gap-8">
      <Heading variant="h2">{c.asideHeading}</Heading>
      {
        stores.map(({ store, copy }) => (
          <div class="flex flex-col gap-5 border-t border-heading/15 pt-6">
            <Text color="default" class="font-heading text-[22px] text-heading">
              {copy.name}
            </Text>
            <Text color="default">{copy.intro}</Text>
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 font-sans text-body text-default">
              <dt class={labelClass}>Address</dt>
              <dd>{copy.address}</dd>
              <dt class={labelClass}>Phone</dt>
              <dd>
                <a class={linkClass} href={store.phoneHref}>
                  {store.phoneDisplay}
                </a>
              </dd>
              <dt class={labelClass}>Kitchen Hours</dt>
              <dd>{copy.kitchenHours}</dd>
              <dt class={labelClass}>Bar Hours</dt>
              <dd>{copy.barHours}</dd>
            </dl>
            <div class="flex flex-row flex-wrap gap-2 sm:gap-3">
              <Button
                variant="primary"
                text="Get Directions"
                aria-label={copy.directionsLabel}
                href={storeDirectionsHref(store)}
                target="_blank"
                hideNote={true}
                class={actionClass}
              />
              <Button
                variant="ghost"
                tone="light"
                text="View Location"
                aria-label={copy.visitLabel}
                href={store.href}
                hideNote={true}
                class={actionClass}
              />
            </div>
          </div>
        ))
      }
    </div>
  </Contact>
</Layout>
