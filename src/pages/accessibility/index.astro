---
/**
 * Accessibility Statement — copy from the Drive doc "/accessibility - Accessibility Statement".
 */
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { findStore } from '~/data/locations';

const wahiawa = findStore('wahiawa');
const kapolei = findStore('kapolei');
if (!wahiawa || !kapolei) throw new Error('Missing store data');

const metadata = {
  title: 'Accessibility Statement | Taqueria El Ranchero',
  description:
    'Learn how to report an accessibility issue on the Taqueria El Ranchero website and contact our Wahiawa or Kapolei restaurants.',
  ignoreTitleTemplate: true,
};

const headingClass =
  'text-[22px] md:text-[26px] font-normal leading-[130%] tracking-tight font-heading text-heading mb-4';
const bodyClass = 'text-[16px] font-normal leading-[160%] text-muted';
const linkClass = 'text-accent underline underline-offset-4 transition-opacity hover:opacity-80';
---

<Layout metadata={metadata}>
  <Hero2>
    <Fragment slot="title">Accessibility Statement</Fragment>
    <Fragment slot="subtitle">
      At Taqueria El Ranchero, we want visitors to be able to find the information they need about our restaurants and
      use our website's main features.
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <WidgetWrapper containerClass="max-w-container mx-auto">
    <div class="max-w-3xl space-y-10 md:space-y-14">
      <section>
        <h2 class={headingClass}>Report an Accessibility Issue</h2>
        <div class={`${bodyClass} space-y-5`}>
          <p>
            If you have difficulty accessing a page, reading information or using a website feature, please let us know
            through our <a class={linkClass} href="/contact">Contact page</a>. Sharing the page address and a brief
            description of what happened can help us understand the issue.
          </p>
          <p>
            You may also call either restaurant if you need help with information that is difficult to access online.
          </p>
        </div>
      </section>

      <section>
        <h2 class={headingClass}>Contact Our Locations</h2>
        <div class={`${bodyClass} space-y-5`}>
          <p>
            Wahiawa: <a class={linkClass} href={wahiawa.phoneHref}>{wahiawa.phoneDisplay}</a><br />
            Kapolei: <a class={linkClass} href={kapolei.phoneHref}>{kapolei.phoneDisplay}</a>
          </p>
          <p>Both restaurants also accept orders by phone.</p>
        </div>
      </section>

      <section>
        <h2 class={headingClass}>Third-Party Websites</h2>
        <p class={bodyClass}>
          Some links on our website lead to third-party services, including DoorDash for online ordering. Accessibility
          features and limitations on those services are managed by their respective providers.
        </p>
      </section>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <CTABanner
    title="Report an Accessibility Issue"
    subtitle="If a page or feature is difficult to use, contact us and include the page address and a short description of what happened."
    actions={[{ variant: 'primary', text: 'Contact Us', href: '/contact' }]}
  />
</Layout>
