---
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Motif from '~/components/ui/Motif.astro';
import { getHomePermalink } from '~/utils/permalinks';

Astro.response.status = 404;

const title = `Page not found`;
---

<Layout metadata={{ title }}>
  <section class="relative w-full overflow-x-clip bg-page">
    <Motif name="papel-picado" class="h-[56px] w-full md:h-[76px]" />
    <div class="container-x flex flex-col items-center gap-6 py-16 text-center md:py-[120px]">
      <Heading variant="eyebrow" class="inline-block rotate-3">¡Ay, caramba!</Heading>
      <h1 class="font-rough text-[120px] leading-[0.9] text-accent md:text-[200px]">
        <span class="sr-only">Error </span>404
      </h1>
      <Heading variant="h2">We couldn’t find this page</Heading>
      <Text variant="body-lg" class="max-w-[520px] text-tan-body">
        The page may have moved. Head back to the homepage or take a look at the menu.
      </Text>
      <div class="flex flex-wrap justify-center gap-4 pt-2">
        <Button variant="primary" text="Back to homepage" href={getHomePermalink()} hideNote={true} />
        <Button variant="ghost" tone="light" text="View the menu" href="/menu" hideNote={true} />
      </div>
    </div>
  </section>
</Layout>
