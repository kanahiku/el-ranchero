---
/**
 * Reviews — all copy, links and the hero photo come from the Sanity "Reviews page"
 * singleton (`reviewsContent`); defaults live in src/data/pages/reviews.ts.
 * The review cards are the Sanity "Testimonials" documents.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { getReviewsContent } from '~/lib/content';
import { paragraphsToHtml } from '~/lib/content/inlineLink';

const c = await getReviewsContent();
const metadata = { title: c.seoTitle, description: c.seoDescription, ignoreTitleTemplate: true };
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    image={c.heroImage}
    title={c.heroTitle}
    content={paragraphsToHtml(c.heroParagraphs)}
    actions={c.heroButtons.map((button) => ({
      variant: button.variant ?? 'primary',
      text: button.text,
      href: button.href,
      target: isExternal(button.href) ? '_blank' : undefined,
    }))}
  />

  <Testimonials
    id="reviews"
    layout="grid"
    eyebrow={c.reviewsEyebrow}
    heading={c.reviewsHeading}
    subtitle={c.reviewsIntro}
    footnote={c.reviewsFootnote || undefined}
    actions={c.reviewsButtons}
  />

  <CTABanner
    title={c.ctaTitle}
    subtitle={c.ctaSubtitle}
    actions={[{ variant: 'primary', text: c.ctaButton.text, href: c.ctaButton.href }]}
  />
</PageLayout>
