---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { PRIMARY_CTA_HREF } from '~/config/cta';
import { getSanityIngredientsImages } from '~/lib/content/sanity';

const ingredientsImages = await getSanityIngredientsImages();

const metadata = {
  title: 'Local Ingredients & Sourcing | El Ranchero Oahu',
  description:
    'Discover how El Ranchero sources fresh ingredients, including vine-ripe Hauula tomatoes, vessel-tracked wild ahi, and Big Island mamaki tea.',
  ignoreTitleTemplate: true,
};
---

<PageLayout metadata={metadata}>
  {/* ── Page hero ─────────────────────────────────────────── */}
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline="We Support Local"
    title="Our Ingredients: Freshly Sourced on Oahu"
    content="We are dedicated to supporting local farmers and fishermen while providing our customers with the freshest and healthiest ingredients available. Every dish is built with quality produce and seafood delivered directly to our kitchens across Oahu."
    image={ingredientsImages.hero}
    actions={[
      { variant: 'primary', text: 'View Menu', href: '/menu' },
      { variant: 'ghost-dark', text: 'Find a Location', href: '/locations' },
    ]}
  />

  {/* ── Ingredient sourcing facts ─────────────────────────── */}
  <LocalSourcing
    eyebrow="What we source"
    title="Freshly sourced on Oahu, every day."
    subtitle="We have partnered with local farms and fishermen since 2006 — here is exactly what that means for every bowl we make."
    ctaText="View Full Menu"
    ctaHref="/menu"
    factsLayout="featured"
    image={ingredientsImages.freshLocalProduce}
    facts={[
      {
        title: 'Fresh Local Produce',
        description:
          '<p><strong>Hauula Tomatoes:</strong> We maintain a standing weekly order for vine-ripe tomatoes grown in Hauula.</p><p><strong>Oahu Farms:</strong> We receive Japanese cucumbers and a second tomato variety from another Oahu farm, alongside regular produce deliveries featuring items like green onions, sweet basil, bean sprouts, and green bell peppers.</p>',
      },
      {
        title: 'Vessel-Tracked Wild Ahi',
        description:
          'We exclusively feature never-frozen local ahi for our seafood salads. Delivered twice a week to our busier stores by a Honolulu seafood supplier, every delivery carries a lot number, origin as USA wild, and the name of the specific catch vessel that landed it.',
      },
      {
        title: 'Big Island Mamaki Mint Tea',
        description:
          'We brew our mamaki mint tea fresh in-store daily. The tea is sourced from a company in Hilo on the Big Island, made with Hawaiian mamaki and locally grown ingredients.',
      },
      {
        title: 'Quality Dressings and Foundations',
        description:
          'All of our signature salad dressings are crafted from scratch daily in our kitchens using quality ingredients.',
      },
    ]}
  />

  {/* ── Closing CTA ───────────────────────────────────────── */}
  <CTABanner
    title="Ready to Taste the Difference?"
    subtitle="Order your favorite salad or bowl online for fast pickup at any of our six Oahu locations."
    ctaText="Order Online"
    ctaHref={PRIMARY_CTA_HREF}
  />

  {/* ── FAQs ──────────────────────────────────────────────── */}
  <FAQs
    isDark={true}
    title="Frequently Asked Questions"
    items={[
      {
        title: 'Can I view the full menu before ordering?',
        description:
          'Yes. You can explore our complete selection of salads, wraps, subs, and soups on our main menu page.',
      },
      {
        title: 'Where can I pick up an online order?',
        description:
          'You can order ahead for fast pickup at any of our six neighborhood restaurants across Oahu, located in Kailua, Kahala, Kaneohe, Kapolei, Mililani, and Pearlridge.',
      },
      {
        title: 'Do you offer catering services?',
        description: 'Yes. We offer a variety of priced catering trays and sandwich platters for group gatherings.',
      },
      {
        title: 'Are your dressings made from scratch?',
        description: 'Yes. All of our signature salad dressings are crafted daily in our kitchens.',
      },
    ]}
  />
</PageLayout>
