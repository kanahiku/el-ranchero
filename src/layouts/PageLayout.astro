---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { getNavigationContent } from '~/lib/content';

import type { MetaData } from '~/types';
import type { JsonLdNode } from '~/config/schema/types';

export interface Props {
  metadata?: MetaData;
  jsonLd?: JsonLdNode[];
}

const { metadata, jsonLd } = Astro.props;
const navigation = await getNavigationContent();
const footer = navigation.footer;
---

<Layout metadata={metadata} jsonLd={jsonLd}>
  <slot name="header">
    <Header
      links={navigation.header.links}
      actions={navigation.header.actions}
      phone={navigation.header.phone}
      socialLinks={footer.socialLinks}
      isSticky
    />
  </slot>
  <div>
    <main>
      <slot />
    </main>
    <slot name="footer">
      <Footer
        links={footer.links}
        secondaryLinks={footer.secondaryLinks}
        socialLinks={footer.socialLinks}
        footNote={footer.footNote}
      />
    </slot>
  </div>
</Layout>
