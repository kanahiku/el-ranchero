---
/**
 * Site footer — Homepage 59:577 (stamp + columns) and 66:833 (wordmark).
 * Same widget on every page. Do NOT fork a HomeFooter.
 *
 */
import { Icon } from 'astro-icon/components';
import Motif from '~/components/ui/Motif.astro';
import Logo from '~/components/Logo.astro';
import { CONTACT } from '~/config/contact';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks?: Array<Link>;
  socialLinks?: Array<Link>;
  footNote?: string;
  theme?: string;
  tagline?: string;
}

const {
  links = [],
  secondaryLinks = [],
  socialLinks = [],
  footNote = '',
  tagline = 'Hawaii’s original taqueria — Wahiawā & Kapolei, since 2015.',
} = Astro.props;
---

<footer class="relative not-prose w-full overflow-hidden bg-heading text-contrast">
  <Motif name="scallop-edge" class="absolute inset-x-0 -top-3 z-10 h-6" />

  <div class="container-x flex flex-col gap-10 pt-16 md:gap-14 md:pt-[120px]">
    <div class="flex flex-col gap-12 md:flex-row md:gap-16">
      <div class="flex flex-col items-start gap-4 md:w-[360px] md:shrink-0">
        <a href={getHomePermalink()} aria-label={CONTACT.businessName}>
          <Logo class="h-[92px] w-auto" />
        </a>
        {tagline && <p class="text-[15px] leading-[1.55] text-sand">{tagline}</p>}
      </div>

      <nav class="grid flex-1 grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-3" aria-label="Footer">
        {
          links.map(({ title, links: items }) => (
            <div class="flex min-w-0 flex-col items-start gap-2.5">
              {title && <p class="font-button text-[14px] uppercase tracking-[0.08em] text-marigold">{title}</p>}
              {items && items.length > 0 && (
                <ul class="flex flex-col items-start gap-2.5">
                  {items.map(({ text, href, ariaLabel }) => (
                    <li>
                      <a class="text-[15px] text-contrast hover:text-marigold" href={href} aria-label={ariaLabel}>
                        <Fragment set:html={text} />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </nav>
    </div>

    <div class="flex flex-col gap-4 border-t border-contrast/15 pt-5 text-[13px] text-taupe md:flex-row md:items-start md:justify-between">
      {footNote && <p set:html={footNote} />}
      {
        (secondaryLinks.length > 0 || socialLinks.length > 0) && (
          <ul class="flex flex-wrap items-center gap-x-4 gap-y-2">
            {secondaryLinks.map(({ text, href }) => (
              <li>
                <a class="hover:text-marigold" href={href}>
                  {text}
                </a>
              </li>
            ))}
            {socialLinks.map(({ href, ariaLabel, icon }) => (
              <li>
                <a
                  href={href}
                  aria-label={ariaLabel}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex size-6 items-center justify-center hover:text-marigold"
                >
                  {icon ? <Icon name={icon} class="size-5" /> : ariaLabel}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <p
      class="select-none whitespace-nowrap text-center font-rough text-[17vw] leading-[0.8] text-accent xl:text-[232px]"
      aria-hidden="true"
    >
      EL RANCHERO
    </p>
  </div>
</footer>
