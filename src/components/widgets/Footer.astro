---
/**
 * Site footer — Homepage 59:577 (stamp + columns) and 66:833 (wordmark).
 * Same widget on every page. Do NOT fork a HomeFooter.
 *
 */
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import Motif from '~/components/ui/Motif.astro';
import { CONTACT } from '~/config/contact';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks?: Array<Link>;
  socialLinks?: Array<Link>;
  footNote?: string;
  theme?: string;
  tagline?: string;
}

const {
  links = [],
  secondaryLinks = [],
  socialLinks = [],
  footNote = '',
} = Astro.props;
---

<footer class="relative not-prose w-full border-t border-secondary/30 bg-page">
  <div
    class="mx-auto flex w-full max-w-container flex-col px-5 pt-16 sm:px-8 md:px-16"
  >
    <div class="flex w-full flex-col items-start justify-between gap-12 md:flex-row md:items-start">
      <a href={getHomePermalink()} class="shrink-0" aria-label={CONTACT.businessName}>
        <Logo class="h-14 w-auto" />
      </a>

      <nav class="grid w-full grid-cols-2 gap-x-8 gap-y-10 sm:gap-x-16 md:w-[771px] md:max-w-[calc(100%-200px)] md:grid-cols-[208.5px_208.5px_1fr] md:gap-x-0" aria-label="Footer">
        {
          links.map(({ title, links: items }) => (
            <div class="flex min-w-0 flex-col items-start gap-4">
              {title && <p class="type-label text-accent">{title}</p>}
              {items && items.length > 0 && (
                <ul class="flex flex-col items-start gap-2">
                  {items.map(({ text, href, ariaLabel }) => (
                    <li>
                      <a
                        class="text-small text-heading hover:text-accent"
                        href={href}
                        aria-label={ariaLabel}
                      >
                        <Fragment set:html={text} />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </nav>
    </div>
  </div>

  {(socialLinks.length > 0 || secondaryLinks.length > 0 || footNote) && (
    <div class="mx-auto grid w-full max-w-container grid-cols-1 items-center gap-4 px-5 py-10 sm:px-8 md:grid-cols-[1fr_auto_1fr] md:px-16">
      {/* Left — social icons, glyphs flush with the content edge */}
      <div class="flex items-center">
        {socialLinks.length > 0 && (
          <ul class="-ml-2.5 flex items-center gap-1">
            {socialLinks.map(({ href, ariaLabel, icon }) => (
              <li>
                <a
                  href={href}
                  aria-label={ariaLabel}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex size-10 items-center justify-center text-heading hover:text-accent"
                >
                  {icon ? <Icon name={icon} class="size-5" /> : ariaLabel}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      {/* Centre — copyright sits in an auto column so it is the true midpoint */}
      {footNote && (
        <p class="text-small leading-none text-muted md:whitespace-nowrap" set:html={footNote} />
      )}

      {/* Right — legal links, text flush with the content edge */}
      {secondaryLinks.length > 0 && (
        <nav aria-label="Legal" class="md:justify-self-end">
          <ul class="flex flex-wrap items-center gap-x-4">
            {secondaryLinks.map(({ text, href }) => (
              <li>
                <a
                  class="inline-flex h-10 items-center text-small leading-none text-heading hover:text-accent"
                  href={href}
                >
                  {text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  )}

  {/* Wordmark + hat motifs (Figma 2083:1814 / 1815): 864px wordmark, hat perched on the final O */}
  <div class="mx-auto w-full max-w-container overflow-hidden px-5 pt-10 sm:px-8 md:px-16 md:pt-[91px]">
    <div class="relative mx-auto w-full max-w-[864px]">
      <img
        src="/motifs/el-ranchero-word.png"
        alt={CONTACT.businessName}
        width="864"
        height="141"
        loading="lazy"
        decoding="async"
        class="block h-auto w-full"
      />
      <Motif name="hat" width={129} height={54} mobile style="left: 87.3%; top: -32px; width: 14.9%;" />
    </div>
  </div>
</footer>
