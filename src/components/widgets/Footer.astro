---
/**
 * Site footer — Variant 3 poster footer (Figma 2025:762) with the checker
 * strip above it (2032:1196). Same widget on every page.
 */
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import { CONTACT } from '~/config/contact';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks?: Array<Link>;
  socialLinks?: Array<Link>;
  footNote?: string;
  theme?: string;
  tagline?: string;
}

const {
  links = [],
  secondaryLinks = [],
  socialLinks = [],
  footNote = '',
  tagline = 'Hawaiʻi’s original taqueria — Wahiawa & Kapolei, since 2015.',
} = Astro.props;
---

<div class="v3-checker" aria-hidden="true"></div>
<footer class="v3-footer not-prose">
  <div class="v3-footer-inner">
    <div class="v3-footer-grid">
      <div class="v3-footer-brand">
        <a href={getHomePermalink()} aria-label={`${CONTACT.businessName} home`}>
          <Logo variant="poster" class="h-16 md:h-[92px]" />
        </a>
        {tagline && <p>{tagline}</p>}
        {
          socialLinks.length > 0 && (
            <ul class="v3-social" aria-label="Social media">
              {socialLinks.map(({ href, ariaLabel, icon }) => (
                <li>
                  <a href={href} aria-label={ariaLabel} target="_blank" rel="noopener noreferrer">
                    {icon ? <Icon name={icon} class="size-5" /> : ariaLabel}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      {
        links.map(({ title, links: items }) => (
          <nav aria-label={title || 'Footer'}>
            {title && <h2 class="capitalize">{title}</h2>}
            {items && items.length > 0 && (
              <ul>
                {items.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a href={href} aria-label={ariaLabel}>
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </nav>
        ))
      }
    </div>

    {
      (footNote || secondaryLinks.length > 0) && (
        <div class="v3-legal">
          {footNote && <p set:html={footNote} />}
          {secondaryLinks.length > 0 && (
            <nav aria-label="Legal">
              <ul class="v3-legal-links">
                {secondaryLinks.map(({ text, href }) => (
                  <li>
                    <a href={href}>{text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
        </div>
      )
    }

    <p class="v3-wordmark" aria-hidden="true">El Ranchero</p>
  </div>
</footer>
