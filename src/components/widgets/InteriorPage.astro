---
/**
 * Interior page shell used until each route is designed from Figma.
 * Compose Hero2 + optional sections. Do not fork this per page.
 */
import Hero2 from '~/components/widgets/Hero2.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import type { InteriorPageContent } from '~/data/pages/interior';

export interface Props {
  page: InteriorPageContent;
}

const { page } = Astro.props;
const sections = page.sections ?? [];
const hasBody = sections.length > 0;
---

<Hero2 variant="page" overlapHeader={false} stacked title={page.heading} subtitle={page.lede} />

{
  hasBody && (
    <WidgetWrapper containerClass="max-w-container mx-auto">
      <div class="flex max-w-3xl flex-col gap-12 md:gap-16">
        {sections.map((section) => (
          <section class="flex flex-col items-start gap-6">
            {section.heading && <Heading variant="h2">{section.heading}</Heading>}
            {section.body && <Text variant="body-lg">{section.body}</Text>}
            {section.items && section.items.length > 0 && (
              <ul class="flex w-full flex-col gap-3">
                {section.items.map((item) => (
                  <li class="flex flex-col gap-1 border-b border-heading/10 pb-3 last:border-b-0 last:pb-0">
                    <Heading variant="h4" as="p">
                      {item.title}
                    </Heading>
                    {item.description && <Text>{item.description}</Text>}
                  </li>
                ))}
              </ul>
            )}
            {section.links && section.links.length > 0 && (
              <ul class="flex flex-col items-start gap-3">
                {section.links.map((link) => (
                  <li>
                    <Button
                      variant="ghost"
                      tone="light"
                      text={link.text}
                      href={link.href}
                      hideNote
                      class="self-start"
                    />
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
    </WidgetWrapper>
  )
}
