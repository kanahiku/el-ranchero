---
/**
 * TopBar — Figma "Top Bar" 2083:1855. Ink strip above the nav:
 * Rye locations (left), hours (center), Kaushan greeting (right).
 * Desktop only; copy lives in `src/config/topbar.ts`.
 */
import { TOP_BAR } from '~/config/topbar';
---

<div class="hidden w-full bg-ink text-contrast md:block">
  <div class="container-x flex items-center justify-between gap-6 py-2.5">
    <p class="shrink-0 whitespace-pre font-button text-[12px] uppercase leading-normal tracking-[0.08em] text-marigold">
      {TOP_BAR.left}
    </p>
    <p class="hidden whitespace-pre text-[13px] font-medium leading-normal lg:block">{TOP_BAR.center}</p>
    <p class="shrink-0 whitespace-nowrap font-script text-[16px] leading-normal text-marigold">{TOP_BAR.right}</p>
  </div>
</div>
