---
/**
 * ScheduleSection — weekly schedule section (Figma node 2:431).
 *
 * Visual spec:
 *   bg-page, p-[120px], gap-[64px] flex-col items-center.
 *   Header (2-col, gap-[120px]): eyebrow + h2 (left) | body text (right).
 *   Card grid: flex gap-[16px], 7 equal-width columns (one per day).
 *
 * Each day card (Card variant="schedule"):
 *   Header band: bg-card-light, calendar icon, day label (text-secondary, uppercase).
 *   Event rows in the default slot:
 *     Each event: time row (icon + time, opacity-40) + event name below.
 *     icon: 'morning' = sun SVG, 'evening' = moon/cloud SVG (both 13×13, text-primary).
 *
 * Data structure:
 *   days: ScheduleDay[] — { day: string, events: ScheduleEvent[] }
 *   ScheduleEvent — { icon: 'morning' | 'evening', time: string, name: string }
 *
 * Usage:
 *   <ScheduleSection
 *     eyebrow="Why it has to be together"
 *     heading="Information is not an adherence mechanism."
 *     body="Knowing what to do has never once made anyone do it. ..."
 *     days={[
 *       { day: 'Monday', events: [
 *           { icon: 'morning', time: '6:30AM', name: 'Sunrise trail walk at Lanikai Pillbox' },
 *           { icon: 'evening', time: '5:30PM', name: 'Strength circle · all levels' },
 *         ]},
 *       ...
 *     ]}
 *   />
 */

import Card from '~/components/ui/Card.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';

export interface ScheduleEvent {
  /** 'morning' = sun icon, 'evening' = moon/cloud icon. */
  icon: 'morning' | 'evening';
  /** Display time string, e.g. "6:30AM". */
  time: string;
  /** Event name / description. */
  name: string;
}

export interface ScheduleDay {
  /** Day of week label shown in the card header (e.g. "Monday"). */
  day: string;
  events: ScheduleEvent[];
}

export interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  days: ScheduleDay[];
  id?: string;
}

const { eyebrow, heading, body, days = [], id } = Astro.props;

// ── Inline icon SVGs (13×13) — Figma assets, uses currentColor ──
const sunSvg = `<svg viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-[13px] shrink-0"><circle cx="6.5" cy="6.5" r="2.825" fill="currentColor"/><path d="M6.5 2.678a.61.61 0 01-.61-.61V.739a.61.61 0 111.22 0v1.329a.61.61 0 01-.61.61ZM6.5 12.87a.61.61 0 01-.61-.61v-1.329a.61.61 0 111.22 0v1.329a.61.61 0 01-.61.61ZM9.633 3.976a.609.609 0 01-.431-1.04l.94-.94a.61.61 0 11.862.862l-.94.94a.606.606 0 01-.431.178ZM2.426 11.183a.609.609 0 01-.43-1.04l.939-.94a.61.61 0 11.862.862l-.94.94a.607.607 0 01-.431.178ZM12.261 7.109h-1.33a.61.61 0 110-1.22h1.33a.61.61 0 110 1.22ZM2.069 7.109H.739a.61.61 0 110-1.22h1.33a.61.61 0 110 1.22ZM10.574 11.183a.607.607 0 01-.431-.178l-.94-.94a.61.61 0 11.862-.862l.94.94a.609.609 0 01-.431 1.04ZM3.366 3.976a.607.607 0 01-.431-.178l-.94-.94A.61.61 0 113.857 2l.94.94a.609.609 0 01-.431 1.04Z" fill="currentColor"/></svg>`;

// Cloud + moon paths (from Figma sleep icon, scaled to 13×13 display size)
const moonSvg = `<svg viewBox="0 0 20 17.5" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-[13px] shrink-0"><path d="M13.281 17.501H4.141C2.988 17.501 1.995 17.196 1.268 16.617C0.439 15.956 0 14.976 0 13.783c0-1.15.472-2.119 1.367-2.802.473-.362 1.063-.632 1.693-.783a.57.57 0 00.357-.193.576.576 0 00.129-.305C3.8 8.449 4.39 7.358 5.253 6.527 6.276 5.543 7.642 4.996 9.062 5.002c1.263 0 2.428.416 3.369 1.203.627.528 1.129 1.189 1.471 1.934a.57.57 0 00.334.327c.937.204 1.774.617 2.407 1.194.904.825 1.382 1.95 1.382 3.254 0 1.283-.513 2.456-1.445 3.301C16.681 17.054 15.474 17.501 14.177 17.501H13.281ZM19.942 6.946a.62.62 0 00-.047-.946.618.618 0 00-.77.007c-.418.181-.956.28-1.559.284-2.16.015-3.96-1.758-3.96-3.919 0-.615.097-1.166.28-1.592a.619.619 0 00-.126-.67A.618.618 0 0013.068.052C11.559.708 10.483 2.064 10.128 3.666a.116.116 0 00.112.188c1.098.193 2.126.673 2.98 1.39.625.524 1.15 1.157 1.549 1.868.081.144.214.251.372.299.933.28 1.761.738 2.431 1.349.116.106.226.215.331.329.053.055.13.069.187.03.802-.532 1.435-1.283 1.824-2.162Z" fill="currentColor"/></svg>`;
---

<section {...id ? { id } : {}} class="not-prose w-full py-12 md:py-16 lg:py-[120px]">
<div class="mx-auto w-full max-w-container px-5 sm:px-8 md:px-16 lg:px-[120px]">

  {/* ── Header: eyebrow + heading (left) | body (right) ── */}
  <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:gap-[120px]">

    <div class="flex min-w-0 flex-1 flex-col gap-4">
      {eyebrow && (
        <Heading variant="eyebrow">{eyebrow}</Heading>
      )}
      <Heading variant="h2">{heading}</Heading>
    </div>

    {body && (
      <Text class="min-w-0 flex-1">{body}</Text>
    )}

  </div>

  {/* ── Day cards grid ── */}
  {days.length > 0 && (
    <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 md:mt-16 md:grid-cols-4 lg:grid-cols-7">
      {days.map((dayItem) => (
        <Card variant="schedule" label={dayItem.day}>
          {dayItem.events.map((event) => (
            <div class="flex w-full flex-col gap-1.5 px-4">
              {/* Time row — muted / dimmed */}
              <div class="flex items-center gap-2 opacity-40">
                <span
                  class="text-primary"
                  set:html={event.icon === 'morning' ? sunSvg : moonSvg}
                />
                <span class="font-sans text-[12px] uppercase tracking-[0.06em] text-primary">
                  {event.time}
                </span>
              </div>
              {/* Event name */}
              <p class="font-sans text-[12px] leading-[1.3] text-primary">
                {event.name}
              </p>
            </div>
          ))}
        </Card>
      ))}
    </div>
  )}

</div>
</section>
