---
/**
 * SessionCards — 2-col grid of Card variant="feature" session layout
 * (Figma node 64:1201, Guidebooks calendar).
 *
 * Visual spec:
 *   bg-page, px 120, py 64, gap 32.
 *   Optional eyebrow above a wrapping 2-column grid.
 *   Each card: calendar header, 28px title, speaker row, 12px body, ghost CTA.
 *
 * Content is passed from the page file — never baked in.
 */
import Card from '~/components/ui/Card.astro';
import Heading from '~/components/ui/Heading.astro';

export interface SessionCardItem {
  label: string;
  title: string;
  speaker?: string;
  description: string;
  ctaText?: string;
  ctaHref?: string;
}

export interface Props {
  eyebrow?: string;
  cards: SessionCardItem[];
  id?: string;
}

const { eyebrow, cards = [], id } = Astro.props;
---

<section {...id ? { id } : {}} class="not-prose w-full py-12 md:py-16">
  <div class="mx-auto flex w-full max-w-container flex-col gap-8 px-5 sm:px-8 md:px-16 lg:px-[120px]">
    {eyebrow && (
      <Heading variant="eyebrow" color="inherit" class="text-accent">
        {eyebrow}
      </Heading>
    )}
    <div class="grid grid-cols-1 items-stretch gap-8 md:grid-cols-2">
      {cards.map((card) => (
        <Card
          variant="feature"
          iconType="calendar"
          label={card.label}
          title={card.title}
          speaker={card.speaker}
          description={card.description}
          ctaText={card.ctaText}
          ctaHref={card.ctaHref}
          class="h-full"
        />
      ))}
    </div>
  </div>
</section>
