---
/**
 * TextSplit — reusable 2-column section (Figma 2:271 / 2:1297 / 62:53 and recurrences).
 *
 * Visual spec (Figma):
 *   bg-page full-width section, p-[120px] outer, items-center.
 *
 *   Text-only (default):
 *     LEFT  flex-1 — eyebrow (optional) + h2 heading
 *     RIGHT flex-1 — any rich content via <slot /> (paragraphs, links, lists...)
 *     gap-[120px]
 *
 *   With image, placement "end" (Figma 2:271 / 2:1297):
 *     LEFT  flex-1 — eyebrow + h2 + body slot
 *     RIGHT — image slot (grey placeholder by default)
 *     Portrait 507×657.445: gap 120px, image max 507px
 *     Landscape 568×438.667: gap 64px, equal columns
 *
 *   With image, placement "under-heading" (Figma 62:53):
 *     LEFT  flex-1 — heading + image (gap 32px)
 *     RIGHT flex-1 — body slot
 *     Image 568×378.667, gap 64px
 *
 * Props:
 *   eyebrow         — optional eyebrow label above the heading
 *   heading         — plain-text heading (use headingHtml for inline accents/spans)
 *   headingHtml     — raw HTML heading string (takes precedence over heading)
 *   id              — section anchor id
 *   compact         — true = 64px vertical padding (Figma 64:983); default is 120px
 *   withImage       — true = include the image column / placeholder
 *   imageAspect     — CSS aspect-ratio for the default placeholder (Figma frame size)
 *   imagePlacement  — "end" (image opposite the text stack) or "under-heading"
 *   imageReverse    — true = image LEFT / text RIGHT (mirrors the default end layout)
 *   alignTop        — true = text-only columns align to the top (use when the body is tall, e.g. a form)
 *   class           — extra classes on the outer <section>
 */

import Heading from '~/components/ui/Heading.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import Image from '~/components/common/Image.astro';
import type { ContentImage } from '~/lib/content/types';

export interface Props {
  eyebrow?: string;
  heading?: string;
  headingHtml?: string;
  id?: string;
  compact?: boolean;
  withImage?: boolean;
  image?: ContentImage;
  imageAspect?: string;
  imagePlacement?: 'end' | 'under-heading';
  imageReverse?: boolean;
  alignTop?: boolean;
  class?: string;
}

const {
  eyebrow,
  heading,
  headingHtml,
  id,
  compact = false,
  withImage = false,
  image,
  imageAspect = '507 / 657.445',
  imagePlacement = 'end',
  imageReverse = false,
  alignTop = false,
  class: className = '',
} = Astro.props;

const imageSlotHtml = Astro.slots.has('image') ? await Astro.slots.render('image') : '';
const hasImage = withImage || Boolean(image) || Boolean(imageSlotHtml);
const imageUnderHeading = hasImage && imagePlacement === 'under-heading';
const imageAside = hasImage && !imageUnderHeading;
const bodyHtml = await Astro.slots.render('default');

const [aspectW, aspectH] = imageAspect.split('/').map((n) => Number(n.trim()));
const isLandscape = Number.isFinite(aspectW) && Number.isFinite(aspectH) && aspectW > aspectH;
const useNarrowGap = imageUnderHeading || (imageAside && isLandscape);
---

<section {...id ? { id } : {}} class:list={['not-prose relative w-full', Astro.slots.has('motif') && 'overflow-hidden', className]}>
  {/* Optional decorative motif (<Motif slot="motif" />), positioned against the full-width section */}
  <slot name="motif" />
  <div
    class:list={[
      'mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16',
      compact ? 'md:py-16' : 'md:py-[120px]',
    ]}
  >
    <div
      class:list={[
        'flex flex-col gap-12 lg:flex-row',
        alignTop && !hasImage ? 'lg:items-start' : 'lg:items-center',
        useNarrowGap ? 'lg:gap-16' : 'lg:gap-[120px]',
        imageReverse && imageAside && 'lg:flex-row-reverse',
      ]}
    >
      {/* ── LEFT — heading; body when image is aside; image when under-heading ── */}
      <div class:list={['flex min-w-0 flex-1 flex-col', hasImage ? 'gap-8' : 'gap-4']}>
        <div class="flex flex-col gap-4">
          {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
          {
            headingHtml ? (
              <Heading variant="h2" html={headingHtml} />
            ) : (
              heading && <Heading variant="h2">{heading}</Heading>
            )
          }
        </div>
        {
          imageUnderHeading && (
            <div class="w-full min-w-0">
              {image ? (
                <Image
                  {...image}
                  class="h-full w-full object-cover"
                  widths={[400, 768, 1200]}
                  sizes="(max-width: 1024px) 100vw, 50vw"
                  loading="lazy"
                  width={568}
                  height={379}
                  layout="cover"
                  format="webp"
                  style={`aspect-ratio: ${imageAspect};`}
                />
              ) : imageSlotHtml ? (
                <Fragment set:html={imageSlotHtml} />
              ) : (
                <HeroImagePlaceholder fill class="w-full" style={`aspect-ratio: ${imageAspect};`} />
              )}
            </div>
          )
        }
        {imageAside && <div class="flex flex-col" set:html={bodyHtml} />}
      </div>

      {
        imageAside ? (
          <div class:list={['w-full min-w-0 flex-1', !isLandscape && 'lg:max-w-[507px]']}>
            {image ? (
              <Image
                {...image}
                class="h-full w-full object-cover"
                widths={[400, 768, 1200]}
                sizes="(max-width: 1024px) 100vw, 50vw"
                loading="lazy"
                width={isLandscape ? 568 : 507}
                height={isLandscape ? 427 : 657}
                layout="cover"
                format="webp"
                style={`aspect-ratio: ${imageAspect};`}
              />
            ) : imageSlotHtml ? (
              <Fragment set:html={imageSlotHtml} />
            ) : (
              <HeroImagePlaceholder fill class="w-full" style={`aspect-ratio: ${imageAspect};`} />
            )}
          </div>
        ) : (
          <div class="flex min-w-0 flex-1 flex-col" set:html={bodyHtml} />
        )
      }
    </div>
  </div>
</section>
