---
/**
 * TalkToDoctor — advice list + Athena Clinic packages (Figma node 176:259).
 *
 * Visual spec:
 *   bg-page, px 120, pb 64. Two equal columns, gap 64px.
 *   LEFT  — icon + h3 + body rows, muted 2px dividers between items.
 *   RIGHT — navy→primary gradient card (rounded-[32px]) overlapping a
 *            heading-coloured disclosure tab (rounded-b-[32px]).
 *
 * Content is passed from the page file — never baked in.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';

export interface AdviceItem {
  iconSvg: string;
  title: string;
  body: string;
}

export interface PackageStep {
  number: string;
  body: string;
}

export interface Props {
  items: AdviceItem[];
  clinicEyebrow?: string;
  clinicHeading?: string;
  packages: PackageStep[];
  addOnNote?: string;
  disclosureEyebrow?: string;
  disclosure?: string;
  id?: string;
}

const {
  items = [],
  clinicEyebrow = 'Athena Clinic',
  clinicHeading = '3 packages',
  packages = [],
  addOnNote,
  disclosureEyebrow = 'disclosure',
  disclosure,
  id,
} = Astro.props;
---

<section {...id ? { id } : {}} class="not-prose w-full pb-12 md:pb-16">
  <div class="mx-auto flex w-full max-w-container flex-col items-start gap-12 px-5 sm:px-8 md:px-16 lg:flex-row lg:gap-16 lg:px-[120px]">

    {/* ── LEFT — advice rows ── */}
    <div class="flex min-w-0 flex-1 flex-col justify-center">
      {items.map((item, i) => (
        <div
          class:list={[
            'flex w-full flex-col',
            i === 0 ? 'pb-8' : 'py-8',
            i < items.length - 1 && 'border-b-2 border-muted/20',
          ]}
        >
          <div class="flex w-full flex-col items-start gap-4">
            <div class="flex w-full items-start gap-4">
              <span
                class="size-8 shrink-0 text-heading [&>svg]:size-full"
                set:html={item.iconSvg}
              />
              <Heading variant="h3" as="h2" class="min-w-0 flex-1 text-shadow-page">
                {item.title}
              </Heading>
            </div>
            <Text>{item.body}</Text>
          </div>
        </div>
      ))}
    </div>

    {/* ── RIGHT — packages card + overlapping disclosure ── */}
    <div class="relative isolate flex min-w-0 flex-1 flex-col">
      <div
        class="relative z-[2] mb-[-34px] flex w-full flex-col items-start gap-8 overflow-hidden rounded-[32px] p-8 md:gap-8 md:p-12"
        style="background: linear-gradient(92.4deg, var(--aw-color-bg-section-dark) 5.27%, var(--aw-color-primary) 97.29%);"
      >
        <div class="flex w-full flex-col items-start gap-4">
          {clinicEyebrow && (
            <Heading variant="eyebrow">{clinicEyebrow}</Heading>
          )}
          <Heading variant="h2" color="inherit" class="text-contrast">
            {clinicHeading}
          </Heading>
        </div>

        <ol class="flex w-full flex-col items-start gap-3 text-contrast">
          {packages.map((step) => (
            <li class="flex w-full items-center gap-6">
              <span class="flex h-[52px] w-11 shrink-0 items-center font-heading text-[52px] leading-none mix-blend-overlay md:h-[82px] md:text-[82px]">
                {step.number}
              </span>
              <Text color="inherit" class="min-w-0 flex-1 text-contrast">
                {step.body}
              </Text>
            </li>
          ))}
        </ol>

        {addOnNote && (
          <div class="flex w-full items-center justify-end">
            <Text color="inherit" class="max-w-[295px] text-right text-contrast/50">
              {addOnNote}
            </Text>
          </div>
        )}
      </div>

      {disclosure && (
        <div class="relative z-[1] flex w-full items-start rounded-b-[32px] bg-heading px-8 pb-6 pt-16 backdrop-blur-[10px]">
          <div class="flex min-w-0 flex-1 flex-col items-start gap-1.5">
            {disclosureEyebrow && (
              <Heading variant="eyebrow">{disclosureEyebrow}</Heading>
            )}
            <Text variant="small" color="inherit" class="text-contrast/80">
              {disclosure}
            </Text>
          </div>
        </div>
      )}
    </div>

  </div>
</section>
