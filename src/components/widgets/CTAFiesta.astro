---
/**
 * CTAFiesta — Figma "CTA" 2083:2491. Red band, papel picado motif on top,
 * centred eyebrow + display headline + copy + row of Light buttons.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import Motif from '~/components/ui/Motif.astro';
import type { CallToAction } from '~/types';

export interface Props {
  id?: string;
  eyebrow?: string;
  /** Use <br /> to break lines. */
  title: string;
  body?: string;
  actions?: CallToAction[];
}

const { id, eyebrow, title, body, actions = [] } = Astro.props;
---

<section {...id ? { id } : {}} class="relative w-full overflow-hidden bg-section-dark">
  <div class="container-x flex flex-col items-center gap-7 pb-16 text-center md:pb-[120px]">
    <Motif name="papel-picado-small" class="h-[76.5px] w-full max-w-[1161px]" />
    {eyebrow && <Heading variant="eyebrow" color="inherit" class="inline-block rotate-3 text-marigold">{eyebrow}</Heading>}
    <Heading variant="display" color="white" class="text-balance" html={title} />
    {body && <Text variant="body-lg" class="max-w-[620px] text-blush">{body}</Text>}
    {
      actions.length > 0 && (
        <div class="flex w-full flex-col justify-center gap-4 pt-2 sm:w-auto sm:flex-row sm:flex-wrap">
          {actions.map((a) => (
            <Button {...a} variant="ghost" tone="dark" hideNote class="w-full sm:w-auto" />
          ))}
        </div>
      )
    }
  </div>
</section>
