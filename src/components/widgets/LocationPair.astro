---
/**
 * LocationPair — Figma "Locations" 2083:2412. Header + two framed cards with
 * an arched photo, numbered label, big name, address, hours, copy, two CTAs.
 */
import { Icon } from 'astro-icon/components';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import ImagePlaceholder from '~/components/ui/ImagePlaceholder.astro';
import type { CallToAction } from '~/types';

export interface Location {
  label: string;
  /** Tailwind text color token class for the label, e.g. "text-accent". */
  labelClass?: string;
  name: string;
  address: string;
  hours: string;
  description: string;
  actions: CallToAction[];
  /** Photo (Sanity). */
  image?: { src: string; alt?: string };
}

export interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  locations: Location[];
}

const { id, eyebrow, title, intro, locations } = Astro.props;
---

<section {...id ? { id } : {}} class="w-full bg-page">
  <div class="container-x flex flex-col gap-12 py-16 md:py-[120px] xl:gap-14">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:gap-16">
      <div class="flex flex-col items-start gap-1 lg:w-[58%] lg:shrink-0">
        {eyebrow && <Heading variant="eyebrow" class="inline-block rotate-3">{eyebrow}</Heading>}
        <Heading variant="h2" html={title} />
      </div>
      {intro && <Text variant="body-lg" class="flex-1 text-tan-body">{intro}</Text>}
    </div>

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
      {
        locations.map((loc) => (
          <article class="flex h-full flex-col gap-5 border-2 border-heading bg-card px-5 pb-8 pt-5 shadow-hard">
            <ImagePlaceholder class="h-[260px] rounded-t-full md:h-[340px]" image={loc.image} />
            <div class="flex flex-1 flex-col items-start gap-3 px-1 min-[1440px]:px-3">
              <p class:list={['type-label', loc.labelClass ?? 'text-accent']}>{loc.label}</p>
              <Heading variant="h3" color="inherit" as="h3" class="text-heading">{loc.name}</Heading>
              <p class="flex gap-2.5 text-[15px] font-medium leading-[1.5] text-heading">
                <Icon name="tabler:map-pin" class="mt-0.5 size-[22px] shrink-0 text-accent" aria-hidden="true" />
                <span>{loc.address}</span>
              </p>
              <p class="flex items-center gap-2.5 text-[15px] font-medium text-heading">
                <Icon name="tabler:clock" class="size-[22px] shrink-0 text-accent" aria-hidden="true" />
                <span>{loc.hours}</span>
              </p>
              <Text variant="small" class="text-muted">{loc.description}</Text>
              <div class="mt-auto flex w-full flex-col gap-3.5 pt-2 sm:flex-row sm:flex-wrap">
                {loc.actions.map((a) => (
                  <Button {...a} hideNote class="w-full px-5 sm:w-auto min-[1440px]:px-7" />
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
