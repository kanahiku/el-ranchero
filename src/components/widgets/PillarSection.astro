---
/**
 * PillarSection — "Bucket" section with a tan top-rounded card, two-column header,
 * and a 4-up grid of pillar cards (Figma node 2:316).
 *
 * Visual spec:
 *   bg-cta background, rounded-tl-[64px] rounded-tr-[64px] — top corners only.
 *   Inner padding: p-[120px].
 *   Header (2-col, gap-[120px]):
 *     Left: eyebrow + h2 heading
 *     Right: body text (with optional bold span via bodyHtml)
 *   Card grid: flex gap-[32px], 4 equal columns (responsive: 2-col md, 4-col lg).
 *
 * Each card item:
 *   label        — eyebrow category (e.g. "MOVEMENT")
 *   heading      — card title (~28px Fraunces, text-primary)
 *   description  — body text (12px Hanken Grotesk, text-muted)
 *   iconSvg      — full SVG markup string for the icon (set:html)
 *   iconBg       — when true, wraps icon in bg-cta rounded-bl-[12px] container
 *                  (use for small standalone icons; false for SVGs with built-in bg)
 *
 * Usage:
 *   <PillarSection
 *     eyebrow="BUCKET 01 · THE BASICS"
 *     heading="Bucket #1 is the basics. All four of them."
 *     bodyHtml="Move. Eat well. Sleep. Stay connected. ... <strong>show up for any one, stay for all four.</strong>"
 *     cards={[
 *       { label: "MOVEMENT", heading: "The body is a rebellion...", description: "...", iconSvg: movementSvg },
 *       ...
 *     ]}
 *   />
 */

import Card from '~/components/ui/Card.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';

export interface PillarCardItem {
  /** Eyebrow label shown at top-left of the card (e.g. "MOVEMENT"). */
  label: string;
  /** Card heading — rendered in Fraunces at 28px. */
  heading: string;
  /** Card body description — rendered in Hanken Grotesk at 12px. */
  description: string;
  /**
   * Full SVG markup string for the icon.
   * For Movement / Food: 50×50 SVGs that already include the tan background in the SVG itself.
   * For Sleep / Connection: 20×20 icon-only SVGs — set iconBg=true.
   */
  iconSvg: string;
  /**
   * When true, the icon is wrapped in a `bg-cta size-[50px] rounded-bl-[12px]` container.
   * Default: false.
   */
  iconBg?: boolean;
}

export interface Props {
  eyebrow?: string;
  heading: string;
  /** Body text in the right column. Accepts HTML (e.g. <strong> for the bold span). */
  bodyHtml?: string;
  cards: PillarCardItem[];
  id?: string;
}

const { eyebrow, heading, bodyHtml, cards = [], id } = Astro.props;
---

<section
  {...id ? { id } : {}}
  class="not-prose w-full rounded-t-[32px] bg-cta py-12 md:rounded-t-[64px] md:py-16 lg:py-[120px]"
>
<div class="mx-auto w-full max-w-container px-5 sm:px-8 md:px-16 lg:px-[120px]">

  {/* ── Header: eyebrow + heading (left) | body text (right) ── */}
  <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:gap-[120px]">

    <div class="flex min-w-0 flex-1 flex-col gap-4">
      {eyebrow && (
        <Heading variant="eyebrow">{eyebrow}</Heading>
      )}
      <Heading variant="h2">{heading}</Heading>
    </div>

    {bodyHtml && (
      <Text class="min-w-0 flex-1" html={bodyHtml} />
    )}

  </div>

  {/* ── Card grid ── */}
  {cards.length > 0 && (
    <div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {cards.map((card) => (
        <Card variant="pillar" label={card.label} iconBg={card.iconBg ?? false}>
          <Fragment slot="icon" set:html={card.iconSvg} />
          <Heading variant="h4" color="inherit" class="text-primary" as="p">
            {card.heading}
          </Heading>
          <Text variant="small">{card.description}</Text>
        </Card>
      ))}
    </div>
  )}

</div>
</section>
