---
import Heading from '~/components/ui/Heading.astro';
import Motif from '~/components/ui/Motif.astro';
import BlogCard from '~/components/ui/BlogCard.astro';
import { getBlogPostsRelatedTo, getRelatedBlogPosts } from '~/lib/content';
import { cardVariant, isDarkSurface, type SectionSurface } from '~/lib/content/sectionTheme';
import type { BlogPost } from '~/lib/content/types';

export interface Props {
  pageSlug?: string;
  post?: BlogPost;
  excludeSlug?: string;
  surface?: SectionSurface;
  title?: string;
}

const RELATED_LIMIT = 3;

const {
  pageSlug,
  post,
  excludeSlug,
  surface = 'grey',
  title = 'Related Blogs',
} = Astro.props;

const related = post
  ? await getRelatedBlogPosts(post, RELATED_LIMIT)
  : pageSlug !== undefined
    ? (await getBlogPostsRelatedTo(pageSlug))
        .filter((item) => item.slug !== excludeSlug)
        .slice(0, RELATED_LIMIT)
    : [];

const isDark = isDarkSurface(surface);
const variant = cardVariant(surface);
---

{
  related.length > 0 && (
    <section class="not-prose relative w-full bg-page">
      <Motif name="scallop-edge-cream" class="absolute inset-x-0 -top-3 z-10 h-6" />
      <div class="container-x relative flex flex-col gap-10 py-16 md:py-[120px]">
        <Heading variant="h2">{title}</Heading>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          {related.map((item) => (
            <BlogCard post={item} variant={variant} />
          ))}
        </div>
      </div>
    </section>
  )
}
