---
/**
 * ConceptCards — 4-up row of Card variant="pillar" with no section header
 * (Figma node 64:845, Four Pillars).
 *
 * Visual spec:
 *   bg-page, px 120, no extra vertical padding.
 *   4 equal columns, gap 32px, items stretch to the tallest card.
 *   Each card: label eyebrow, 28px Fraunces title, 12px body. No icons.
 *
 * Content is passed from the page file — never baked in.
 */
import Card from '~/components/ui/Card.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';

export interface ConceptCardItem {
  label: string;
  title: string;
  description: string;
}

export interface Props {
  cards: ConceptCardItem[];
  id?: string;
}

const { cards = [], id } = Astro.props;
---

<section {...id ? { id } : {}} class="not-prose w-full">
  <div class="mx-auto grid w-full max-w-container grid-cols-1 gap-8 px-5 py-10 sm:grid-cols-2 sm:px-8 md:px-16 md:py-16 lg:grid-cols-4 lg:px-[120px] lg:py-[64px]">
    {cards.map((card) => (
      <Card variant="pillar" label={card.label} class="h-full">
        <Heading variant="h4" color="inherit" class="text-primary" as="p">
          {card.title}
        </Heading>
        <Text variant="small">{card.description}</Text>
      </Card>
    ))}
  </div>
</section>
