---
/**
 * Publications section.
 *
 * Layout (Figma 121:2085):
 *   bg-page, p-[120px], flex-col gap-[64px]
 *   Centered header: eyebrow + h2
 *   3-col row of publication cards
 *     Each card: bg-feature-card, border-section-grey, rounded-[16px], overflow-clip
 *     Header: book icon (40×40) + count eyebrow
 *     Body: h4 title + small description
 */
import Heading from '~/components/ui/Heading.astro';

interface Publication {
  count: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  publications: Publication[];
  id?: string;
}

const {
  eyebrow = 'Publications',
  heading,
  publications,
  id,
} = Astro.props;

/* Book tile SVG — 40×40, bg-card-light rounded-br corner built into the path */
const bookTileSvg = `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M0 0H40V28C40 34.6274 34.6274 40 28 40H0V0Z" fill="#E4EDF2"/><path d="M18.096 13.91C16.816 13.306 15.028 13.011 12.633 13C12.408 12.997 12.186 13.062 11.999 13.187C11.845 13.289 11.719 13.428 11.632 13.59C11.545 13.752 11.5 13.933 11.5 14.116V24.128C11.5 24.805 11.987 25.316 12.633 25.316C15.15 25.316 17.675 25.548 19.187 26.96C19.208 26.98 19.234 26.993 19.262 26.998C19.29 27.003 19.319 26.999 19.345 26.988C19.371 26.977 19.394 26.959 19.409 26.935C19.425 26.911 19.433 26.884 19.433 26.856V15.058C19.433 14.979 19.416 14.9 19.382 14.828C19.349 14.755 19.3 14.691 19.24 14.639C18.893 14.346 18.508 14.101 18.096 13.91ZM28 13.186C27.812 13.062 27.591 12.997 27.365 13C24.971 13.011 23.182 13.305 21.903 13.91C21.49 14.101 21.105 14.345 20.759 14.637C20.698 14.69 20.649 14.754 20.616 14.827C20.583 14.899 20.566 14.978 20.566 15.057V26.855C20.566 26.882 20.574 26.908 20.589 26.931C20.604 26.954 20.626 26.971 20.651 26.982C20.676 26.992 20.704 26.995 20.731 26.99C20.758 26.985 20.783 26.972 20.802 26.953C21.711 26.061 23.307 25.315 27.367 25.315C27.667 25.315 27.956 25.197 28.168 24.987C28.381 24.777 28.5 24.492 28.5 24.195V14.117C28.5 13.933 28.455 13.752 28.368 13.589C28.281 13.427 28.154 13.288 28 13.186Z" fill="#567F9B"/></svg>`;
---

<section
  class="not-prose w-full"
  {...id ? { id } : {}}
>
  <div class="mx-auto flex max-w-container flex-col gap-10 px-5 py-10 sm:px-8 sm:py-12 md:px-16 md:py-16 lg:gap-[64px] lg:px-[120px] lg:py-[120px]">

    {/* ── Header ── */}
    <div class="flex flex-col items-center gap-4 text-center">
      <Heading variant="eyebrow">{eyebrow}</Heading>
      <h2 class="font-heading text-h2 font-normal leading-none text-heading">
        {heading}
      </h2>
    </div>

    {/* ── Publication cards ── */}
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-[32px]">
      {publications.map((pub) => (
        <div class="flex flex-col overflow-clip rounded-[16px] border border-section-grey bg-feature-card">
          {/* Card header: book icon + count */}
          <div class="flex items-center gap-3 pb-4">
            <span class="size-9 shrink-0 overflow-clip sm:size-[40px] [&_svg]:size-full" set:html={bookTileSvg} />
            <span class="font-sans text-[12px] uppercase tracking-[0.06em] text-accent">
              {pub.count}
            </span>
          </div>
          {/* Card body */}
          <div class="flex flex-col gap-4 px-4 pb-4">
            <p class="font-heading text-h4 font-normal leading-[1.2] text-primary">
              {pub.title}
            </p>
            <p class="font-sans text-small leading-[1.3] text-muted">
              {pub.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
