---
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import type { ContentImage } from '~/lib/content/types';

export interface FullMenuItem {
  title: string;
  description?: string;
  badge?: string;
  note?: string;
  image?: ContentImage;
}

export interface FullMenuCategory {
  title: string;
  href?: string;
  description?: string;
  items: FullMenuItem[];
}

export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  categories?: FullMenuCategory[];
  ctaText?: string;
  ctaHref?: string;
  id?: string;
}

const {
  eyebrow,
  title = 'The Full El Ranchero Menu',
  subtitle,
  categories = [],
  ctaText,
  ctaHref,
  id,
} = Astro.props;

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
---

<section {...id ? { id } : {}} class="not-prose relative w-full bg-page" aria-label="Full menu">
  <!-- Decorative images in their own overflow-hidden shell so sticky positioning still works -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  </div>

  <div
    class="relative z-[1] mx-auto flex w-full max-w-container flex-col gap-10 px-5 py-16 sm:px-8 md:gap-14 md:px-16 md:py-[120px]"
  >
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex max-w-3xl flex-col gap-5">
        {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
        {title && <Heading variant="h2">{title}</Heading>}
        {
          subtitle && (
            <Text variant="body-lg" color="default">
              {subtitle}
            </Text>
          )
        }
      </div>
      {
        ctaText && ctaHref && (
          <Button variant="primary" text={ctaText} href={ctaHref} hideNote={true} class="shrink-0" />
        )
      }
    </div>

    {
      categories.length > 0 && (
        <nav
          class="sticky top-14 z-30 -mx-5 overflow-x-auto border-y border-heading/10 bg-page/95 px-5 py-3 backdrop-blur sm:-mx-8 sm:px-8 md:top-[77px] md:-mx-16 md:px-16"
          aria-label="Menu sections"
          data-full-menu-jump-nav
          style="top: var(--jump-nav-top, 3.5rem)"
        >
          <ul class="flex min-w-max gap-2">
            {categories.map((category) => (
              <li>
                <a
                  href={`#${slugify(category.title)}`}
                  class="inline-flex min-h-10 items-center border border-section-dark bg-transparent px-4 font-heading text-button font-semibold leading-none text-heading transition-colors duration-200 hover:bg-section-dark hover:text-contrast aria-[current=true]:bg-section-dark aria-[current=true]:text-contrast"
                  data-full-menu-jump-link
                >
                  {category.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="flex flex-col gap-14 md:gap-20">
      {
        categories.map((category) => (
          <section
            id={slugify(category.title)}
            class="scroll-mt-36 md:scroll-mt-44"
            aria-labelledby={`${slugify(category.title)}-heading`}
            data-full-menu-section
            style="scroll-margin-top: var(--jump-nav-scroll-mt, 9rem)"
          >
            <div class="mb-6 flex flex-col gap-4 md:mb-8 md:flex-row md:items-end md:justify-between">
              <div class="flex max-w-2xl flex-col gap-3">
                <h3
                  id={`${slugify(category.title)}-heading`}
                  class="font-rough text-h2 font-normal leading-none text-heading"
                >
                  {category.title}
                </h3>
                {category.description && (
                  <p class="font-sans text-body-lg leading-[1.3] tracking-[-0.01em] text-muted">
                    {category.description}
                  </p>
                )}
              </div>
              {category.href && (
                <a
                  href={category.href}
                  class="font-heading text-button font-semibold leading-none text-accent hover:text-accent-hover"
                >
                  View category
                </a>
              )}
            </div>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
              {category.items.map((item) => (
                <article class="flex h-full flex-col overflow-hidden bg-card">
                  <div class="relative w-full bg-section-grey" style="aspect-ratio: 4 / 3;">
                    {item.image?.src ? (
                      <Image
                        src={item.image.src}
                        alt={item.image.alt || ''}
                        width={640}
                        height={480}
                        layout="cover"
                        loading="lazy"
                        decoding="async"
                        class="absolute inset-0 h-full w-full object-cover"
                      />
                    ) : (
                      <>
                        {/* TODO: replace with <Image> when asset is ready */}
                        <HeroImagePlaceholder
                          fill
                          class="absolute inset-0"
                          label={`${item.title} menu item placeholder`}
                        />
                      </>
                    )}
                    {item.badge && (
                      <span class="absolute bottom-3 left-3 z-10 bg-section-dark px-2.5 pt-[4px] pb-[2px] font-heading text-[11px] font-medium leading-none tracking-[0.06em] text-contrast shadow-sm uppercase">
                        {item.badge}
                      </span>
                    )}
                  </div>
                  <div class="flex flex-1 flex-col gap-3 px-5 py-5">
                    <div class="flex items-center justify-between gap-3">
                      <h4 class="font-rough text-h4 font-normal leading-none text-heading">{item.title}</h4>
                      {item.note && (
                        <span class="shrink-0 text-right font-sans text-[11px] leading-snug tracking-[0.02em] text-section-dark">
                          {item.note}
                        </span>
                      )}
                    </div>
                    {item.description && (
                      <p class="font-sans text-body leading-[1.45] tracking-[-0.01em] text-muted">{item.description}</p>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</section>

<script>
  type JumpNavElement = HTMLElement & { _jumpNavCleanup?: () => void };

  const setupFullMenuJumpNav = () => {
    const navs = document.querySelectorAll<HTMLElement>('[data-full-menu-jump-nav]');

    navs.forEach((nav) => {
      const jumpNav = nav as JumpNavElement;

      // Tear down any previous listeners / observers from a prior init
      jumpNav._jumpNavCleanup?.();

      const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-full-menu-jump-link]'));
      const menuSections = links
        .map((link) => {
          const id = link.hash.slice(1);
          const section = id ? document.getElementById(id) : null;
          return section ? { id, link, section } : null;
        })
        .filter((item): item is { id: string; link: HTMLAnchorElement; section: HTMLElement } => Boolean(item));

      if (!menuSections.length) return;

      // ── 1. STICKY TOP ─────────────────────────────────────────────────────────
      // Read the real rendered height of the sticky site header so the jump-nav
      // sits flush underneath it at every viewport size / scroll state.
      const siteHeader = document.querySelector<HTMLElement>('[data-aw-sticky-header]');

      const applyTop = () => {
        const headerH = siteHeader ? siteHeader.getBoundingClientRect().height : window.innerWidth >= 768 ? 77 : 56;
        // Drive both the nav sticky-top and the section scroll-margin via CSS vars
        // so a single measurement keeps everything in sync.
        nav.style.setProperty('--jump-nav-top', `${headerH}px`);
        nav.style.top = `${headerH}px`;
        // scroll-mt = header + jump-nav + 8 px breathing room
        const scrollMt = headerH + nav.getBoundingClientRect().height + 8;
        document.querySelectorAll('[data-full-menu-section]').forEach((s) => {
          (s as HTMLElement).style.scrollMarginTop = `${scrollMt}px`;
        });
      };

      applyTop();
      const ro = new ResizeObserver(applyTop);
      if (siteHeader) ro.observe(siteHeader);
      ro.observe(nav); // re-compute if the navs own height changes

      // ── 2. HORIZONTAL PILL SCROLL ────────────────────────────────────────────
      // Never call scrollIntoView() — it can trigger vertical page scroll as a
      // side-effect. Instead scroll the nav container horizontally ourselves.
      const scrollPillIntoView = (link: HTMLAnchorElement) => {
        const navRect = nav.getBoundingClientRect();
        const linkRect = link.getBoundingClientRect();
        // Position of the links left/right edges inside the navs scroll container
        const linkLeft = linkRect.left - navRect.left + nav.scrollLeft;
        const linkRight = linkLeft + linkRect.width;
        const pad = 16;
        if (linkLeft < nav.scrollLeft + pad) {
          nav.scrollTo({ left: Math.max(0, linkLeft - pad), behavior: 'smooth' });
        } else if (linkRight > nav.scrollLeft + nav.clientWidth - pad) {
          nav.scrollTo({ left: linkRight - nav.clientWidth + pad, behavior: 'smooth' });
        }
      };

      // ── 3. ACTIVE-SECTION DETECTION ──────────────────────────────────────────
      // Threshold = header height + jump-nav height + 8 px buffer.
      // Using absolute pixel values (not nav.getBoundingClientRect().bottom) prevents
      // a bug where, before the nav is sticky, its .bottom can be hundreds of pixels
      // below the viewport top, causing the wrong section to be marked active.
      let activeId = '';

      const setActive = (id: string) => {
        if (id === activeId) return;
        activeId = id;
        menuSections.forEach((item) => {
          if (item.id === id) {
            item.link.setAttribute('aria-current', 'true');
            scrollPillIntoView(item.link);
          } else {
            item.link.removeAttribute('aria-current');
          }
        });
      };

      const update = () => {
        const headerH = siteHeader ? siteHeader.getBoundingClientRect().height : window.innerWidth >= 768 ? 77 : 56;
        const navH = nav.getBoundingClientRect().height;
        const visibleH = window.innerHeight - headerH - navH;

        // A section is "active" when its heading has entered the top 35 % of the
        // visible content area (the space below the sticky nav).
        // This matches what the eye sees: the heading is clearly on screen,
        // not pressed all the way up against the nav bottom.
        const threshold = headerH + navH + Math.round(visibleH * 0.35);

        // Last section whose top has scrolled above the threshold is the active one
        let next = menuSections[0].id;
        for (const { id, section } of menuSections) {
          if (section.getBoundingClientRect().top <= threshold) {
            next = id;
          }
        }
        setActive(next);
      };

      // rAF-throttled scroll listener
      let ticking = false;
      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            update();
            ticking = false;
          });
          ticking = true;
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });

      jumpNav._jumpNavCleanup = () => {
        window.removeEventListener('scroll', onScroll);
        ro.disconnect();
      };

      // Initial state
      update();
    });
  };

  // Clean up before Astro view-transition swaps the page
  document.addEventListener('astro:before-swap', () => {
    document.querySelectorAll<HTMLElement>('[data-full-menu-jump-nav]').forEach((nav) => {
      (nav as JumpNavElement)._jumpNavCleanup?.();
    });
  });

  setupFullMenuJumpNav();
  document.addEventListener('astro:page-load', setupFullMenuJumpNav);
</script>
