---
/**
 * PolaroidFeature — Figma "Breakfast" 2083:2124. Red band: polaroid photo on a
 * starburst (left), eyebrow + title + copy + labelled picks + CTA (right).
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import Motif from '~/components/ui/Motif.astro';
import ImagePlaceholder from '~/components/ui/ImagePlaceholder.astro';
import type { CallToAction } from '~/types';

export interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  body?: string;
  picks?: { label: string; text: string }[];
  action?: CallToAction;
  caption?: string;
  /** Photo (Sanity). */
  image?: { src: string; alt?: string };
}

const { id, eyebrow, title, body, picks = [], action, caption, image } = Astro.props;
---

<section {...id ? { id } : {}} class="relative w-full overflow-x-clip bg-section-dark">
  <Motif name="scallop-edge" class="absolute inset-x-0 -top-3 z-10 h-6" />

  <div
    class="container-x flex flex-col items-center gap-16 py-16 md:py-[120px] lg:flex-row lg:gap-24"
  >
    {/* Media 520 × 540 */}
    <div class="relative h-[400px] w-full max-w-[420px] shrink-0 md:h-[540px] md:max-w-[520px] lg:w-[44%]">
      <Motif name="starburst" class="absolute -left-[60px] -top-[50px] size-[480px] md:-left-[90px] md:-top-[70px] md:size-[660px]" />
      <figure
        class="absolute left-[17px] top-6 w-[calc(100%-17px)] rotate-4 bg-card px-4 pb-5 pt-4 shadow-[0_14px_15px_rgba(0,0,0,0.3)]"
      >
        <ImagePlaceholder ratio="440 / 400" image={image} />
        {caption && <figcaption class="mt-3 font-script text-[22px] leading-none text-heading">{caption}</figcaption>}
      </figure>
    </div>

    <div class="flex min-w-0 flex-1 flex-col items-start gap-[22px] text-contrast">
      {eyebrow && <Heading variant="eyebrow" color="inherit" class="inline-block -rotate-3 text-marigold">{eyebrow}</Heading>}
      <Heading variant="h2" color="white" html={title} />
      {body && <Text variant="body-lg" color="white">{body}</Text>}
      {
        picks.length > 0 && (
          <ul class="flex w-full flex-col gap-3 py-2">
            {picks.map((pick) => (
              <li class="flex flex-col gap-1 sm:flex-row sm:gap-4">
                <span class="type-label shrink-0 text-marigold sm:w-[110px]">{pick.label}</span>
                <Text variant="small" class="flex-1 text-blush">{pick.text}</Text>
              </li>
            ))}
          </ul>
        )
      }
      {action && <Button {...action} hideNote />}
    </div>
  </div>
</section>
