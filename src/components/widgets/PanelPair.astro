---
/**
 * PanelPair — Figma "Catering & Private Events" 2083:2449. Marigold band,
 * two framed panels (image, eyebrow, title, copy, CTA) with vertical motifs
 * between / beside them.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import Motif from '~/components/ui/Motif.astro';
import ImagePlaceholder from '~/components/ui/ImagePlaceholder.astro';
import type { CallToAction } from '~/types';

export interface Panel {
  eyebrow: string;
  title: string;
  body: string;
  action: CallToAction;
  /** Photo (Sanity). */
  image?: { src: string; alt?: string };
}

export interface Props {
  id?: string;
  panels: Panel[];
}

const { id, panels } = Astro.props;
---

<section {...id ? { id } : {}} class="relative w-full bg-marigold">
  <Motif name="scallop-edge-orange" class="absolute inset-x-0 -top-3 z-10 h-6" />

  <div class="container-x flex flex-col items-stretch gap-10 py-16 md:py-[120px] xl:flex-row">
    <Motif name="vine-left" class="hidden w-[39px] shrink-0 self-center xl:block xl:h-[233px]" />
    {
      panels.map((panel, i) => (
        <>
          {i > 0 && <Motif name="vine-center" class="hidden w-9 shrink-0 self-center xl:block xl:h-[481px]" />}
          <article class="flex flex-1 flex-col items-start gap-[18px] border-2 border-heading bg-page px-7 pb-9 pt-7 shadow-hard">
            <ImagePlaceholder class="h-[300px] border-2 border-heading" image={panel.image} />
            <Heading variant="eyebrow" class:list={['inline-block', i % 2 === 0 ? 'rotate-2' : '-rotate-2']}>
              {panel.eyebrow}
            </Heading>
            <Heading variant="h3" html={panel.title} />
            <Text variant="body" class="text-tan-body">{panel.body}</Text>
            <Button {...panel.action} hideNote class="mt-auto" />
          </article>
        </>
      ))
    }
    <Motif name="vine-right" class="hidden w-[39px] shrink-0 self-center xl:block xl:h-[233px]" />
  </div>
</section>
