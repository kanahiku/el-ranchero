---
/**
 * DuoCards — two equal promo cards in a row (Figma node 64:1086, Chapters).
 *
 * Visual spec:
 *   bg-page, px 120, pb 64. Two equal columns, gap 32px, items stretch.
 *   Each card is Card variant="dark" | "outlined" (A-05).
 *   Slot: eyebrow + h2 + body (flex-1) + Button pinned mt-auto.
 *
 * Content is passed from the page file — never baked in.
 */
import Button from '~/components/ui/Button.astro';
import Card from '~/components/ui/Card.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';

export interface DuoCardItem {
  variant?: 'dark' | 'outlined';
  eyebrow?: string;
  heading: string;
  body: string;
  cta: { text: string; href: string };
}

export interface Props {
  cards: DuoCardItem[];
  id?: string;
}

const { cards = [], id } = Astro.props;
---

<section {...id ? { id } : {}} class="not-prose w-full pb-12 md:pb-16">
  <div class="mx-auto w-full max-w-container px-5 sm:px-8 md:px-16 lg:px-[120px]">
    <div class="flex flex-col items-stretch gap-8 lg:flex-row">
      {cards.map((card) => {
        const isDark = (card.variant ?? 'dark') === 'dark';
        return (
          <Card variant={isDark ? 'dark' : 'outlined'} class="flex-1">
            <div class="flex w-full flex-1 flex-col items-start gap-4">
              {card.eyebrow && (
                <Heading variant="eyebrow">{card.eyebrow}</Heading>
              )}
              {isDark ? (
                <Heading variant="h2" color="inherit" class="text-contrast">
                  {card.heading}
                </Heading>
              ) : (
                <Heading
                  variant="h2"
                  color="inherit"
                  class="bg-[linear-gradient(110deg,var(--aw-color-bg-section-dark)_5%,var(--aw-color-primary)_97%)] bg-clip-text text-transparent"
                >
                  {card.heading}
                </Heading>
              )}
              {isDark ? (
                <Text color="inherit" class="text-contrast">
                  {card.body}
                </Text>
              ) : (
                <Text>{card.body}</Text>
              )}
            </div>
            <Button
              variant={isDark ? 'ghost' : 'primary'}
              tone={isDark ? 'dark' : undefined}
              text={card.cta.text}
              href={card.cta.href}
              hideNote
              class="mt-auto self-start"
            />
          </Card>
        );
      })}
    </div>
  </div>
</section>
