---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { CallToAction, Widget } from '~/types';
import Headline from '~/components/ui/Headline.astro';
import CTAActions from '~/components/ui/CTAActions.astro';

interface Props extends Widget {
  title?: string;
  subtitle?: string;
  tagline?: string;
  callToAction?: CallToAction;
  actions?: string | CallToAction[];
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  actions = await Astro.slots.render('actions'),

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-container mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <div
    class="w-full text-left p-6 rounded-md shadow-xl dark:shadow-none dark:border dark:border-slate-600"
  >
    <Headline
      title={title}
      subtitle={subtitle}
      tagline={tagline}
      classes={{
        container: 'mb-0 md:mb-0',
        title: 'text-[26px] md:text-[40px] font-normal leading-[110%] tracking-tighter font-heading',
        subtitle: 'text-[16px] md:text-[17px] font-normal leading-[160%] text-muted dark:text-slate-400',
      }}
    />
    {
      actions &&
        (Array.isArray(actions) ? (
          <CTAActions actions={actions} class="mt-6" />
        ) : (
          <div class="mt-6">
            <Fragment set:html={actions} />
          </div>
        ))
    }
  </div>
</WidgetWrapper>
