---
/**
 * FeaturedDishes — Homepage 59:66.
 * Header row + three photo tiles with overlay titles.
 * One widget for the whole site. Do not fork per page.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import Image from '~/components/common/Image.astro';
import type { ContentImage } from '~/lib/content/types';

export interface FeaturedDish {
  title: string;
  /** Tile photo (Sanity). Grey placeholder when omitted. */
  image?: ContentImage;
  /** One paragraph, or several. */
  description: string | string[];
  /** Makes the whole tile a link to the matching menu page. */
  href?: string;
}

export interface Props {
  eyebrow?: string;
  title?: string;
  /** One paragraph, or several. */
  subtitle?: string | string[];
  ctaText?: string;
  ctaHref?: string;
  dishes?: FeaturedDish[];
  id?: string;
}

const {
  eyebrow = 'Featured dishes',
  title = 'The ones people come back for.',
  subtitle = 'A few island favorites — or skip the menu entirely and build your own.',
  ctaText = 'view full menu',
  ctaHref = '/menu',
  dishes = [
    {
      title: 'Ono Island Ahi',
      description: 'Fresh local ahi, never frozen, over crisp island greens.',
    },
    {
      title: 'Aloha Passion',
      description: 'Blue cheese, candied walnuts, and a bright vinaigrette.',
    },
    {
      title: 'The Paniolo',
      description: 'Cheddar, black beans, and a smoky BBQ ranch.',
    },
  ],
  id,
} = Astro.props;

const paragraphs = (value?: string | string[]) =>
  (value === undefined ? [] : Array.isArray(value) ? value : [value]).filter(Boolean);
const subtitleParagraphs = paragraphs(subtitle);
---

<section
  {...id ? { id } : {}}
  class="not-prose relative w-full overflow-hidden bg-page"
>


  <div class="relative z-[1] mx-auto flex w-full max-w-container flex-col gap-10 px-5 py-16 sm:px-8 md:gap-16 md:px-16 md:py-[120px]">
    <div class="flex w-full min-w-0 flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div class="flex min-w-0 max-w-[822px] flex-1 flex-col items-start gap-6">
        {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
        {title && <Heading variant="h2">{title}</Heading>}
        <div class="flex flex-col gap-[30px]">
          {subtitleParagraphs.map((paragraph) => (
            <Text variant="body-lg" color="inherit" class="text-heading">{paragraph}</Text>
          ))}
        </div>
      </div>
      {ctaText && (
        <Button variant="primary" text={ctaText} href={ctaHref} hideNote={true} class="shrink-0" />
      )}
    </div>

    {/* Figma 2083:1700 — 416×552 photo tiles; a translucent blurred panel overlays the bottom half. */}
    <div class="grid w-full grid-cols-1 gap-8 md:grid-cols-3">
      {
        dishes.map((dish) => {
          const Tile = dish.href ? 'a' : 'article';
          return (
            <Tile
              href={dish.href}
              class:list={[
                'relative block min-h-[480px] w-full overflow-hidden md:aspect-[416/552] md:min-h-0',
                dish.href && 'group',
              ]}
            >
              {dish.image ? (
                <Image
                  {...dish.image}
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  widths={[400, 640, 832]}
                  sizes="(max-width: 768px) 100vw, 33vw"
                  loading="lazy"
                  width={832}
                  height={1104}
                  layout="cover"
                  format="webp"
                />
              ) : (
                <HeroImagePlaceholder
                  fill
                  class="absolute inset-0 transition-transform duration-500 group-hover:scale-[1.03]"
                  label={`${dish.title} placeholder`}
                />
              )}
              <div class="absolute inset-x-0 bottom-0 z-[1] flex min-h-[49.3%] flex-col items-start gap-3 bg-black/50 p-6 text-left backdrop-blur-[2.5px]">
                <Heading variant="h3" color="white">{dish.title}</Heading>
                <div class="flex flex-col gap-3.5">
                  {paragraphs(dish.description).map((paragraph) => (
                    <Text color="inherit" class="text-contrast">{paragraph}</Text>
                  ))}
                </div>
              </div>
            </Tile>
          );
        })
      }
    </div>
  </div>
</section>
