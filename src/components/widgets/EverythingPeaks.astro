---
/**
 * EverythingPeaks — reusable gradient-card split section (Figma node 2:229 and recurrences).
 *
 * Visual spec (Figma):
 *   bg-page outer, px-[120px] py-[64px].
 *   Inner card: bg-gradient-to-t from-transparent to-section-grey,
 *               rounded-tl-[64px] rounded-tr-[64px], p-[64px], gap-[32px], items-center.
 *   LEFT  flex-1 — eyebrow + h2 + body slot + primary CTA button
 *   RIGHT flex-1 — image slot (or grey placeholder via <slot name="image" />)
 *
 * Usage:
 *   <EverythingPeaks
 *     eyebrow="Why any of this is urgent"
 *     headingHtml="Everything peaks.<br/>Then it <span class='text-accent'>slopes.</span>"
 *     cta={{ text: "Understand the model", href: "/contact" }}
 *   >
 *     <Fragment slot="body">
 *       <Text>First paragraph...</Text>
 *       <Text class="mt-[1lh]">Second paragraph...</Text>
 *     </Fragment>
 *     <Fragment slot="image">
 *       <!-- grey placeholder or <Image> when ready -->
 *       <div class="w-full rounded-[32px] bg-section-grey" style="aspect-ratio:1695/928" aria-hidden="true" />
 *     </Fragment>
 *   </EverythingPeaks>
 *
 * Props:
 *   eyebrow     — optional eyebrow label
 *   heading     — plain-text heading
 *   headingHtml — HTML heading (takes precedence; supports inline accent spans)
 *   cta         — optional { text, href } for the primary CTA button
 *   id          — section anchor id
 */

import Heading from '~/components/ui/Heading.astro';
import Button from '~/components/ui/Button.astro';

export interface Props {
  eyebrow?: string;
  heading?: string;
  headingHtml?: string;
  cta?: { text: string; href: string };
  id?: string;
}

const { eyebrow, heading, headingHtml, cta, id } = Astro.props;
---

<section {...id ? { id } : {}} class="not-prose w-full py-8 md:py-16">
  <div class="mx-auto w-full max-w-container px-5 sm:px-8 md:px-16 lg:px-[120px]">
    <div class="flex w-full flex-col items-center gap-8 rounded-t-[32px] bg-gradient-to-t from-transparent to-section-grey p-6 md:rounded-t-[64px] md:p-16 lg:flex-row lg:items-center lg:gap-8 lg:p-[64px]">

      {/* ── LEFT ── */}
      <div class="flex min-w-0 flex-1 flex-col gap-8">

        {/* Eyebrow + heading */}
        <div class="flex flex-col gap-4">
          {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
          {headingHtml
            ? <Heading variant="h2" html={headingHtml} />
            : heading && <Heading variant="h2">{heading}</Heading>
          }
        </div>

        {/* Body — caller supplies paragraphs via slot="body" */}
        <slot name="body" />

        {cta && <Button variant="primary" text={cta.text} href={cta.href} />}
      </div>

      {/* ── RIGHT — image slot (placeholder or real asset) ── */}
      <div class="min-w-0 flex-1">
        <slot name="image">
          {/* Default: grey placeholder — replace when asset is ready */}
          <!-- TODO: replace with <Image> when asset is ready -->
          <div
            class="w-full rounded-[32px] bg-section-grey"
            style="aspect-ratio: 1695 / 928;"
            aria-hidden="true"
          />
        </slot>
      </div>

    </div>
  </div>
</section>
