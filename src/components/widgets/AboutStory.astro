---
/**
 * About page — Story & Philosophy split section.
 *
 * Layout (Figma 121:1730):
 *   bg-page, pt-[120px] px-[120px], flex row, gap-[64px]
 *   Left: image col (flex-1) — photo with rounded-bl/tl corners + right-fade gradient
 *   Right: text col (591px) — eyebrow, h2 with accent span, body paragraphs
 *
 * About page only — do not reuse for other sections (image fade gradient is unique).
 */
import type { ImageMetadata } from 'astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';

interface Props {
  id?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { id, imageAlt = '' } = Astro.props;
---

<section
  class="not-prose w-full"
  {...id ? { id } : {}}
>
  <div class="mx-auto flex max-w-container flex-col gap-10 px-5 py-10 sm:flex-row sm:items-center sm:gap-16 sm:px-8 sm:py-16 md:px-16 md:py-[80px] lg:gap-[64px] lg:px-[120px] lg:pt-[120px] lg:pb-[80px]">

    {/* Left: image */}
    <div class="relative w-full shrink-0 overflow-hidden rounded-bl-[32px] rounded-tl-[32px] sm:w-auto sm:flex-1" style="aspect-ratio: 545 / 564;">
      <!-- TODO: replace with <Image> when asset is ready -->
      <HeroImagePlaceholder
        fill
        label={imageAlt || 'El Ranchero story placeholder'}
        class="absolute inset-0 rounded-bl-[32px] rounded-tl-[32px]"
      />
      {/* Right-edge fade to page background */}
      <div
        class="pointer-events-none absolute inset-0 rounded-bl-[32px] rounded-tl-[32px] bg-gradient-to-r from-transparent from-[55%] to-page"
        aria-hidden="true"
      />
    </div>

    {/* Right: text column */}
    <div class="flex w-full flex-col items-start justify-center gap-6 lg:w-[591px] lg:shrink-0">
      <div class="flex flex-col gap-4">
        <Heading variant="eyebrow">My Story &amp; Philosophy</Heading>
        <h2 class="font-heading text-h2 font-normal leading-none text-heading">
          <span class="text-accent">Thirty years</span> making sense of anti-aging medicine.
        </h2>
      </div>
      <Text class="text-default">
        For 30 years, Ive studied the science of aging to separate lasting advances from passing fads.
        What Ive learned is simple: every system ages differently, and the weakest link matters most.
        <em>You are only as young as your oldest part.</em>
      </Text>
      <Text class="text-default">
        That philosophy shaped my practice: the <strong>Athena Textbook of Longevity</strong> provides the scientific
        framework, while <strong>Ningen Dock</strong> and our <strong>Overflowing Buckets Model</strong> turn it into
        a practical approach: detect problems early, prioritize high-impact interventions, and match advanced
        treatments to each patients goals.
      </Text>
    </div>

  </div>
</section>
