---
/**
 * BrandBar — Homepage 66:2.
 * Maroon ticker band: white icons + white words, looping.
 * One widget for the whole site. Do not fork per page.
 */
import addIcon from '~/assets/icons/Add-Sign-Bold--Streamline-Freehand.svg?url';
import basketIcon from '~/assets/icons/Shopping-Basket-Like--Streamline-Freehand.svg?url';
import locationIcon from '~/assets/icons/Worldwide-Web-Location-Pin--Streamline-Freehand.svg?url';

export interface BrandBarItem {
  text: string;
  /** Slight counterclockwise tilt — Figma Healthy / Local. */
  tilt?: boolean;
}

export interface Props {
  items?: BrandBarItem[];
  id?: string;
}

const {
  items = [
    { text: 'Healthy', tilt: true },
    { text: 'Fresh' },
    { text: 'Local', tilt: true },
  ],
  id,
} = Astro.props;

const set = [...items, ...items, ...items];
const doubled = [...set, ...set];

const iconByText: Record<string, string> = {
  Healthy: addIcon,
  Fresh: basketIcon,
  Local: locationIcon,
};
---

<section
  {...id ? { id } : {}}
  class="brand-bar not-prose relative h-14 w-full overflow-hidden bg-section-dark md:h-[66px]"
  aria-label={items.map((item) => item.text).join(', ')}
>
  <div class="brand-bar-mask h-full" aria-hidden="true">
    <div class="brand-bar-track flex h-full w-max items-center gap-8 px-4 md:gap-12">
      {
        doubled.map((item) => (
          <>
            <img
              src={iconByText[item.text] ?? basketIcon}
              alt=""
              class="size-8 shrink-0 brightness-0 invert md:size-[42px]"
              loading="lazy"
              decoding="async"
            />
            <p
              class:list={[
                'type-ticker brand-bar-word shrink-0 whitespace-nowrap text-white',
                item.tilt && '-rotate-[2.07deg]',
              ]}
            >
              {item.text}
            </p>
          </>
        ))
      }
    </div>
  </div>
</section>

<style>
  .brand-bar-word {
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  @keyframes brand-bar-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .brand-bar-track {
    animation: brand-bar-marquee 28s linear infinite;
  }

  .brand-bar-mask:hover .brand-bar-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-bar-track {
      animation: none;
    }
  }
</style>
