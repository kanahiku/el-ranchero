---
/**
 * Note — full-width notice band (e.g. food allergy information).
 * Heading on the left, message on the right at desktop; stacked on mobile.
 * Pass `title` / `description` as props or via the named slots.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';

export interface Props {
  title?: string;
  description?: string;
  /** Section background: page (default) or card (tinted). */
  tone?: 'page' | 'card';
  id?: string;
}

const {
  title = await Astro.slots.render('title'),
  description = await Astro.slots.render('description'),
  tone = 'page',
  id,
} = Astro.props;
---

<section {...id ? { id } : {}} class:list={['not-prose w-full', tone === 'card' ? 'bg-card' : 'bg-page']}>
  <div class="mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16">
    <div class="flex flex-col gap-4 rounded-md border-[1.5px] border-dashed border-heading/50 bg-card px-6 py-8 md:flex-row md:gap-[80px] md:px-10 md:py-10">
      {title && <Heading variant="h4" as="h2" class="md:w-1/2 md:flex-1" html={title} />}
      {description && <Text variant="body" color="default" class="md:flex-1" html={description} />}
    </div>
  </div>
</section>
