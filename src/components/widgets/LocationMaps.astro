---
/**
 * LocationMaps — heading + one card per restaurant, each with its address, a
 * "visit" button and an embedded Google map. Cards sit side by side on desktop.
 * Data comes from src/data/locations.ts (address, map embed, page href).
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import type { StoreLocation } from '~/data/locations';
import { storeMapEmbedSrc } from '~/data/locations';

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  stores: StoreLocation[];
  /** Button label per store, e.g. (name) => `Visit Our ${name} Location`. */
  buttonText?: (store: StoreLocation) => string;
  /** Small note under the cards. */
  footnote?: string;
  tone?: 'page' | 'card';
  id?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  stores,
  buttonText = (store: StoreLocation) => `Visit Our ${store.name} Location`,
  footnote,
  tone = 'page',
  id,
} = Astro.props;
---

<section
  {...id ? { id } : {}}
  class:list={['not-prose relative w-full overflow-hidden', tone === 'card' ? 'bg-card' : 'bg-page']}
>
  <div class="mx-auto flex w-full max-w-container flex-col gap-10 px-5 py-16 sm:px-8 md:gap-14 md:px-16 md:py-[120px]">
    <div class="flex max-w-4xl flex-col gap-6">
      {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
      <Heading variant="h2">{title}</Heading>
      {
        subtitle && (
          <Text variant="body-lg" color="default">
            {subtitle}
          </Text>
        )
      }
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
      {
        stores.map((store: StoreLocation) => (
          <article class:list={['flex h-full flex-col gap-6 p-6 md:p-8', tone === 'card' ? 'bg-page' : 'bg-card']}>
            <div class="flex flex-1 flex-col gap-3">
              <Heading variant="h3" as="h3">
                {store.name}
              </Heading>
              <address class="not-italic">
                <Text color="default" as="span" class="block">
                  {store.addressLine1}
                </Text>
                <Text color="default" as="span" class="block">
                  {store.addressLine2}
                </Text>
              </address>
            </div>
            <Button variant="primary" text={buttonText(store)} href={store.href} hideNote={true} class="self-start" />
            <iframe
              title={`Map of Taqueria El Ranchero ${store.name}`}
              src={storeMapEmbedSrc(store)}
              class="aspect-[4/3] w-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            />
          </article>
        ))
      }
    </div>

    {
      footnote && (
        <Text variant="body" color="default">
          {footnote}
        </Text>
      )
    }
  </div>
</section>
