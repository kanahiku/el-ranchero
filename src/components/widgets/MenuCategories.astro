---
/**
 * MenuCategories — grid of menu category cards (photo, title, description).
 *
 * Categories come from Sanity (title, description, order, width). One widget for
 * the menu hub and for every category page:
 *   - Hub (no exclusions): each card is 4 or 6 columns wide, set per category in Sanity (`hubSpan`).
 *   - Category pages: pass `excludeHref` so the current page drops out; the rest
 *     sit in an even 3-up grid.
 *
 * Cards are flex columns with the body flex-1, so descriptions of any length
 * keep every card in a row the same height.
 * Photos come from the Sanity menu category (`image` on the hub, `exploreMoreImage`
 * on category pages). A category without a photo shows the grey placeholder.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import { getMenuCategories } from '~/lib/content';

export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  /** Empty string hides the header CTA. */
  ctaText?: string;
  ctaHref?: string;
  /** Drop the current category so this grid can sit on menu subpages. */
  excludeHref?: string;
  excludeHrefs?: string[];
  /** Section background: page (default) or card (tinted). */
  tone?: 'page' | 'card';
  id?: string;
}

const {
  eyebrow,
  title = 'Explore Our Menu',
  subtitle,
  ctaText = '',
  ctaHref = '/menu',
  excludeHref,
  excludeHrefs = [],
  tone = 'page',
  id,
} = Astro.props;

const excluded = new Set([excludeHref, ...excludeHrefs].filter(Boolean));
const isHub = excluded.size === 0;

const cmsCategories = await getMenuCategories();

const categories = cmsCategories
  .filter((category) => category.href && !excluded.has(category.href))
  .map((category) => {
    const wide = category.hubSpan === 6;
    return {
      label: category.title,
      href: category.href!,
      description: category.description ?? '',
      img: isHub
        ? (category.image ?? category.exploreMoreImage)
        : (category.exploreMoreImage ?? category.image),
      colSpan: isHub && wide ? 'md:col-span-6' : 'md:col-span-4',
      aspect: isHub && wide ? '16 / 9' : '4 / 3',
    };
  });
---

<section
  {...id ? { id } : {}}
  class:list={['not-prose relative w-full overflow-hidden', tone === 'card' ? 'bg-card' : 'bg-page']}
  aria-label="Menu categories"
>
  <div class="mx-auto flex w-full max-w-container flex-col gap-10 px-5 py-16 sm:px-8 md:gap-16 md:px-16 md:py-[120px]">
    {/* ── Section header ───────────────────────────────────────────── */}
    <div class="flex w-full flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div class="flex max-w-[822px] flex-col gap-6">
        {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
        {title && <Heading variant="h2">{title}</Heading>}
        {
          subtitle && (
            <Text variant="body" color="default">
              {subtitle}
            </Text>
          )
        }
      </div>
      {ctaText && <Button variant="primary" text={ctaText} href={ctaHref} hideNote={true} class="shrink-0" />}
    </div>

    {/* ── Card grid ────────────────────────────────────────────────── */}
    <div class="grid w-full grid-cols-1 gap-6 md:grid-cols-12 md:gap-8">
      {
        categories.map((cat) => (
          <a
            href={cat.href}
            class:list={['group flex h-full flex-col overflow-hidden', tone === 'card' ? 'bg-page' : 'bg-card', cat.colSpan]}
          >
            <div class="relative w-full shrink-0 overflow-hidden bg-section-grey" style={`aspect-ratio: ${cat.aspect};`}>
              {cat.img?.src ? (
                <Image
                  src={cat.img.src}
                  alt={cat.img.alt || ''}
                  widths={[400, 640, 900]}
                  sizes="(max-width: 768px) 100vw, 33vw"
                  width={900}
                  height={cat.aspect === '16 / 9' ? 506 : 675}
                  layout="cover"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                />
              ) : (
                <>
                  {/* TODO: replace with <Image> when asset is ready */}
                  <HeroImagePlaceholder
                    fill
                    class="absolute inset-0 transition-transform duration-500 group-hover:scale-[1.04]"
                    label={`${cat.label} placeholder`}
                  />
                </>
              )}
            </div>

            <div class="flex flex-1 flex-col gap-3 px-6 pb-6 pt-6">
              <div class="flex items-start justify-between gap-3">
                <Heading variant="h3" as="h3">
                  {cat.label}
                </Heading>
                <span
                  class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-accent text-accent transition-[background-color,color] duration-500 ease-in-out group-hover:border-accent group-hover:bg-accent group-hover:text-white"
                  aria-hidden="true"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    class="size-3.5 transition-transform duration-500 ease-in-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 13L13 3M7 3h6v6" />
                  </svg>
                </span>
              </div>
              <Text variant="body" color="default">
                {cat.description}
              </Text>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
