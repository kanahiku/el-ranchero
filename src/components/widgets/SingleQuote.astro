---
/**
 * Single quote / pullquote card section.
 *
 * Layout (Figma 121:1715):
 *   bg-page outer, px-[120px] py-[64px]
 *   Inner card: gradient to-t from-transparent → section-grey,
 *               rounded-t-[64px], p-[64px], gap-[32px], items-center
 *   Quote mark 96×76 (mix-blend-overlay, page-cream fill), h2 quote, eyebrow attribution
 *
 * Used on the about page. Register in components.json as P-38 SingleQuote.
 */
import Heading from '~/components/ui/Heading.astro';

interface Props {
  quote: string;
  attribution: string;
  id?: string;
}

const { quote, attribution, id } = Astro.props;

/* Figma 121:1726 — 96×76, opacity 0.5, mix-blend-overlay, fill page cream */
const quoteMarkSvg = `<svg viewBox="0 0 96 76" fill="none" xmlns="http://www.w3.org/2000/svg" width="96" height="76" aria-hidden="true"><g opacity="0.5" style="mix-blend-mode:overlay"><path d="M23.0455 41.2468C29.2273 41.2468 33.9091 42.8036 37.0909 45.9172C40.2727 49.0308 41.8636 53.0144 41.8636 57.8679C41.8636 63.1793 39.9545 67.5292 36.1364 70.9175C32.3182 74.3058 27.6364 76 22.0909 76C15.7273 76 10.4545 73.7106 6.27273 69.1318C2.09091 64.553 0 57.3642 0 47.5656C0 38.3164 1.72727 30.395 5.18182 23.8015C8.72727 17.1164 13.1364 11.805 18.4091 7.86724C23.6818 3.92946 28.9545 1.41111 34.2273 0.31219C36.2273 -0.145691 37.8182 -0.0999005 39 0.449561C40.1818 0.907442 40.8636 1.77741 41.0454 3.05948C41.3182 4.24997 41.0455 5.39468 40.2273 6.4936C39.4091 7.50093 37.7273 8.50827 35.1818 9.51561C30.6364 11.2556 26.7273 13.5908 23.4545 16.5212C20.1818 19.3601 17.6818 22.4737 15.9545 25.862C14.3182 29.1587 13.5 32.3639 13.5 35.4775C13.5 37.309 13.9545 38.7284 14.8636 39.7358C15.8636 40.7431 17.6364 41.2468 20.1818 41.2468H23.0455ZM77.1818 41.2468C83.3636 41.2468 88.0454 42.8036 91.2273 45.9172C94.4091 48.9392 96 52.9228 96 57.8679C96 63.1793 94.0909 67.5292 90.2727 70.9175C86.4545 74.3058 81.7727 76 76.2273 76C69.8636 76 64.5909 73.7106 60.4091 69.1318C56.2273 64.4614 54.1364 57.2727 54.1364 47.5656C54.1364 38.3164 55.8636 30.395 59.3182 23.8015C62.8636 17.1164 67.2727 11.805 72.5455 7.86724C77.8182 3.92946 83.0909 1.41111 88.3636 0.31219C90.3636 -0.145691 91.9545 -0.0999005 93.1364 0.449561C94.3182 0.907442 95 1.77741 95.1818 3.05948C95.4545 4.1584 95.1818 5.25732 94.3636 6.35623C93.5455 7.45514 91.8636 8.50827 89.3182 9.51561C84.7727 11.2556 80.8636 13.5908 77.5909 16.5212C74.3182 19.3601 71.8636 22.4737 70.2273 25.862C68.5909 29.1587 67.7727 32.3639 67.7727 35.4775C67.7727 37.309 68.2273 38.7284 69.1364 39.7358C70.0454 40.7431 71.7727 41.2468 74.3182 41.2468H77.1818Z" fill="currentColor"/></g></svg>`;
---

<section
  class="not-prose w-full"
  {...id ? { id } : {}}
>
  <div class="mx-auto max-w-container px-5 py-10 sm:px-8 md:px-16 md:py-16 lg:px-[120px] lg:py-[64px]">
    <div class="flex flex-col items-center justify-center gap-8 rounded-t-[32px] bg-gradient-to-t from-transparent to-section-grey p-10 sm:p-12 md:rounded-t-[64px] md:p-16 lg:p-[64px]">
      <span class="h-[76px] w-[96px] shrink-0 text-contrast" set:html={quoteMarkSvg} />
      <Heading variant="h2" as="p" class="text-center">{quote}</Heading>
      <Heading variant="eyebrow">{attribution}</Heading>
    </div>
  </div>
</section>
