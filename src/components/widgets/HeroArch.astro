---
/**
 * HeroArch — Figma Hero 2083:1891. Copy left, arched image right with a
 * rotated "Desde" stamp and an agave motif. Papel picado strip sits above.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import Motif from '~/components/ui/Motif.astro';
import ImagePlaceholder from '~/components/ui/ImagePlaceholder.astro';
import type { CallToAction } from '~/types';

export interface Props {
  id?: string;
  eyebrow?: string;
  /** Use <br /> to break lines. */
  title: string;
  body?: string;
  actions?: CallToAction[];
  stamp?: { top: string; year: string; bottom: string };
  /** Photo for the arch. Omit to show the grey placeholder. */
  image?: { src: string; alt?: string };
  /** Text-only, centred layout (no arch). */
  hideImage?: boolean;
}

const { id, eyebrow, title, body, actions = [], stamp, image, hideImage = false } = Astro.props;
---

<section {...id ? { id } : {}} class="relative w-full overflow-x-clip bg-page">
  {/* Papel picado strip — Figma 2083:1869 (1440 × 76.5) */}
  <Motif name="papel-picado" class="h-[56px] w-full md:h-[76px]" />

  <div
    class="container-x flex flex-col gap-12 py-16 md:flex-row md:py-[120px] md:items-center md:gap-10 min-[1440px]:gap-16"
  >
    <div
      class:list={[
        'flex min-w-0 flex-col gap-6 md:flex-1',
        hideImage ? 'mx-auto max-w-[760px] items-center text-center' : 'items-start min-[1440px]:w-[580px] min-[1440px]:flex-none',
      ]}
    >
      {eyebrow && <Heading variant="eyebrow" class="inline-block -rotate-4 origin-left">{eyebrow}</Heading>}
      <Heading variant="h1" html={title} />
      {body && <Text variant="body-lg" class="text-tan-body" html={body} />}
      {
        actions.length > 0 && (
          <div class="flex w-full flex-col gap-4 sm:w-auto sm:flex-row sm:flex-wrap">
            {actions.map((action) => (
              <Button {...action} hideNote class="w-full sm:w-auto" />
            ))}
          </div>
        )
      }
    </div>

    {/* Hero media 556 × 680 */}
    {!hideImage && (
    <div class="relative w-full md:w-[44%] md:shrink-0 min-[1440px]:w-[556px]">
      {
        image?.src ? (
          <img
            src={image.src}
            alt={image.alt ?? ''}
            width="556"
            height="680"
            loading="eager"
            class="w-full rounded-t-full border-[3px] border-heading bg-section-grey object-cover"
            style="aspect-ratio: 556 / 680;"
          />
        ) : (
          <ImagePlaceholder ratio="556 / 680" class="rounded-t-full border-[3px] border-heading" />
        )
      }
      {
        stamp && (
          <div
            class="absolute -right-2 -top-5 flex size-[130px] rotate-12 flex-col items-center justify-center gap-0.5 rounded-full border-2 border-heading bg-marigold shadow-hard-sm md:-right-4 md:size-[170px] min-[1440px]:-right-9"
            role="img"
            aria-label={`${stamp.top} ${stamp.year} ${stamp.bottom}`}
          >
            <span class="font-button text-[11px] uppercase tracking-[0.1em] text-heading md:text-[13px]">
              {stamp.top}
            </span>
            <span class="font-rough text-[44px] leading-[0.9] text-accent md:text-[58px]">{stamp.year}</span>
            <span class="font-button text-[11px] uppercase tracking-[0.1em] text-heading md:text-[13px]">
              {stamp.bottom}
            </span>
          </div>
        )
      }
      <Motif name="agave" class="absolute -bottom-3 -right-3 h-[93px] w-[149px] md:-right-6" />
    </div>
    )}
  </div>
</section>
