---
import FormContainer from '~/components/ui/Form.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import { storeLocations } from '~/data/locations';
import type { Contact as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  inputs,
  textarea,
  disclaimer,
  button,
  description,

  id,
  classes = {},
} = Astro.props;

const hasAside = Astro.slots.has('aside');

---

<section {...id ? { id } : {}} class="not-prose w-full scroll-mt-[72px] bg-page">
  <div class:list={['mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]', classes?.container]}>
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-16">
      <aside
        class:list={[
          'relative z-[1] flex h-full min-w-0 select-text flex-col gap-8',
          !hasAside && 'bg-section-dark px-6 py-8 md:px-10 md:py-12',
        ]}
      >
        {
          hasAside ? (
            <slot name="aside" />
          ) : (
            <>
              <div class="flex flex-col gap-4">
                <Heading variant="eyebrow" color="white" class="text-contrast/55">El Ranchero</Heading>
                <Heading variant="h2" color="white">Our Restaurants</Heading>
                <Text variant="body-lg" color="white" class="max-w-md text-contrast/65">
                  Call Wahiawa or Kapolei, or send a message and our team will follow up.
                </Text>
              </div>

              <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
                {
                  storeLocations.map((store) => (
                    <div class="flex flex-col gap-2 border-t border-contrast/15 pt-5">
                      <Heading variant="eyebrow" color="white" class="text-contrast/55">
                        {store.name}
                      </Heading>
                      <a
                        href={store.phoneHref}
                        class="font-sans text-body-lg text-contrast transition-opacity hover:opacity-80"
                      >
                        {store.phoneDisplay}
                      </a>
                      <address class="not-italic">
                        <Text variant="body" color="white" as="span" class="block">
                          {store.addressLine1}
                        </Text>
                        <Text variant="body" color="white" as="span" class="block text-contrast/70">
                          {store.addressLine2}
                        </Text>
                      </address>
                    </div>
                  ))
                }
              </div>
            </>
          )
        }
      </aside>

      <div class="relative z-[1] flex h-full min-w-0 select-text flex-col bg-card px-6 py-8 shadow-card-mist md:px-10 md:py-12">
        <div class="mb-8 flex flex-col gap-4">
          {title && <Heading variant="h2" html={title} />}
          {subtitle && <Text variant="body-lg" color="muted" class="max-w-2xl" html={subtitle} />}
        </div>

        {
          inputs && (
            <FormContainer
              inputs={inputs}
              textarea={textarea}
              disclaimer={disclaimer}
              button={button}
              description={description}
            />
          )
        }
      </div>
    </div>

  </div>
</section>
