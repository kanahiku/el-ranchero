---
/**
 * MediaAppearances — "As Seen In" horizontal-scroll carousel.
 * Figma node 121:566.
 *
 * Visual spec:
 *   Light bg-page section.
 *   Centered header: eyebrow + h2 + subtitle.
 *   Horizontal marquee of appearance cards — same CSS animation as Testimonials.
 *   Each card: italic Fraunces quote + book cover placeholder on right.
 *   Edge fade mask. Pauses on hover.
 *   Optional CTA button below the track.
 *
 * Props:
 *   eyebrow      — small uppercase label
 *   heading      — section h2
 *   subtitle     — short body line below heading
 *   appearances  — array of { quote } items
 *   cta          — { text, href } optional CTA button
 *   id           — section anchor
 */
import Heading from '~/components/ui/Heading.astro';
import Button from '~/components/ui/Button.astro';

export interface AppearanceItem {
  quote: string;
}

export interface Props {
  eyebrow?: string;
  heading?: string;
  subtitle?: string;
  appearances?: AppearanceItem[];
  cta?: { text: string; href: string };
  id?: string;
}

const {
  eyebrow,
  heading,
  subtitle,
  appearances = [],
  cta,
  id,
} = Astro.props;

// Duplicate for seamless loop: translate -50% = one full set → perfect join
const doubled = [...appearances, ...appearances];
---

<section
  {...id ? { id } : {}}
  class="not-prose w-full overflow-hidden py-16 md:py-[120px] flex flex-col items-center gap-10 md:gap-16"
>
  <!-- Centered header -->
  <div class="w-full max-w-container px-5 sm:px-8 md:px-16 lg:px-[120px] flex flex-col items-center gap-4 text-center">
    {eyebrow && (
      <Heading variant="eyebrow">{eyebrow}</Heading>
    )}
    {heading && (
      <Heading variant="h2">{heading}</Heading>
    )}
    {subtitle && (
      <p class="font-sans text-body text-muted">{subtitle}</p>
    )}
  </div>

  <!-- Marquee track with edge fade mask -->
  {doubled.length > 0 && (
    <div class="appearances-mask w-full" aria-live="off">
      <div class="appearances-track flex items-stretch gap-8">
        {doubled.map((item) => (
          <div class="appearances-slide shrink-0 w-[min(20rem,calc(100vw-2.5rem))] md:w-[512px]">
            <!-- Appearance card: gradient bg + quote left + book cover right -->
            <div
              class="relative flex items-stretch overflow-hidden rounded-[16px] shadow-[4px_4px_30px_0px_rgba(0,0,0,0.05)] h-full"
              style="background: linear-gradient(to top, transparent, rgba(210,225,234,0.6))"
            >
              <!-- Quote -->
              <div class="flex flex-1 items-center px-4 py-3">
                <p class="font-heading italic text-[22px] leading-[1.2] text-heading">
                  {item.quote}
                </p>
              </div>
              <!-- Book cover placeholder -->
              <!-- TODO: replace with <Image> when asset is ready -->
              <div
                class="shrink-0 bg-section-grey rounded-br-[16px] rounded-tr-[16px]"
                style="width: 102px; height: 152px;"
                aria-hidden="true"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- CTA button -->
  {cta && (
    <Button
      variant="primary"
      text={cta.text}
      href={cta.href}
      hideNote={true}
    />
  )}
</section>

<style>
  /* Edge fade mask */
  .appearances-mask {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 24px,
      black calc(100% - 24px),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 24px,
      black calc(100% - 24px),
      transparent 100%
    );
  }

  @media (min-width: 768px) {
    .appearances-mask {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        black 80px,
        black calc(100% - 80px),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        black 80px,
        black calc(100% - 80px),
        transparent 100%
      );
    }
  }

  /* Marquee: translate -50% = one full set → seamless loop */
  @keyframes marquee-appearances {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .appearances-track {
    width: max-content;
    animation: marquee-appearances 35s linear infinite;
  }

  /* Pause on hover */
  .appearances-mask:hover .appearances-track {
    animation-play-state: paused;
  }

  /* Equal-height cards */
  .appearances-slide {
    height: auto;
    display: flex;
    flex-direction: column;
  }
  .appearances-slide > * {
    flex: 1;
  }
</style>
