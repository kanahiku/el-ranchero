---
/**
 * LocationDirectory — six-store listing for the locations hub
 * (and later location subpages via excludeHref).
 *
 * Card language matches homepage Locations: blueberry surface, cream type,
 * pin + white “View Location” pill (same primary CTA as StoreVisit). Hours stay off this widget on purpose so
 * visitors click through to each store page.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import { storeLocations } from '~/data/locations';

export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  excludeHref?: string;
  excludeHrefs?: string[];
  id?: string;
}

const {
  eyebrow,
  title = 'Find a Fresh, Local Meal Near You',
  subtitle,
  excludeHref,
  excludeHrefs = [],
  id,
} = Astro.props;

const hidden = new Set([excludeHref, ...excludeHrefs].filter(Boolean));
const locations = storeLocations.filter((store) => !hidden.has(store.href));
---

<section {...id ? { id } : {}} class="not-prose relative w-full overflow-hidden bg-page" aria-label="Store locations">
  <div
    class="relative z-[1] mx-auto flex w-full max-w-container flex-col gap-10 px-5 pb-10 pt-16 sm:px-8 md:gap-16 md:px-16 md:pb-16 md:pt-[120px]"
  >
    <div class="flex max-w-[822px] flex-col items-start gap-6">
      {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
      {title && <Heading variant="h2">{title}</Heading>}
      {
        subtitle && (
          <Text variant="body-lg" color="inherit" class="text-heading">
            {subtitle}
          </Text>
        )
      }
    </div>

    <div class="grid w-full grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        locations.map((loc) => (
          <article class="flex h-full flex-col gap-6 bg-section-dark px-4 pb-4 pt-6">
            <div class="flex flex-1 flex-col gap-4">
              <Heading variant="h3" color="white">
                {loc.name}
              </Heading>
              <Text variant="small" color="white" class="text-contrast/80">
                {loc.intro}
              </Text>
              <address class="not-italic text-contrast">
                <Text variant="small" color="white" as="span" class="block tracking-[-0.01em]">
                  {loc.shopName}
                </Text>
                <Text variant="small" color="white" as="span" class="block tracking-[-0.01em]">
                  {loc.addressLine1}
                </Text>
                <Text variant="small" color="white" as="span" class="block tracking-[-0.01em]">
                  {loc.addressLine2}
                </Text>
                {loc.landmark && (
                  <Text variant="small" color="white" as="span" class="block tracking-[-0.01em] text-contrast/70">
                    {loc.landmark}
                  </Text>
                )}
              </address>
              <a
                href={loc.phoneHref}
                class="font-sans text-small tracking-[-0.01em] text-contrast transition-opacity hover:opacity-80"
              >
                {loc.phoneDisplay}
              </a>
            </div>

            <a
              href={loc.href}
              class="btn-primary mt-auto w-full gap-2.5"
            >
              <svg
                width="13"
                height="18"
                viewBox="0 0 13 18"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
                class="shrink-0"
              >
                <path
                  d="M6.5 0C2.91 0 0 2.91 0 6.5C0 11.375 6.5 18 6.5 18C6.5 18 13 11.375 13 6.5C13 2.91 10.09 0 6.5 0ZM6.5 8.75C5.26 8.75 4.25 7.74 4.25 6.5C4.25 5.26 5.26 4.25 6.5 4.25C7.74 4.25 8.75 5.26 8.75 6.5C8.75 7.74 7.74 8.75 6.5 8.75Z"
                  fill="currentColor"
                />
              </svg>
              <span>View Location</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
