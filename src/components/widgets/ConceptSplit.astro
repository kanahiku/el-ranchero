---
/**
 * ConceptSplit — intro + 2×2 topic cards + image (Figma 62:71 / 62:553 / 62:77).
 *
 * Visual spec:
 *   bg-page, px/py 120.
 *   TOP (gap 64px): 2-col items-start
 *     LEFT  — 28px Fraunces heading
 *     RIGHT — body slot + optional primary CTA (gap 32px)
 *   BOTTOM (gap 32px): 2-col items-start
 *     LEFT  — 2×2 Card variant="pillar" grid (gap 32px)
 *     RIGHT — image slot (grey placeholder until the asset is ready)
 *
 * Content is passed from the page file — never baked in.
 */
import Card from '~/components/ui/Card.astro';
import Button from '~/components/ui/Button.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';

export interface ConceptCardItem {
  label: string;
  title: string;
  description: string;
}

export interface Props {
  heading: string;
  cta?: { text: string; href: string };
  cards?: ConceptCardItem[];
  id?: string;
}

const { heading, cta, cards = [], id } = Astro.props;
---

<section {...id ? { id } : {}} class="not-prose w-full">
  <div class="mx-auto flex w-full max-w-container flex-col gap-12 px-5 py-12 sm:px-8 md:gap-16 md:px-16 md:py-16 lg:gap-16 lg:px-[120px] lg:py-[120px]">

    {/* ── TOP — heading | body + CTA (Figma 62:553) ── */}
    <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-16">
      <div class="min-w-0 flex-1">
        <Heading variant="h4" as="h2">{heading}</Heading>
      </div>
      <div class="flex min-w-0 flex-1 flex-col items-start gap-8">
        <slot />
        {cta && (
          <Button variant="primary" text={cta.text} href={cta.href} hideNote />
        )}
      </div>
    </div>

    {/* ── BOTTOM — 2×2 cards | image (Figma 62:77) ── */}
    <div class="flex flex-col gap-8 lg:flex-row lg:items-start">
      {cards.length > 0 && (
        <div class="grid min-w-0 flex-1 grid-cols-1 gap-8 sm:grid-cols-2">
          {cards.map((card) => (
            <Card variant="pillar" label={card.label} class="h-full">
              <Heading variant="h4" color="inherit" class="text-primary" as="p">
                {card.title}
              </Heading>
              <Text variant="small">{card.description}</Text>
            </Card>
          ))}
        </div>
      )}

      <div class="min-w-0 flex-1">
        <slot name="image">
          {/* TODO: replace with <Image> when asset is ready */}
          <div
            class="w-full rounded-[32px] bg-section-grey"
            style="aspect-ratio: 1695 / 928;"
            aria-hidden="true"
          />
        </slot>
      </div>
    </div>

  </div>
</section>
