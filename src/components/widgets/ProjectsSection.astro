---
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';

export interface Project {
  title: string;
  description?: string;
  location?: string;
  material?: string;
  image?: {
    src: string;
    alt: string;
  };
}

export interface Props {
  title?: string;
  subtitle?: string;
  projects?: Project[];
  columns?: 2 | 3;
  showCta?: boolean;
  ctaText?: string;
  ctaHref?: string;
  isDark?: boolean;
  id?: string;
  classes?: Record<string, string>;
  bg?: string;
}

const {
  title = '',
  subtitle = '',
  projects = [],
  columns = 3,
  showCta = true,
  ctaText = 'Read Our Story',
  ctaHref = '/about/our-story',
  isDark = false,
  id,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// Grid columns class
const gridClass = columns === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-3';

// Card styling based on isDark
const cardBg = isDark ? 'bg-projects-card-dark' : 'bg-projects-card-light';
const cardBorder = isDark ? 'border-projects-card-dark' : 'border-projects-card-light';
const titleColor = isDark ? 'text-projects-title-dark' : 'text-projects-title-light';
const descColor = isDark ? 'text-projects-desc-dark' : 'text-projects-desc-light';
const placeholderBg = isDark ? 'bg-black/40' : 'bg-gray-100 dark:bg-slate-800';
const placeholderText = isDark ? 'text-white/20' : 'text-gray-300 dark:text-slate-600';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-container mx-auto ${classes?.container ?? ''}`} bg={bg}>
  {(title || subtitle) && (
    <Headline title={title} subtitle={subtitle} isDark={isDark} classes={classes?.headline} />
  )}

  <div class={`grid grid-cols-1 ${gridClass} gap-4 md:gap-6`}>
    {projects.map((project) => (
      <div class={`rounded-lg border ${cardBorder} ${cardBg} p-4 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter`}>
        {project.image ? (
          <Image
            class="w-full h-36 object-cover rounded mb-3"
            width={400}
            height={144}
            format="webp"
            src={project.image.src}
            alt={project.image.alt}
          />
        ) : (
          <div class={`w-full h-36 ${placeholderBg} rounded mb-3 flex items-center justify-center ${placeholderText}`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        )}
        {project.location && (
          <p class={`text-[13px] md:text-[14px] font-medium ${titleColor} mb-1`}>
            {project.location}
          </p>
        )}
        {project.title && (
          <p class={`text-[15px] md:text-[16px] font-medium ${titleColor} mb-1`}>
            {project.title}
          </p>
        )}
        {project.material && (
          <p class={`text-[13px] md:text-[14px] font-medium ${descColor} mb-1`}>
            <span class={`font-semibold ${isDark ? 'text-white/80' : ''}`}>Material:</span> {project.material}
          </p>
        )}
        {project.description && (
          <p class={`text-[13px] md:text-[14px] font-normal leading-[160%] ${descColor}`}>
            {project.description}
          </p>
        )}
      </div>
    ))}
  </div>

  {showCta && ctaText && ctaHref && (
    <div class="mt-8 md:mt-10">
      <Button
        variant={isDark ? 'ghost' : 'secondary'}
        tone={isDark ? 'dark' : undefined}
        text={ctaText}
        href={ctaHref}
        hideNote={true}
      />
    </div>
  )}
</WidgetWrapper>
