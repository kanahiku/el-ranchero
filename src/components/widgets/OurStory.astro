---
/**
 * OurStory — Homepage 59:1765.
 * Full-bleed dark blueberry story section centered content,
 * staggered action cards, and a polaroid-style photo placeholder + CTA.
 */
import Button from '~/components/ui/Button.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import basketIcon from '~/assets/icons/Shopping-Basket-Like--Streamline-Freehand.svg?url';
import locationIcon from '~/assets/icons/Worldwide-Web-Location-Pin--Streamline-Freehand.svg?url';
import onlineShopIcon from '~/assets/icons/E-Commerce-Online-Shop--Streamline-Freehand.svg?url';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';

export interface StoryAction {
  title: string;
  description: string;
  iconLabel: string;
  href?: string;
}

export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  actions?: StoryAction[];
  id?: string;
}

const {
  eyebrow = 'Our story',
  title = 'Kailua roots, island-wide.',
  subtitle =
    "We opened in Kailua in 2006 with one idea: fresh, healthy food should taste worth coming back for — and feel like home. Six locations later, that is still the whole plan.",
  ctaText = 'read our story',
  ctaHref = '/about',
  actions = [
    {
      title: 'order online',
      description: 'Pickup or delivery from any store',
      iconLabel: 'online shop icon',
      href: '/order-online',
    },
    {
      title: 'find location',
      description: "Six spots across Oahu.",
      iconLabel: 'location pin icon',
      href: '/locations',
    },
    {
      title: 'Order Catering',
      description: 'Fresh trays for any group',
      iconLabel: 'shopping basket icon',
      href: '/catering',
    },
  ],
  id,
} = Astro.props;

const actionIconUrls = [onlineShopIcon, locationIcon, basketIcon];
---

<section
  {...id ? { id } : {}}
  class="not-prose relative w-full overflow-hidden bg-section-dark"
>

  <div class="relative mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-24 lg:p-24">
      <div class="grid items-start gap-12 md:grid-cols-2 md:gap-16">
        <div class="flex min-w-0 flex-col gap-12 md:gap-16">
          <div class="flex flex-col items-start gap-6">
            {eyebrow && (
              <Heading variant="eyebrow" color="inherit" class="text-heading mix-blend-overlay opacity-80">
                {eyebrow}
              </Heading>
            )}
            {title && <Heading variant="h2" color="white">{title}</Heading>}
            {subtitle && <Text variant="body-lg" color="white">{subtitle}</Text>}
          </div>

          <div class="flex w-full flex-col gap-6">
            {actions.map((action, index) => {
              const Tag = action.href ? 'a' : 'article';
              return (
              <Tag
                href={action.href}
                class:list={[
                  'w-full shrink-0 border-8 border-[color:var(--aw-color-bg-card-dark)] bg-page p-6 sm:w-fit',
                  index === 1 && 'sm:self-end',
                  action.href && 'transition-opacity hover:opacity-90',
                ]}
              >
                <div class="flex items-center gap-3">
                  <div
                    class="size-[47px] shrink-0 bg-heading"
                    style={`-webkit-mask-image: url('${actionIconUrls[index] ?? basketIcon}'); mask-image: url('${actionIconUrls[index] ?? basketIcon}'); -webkit-mask-size: contain; mask-size: contain; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-position: center; mask-position: center;`}
                    aria-label={action.iconLabel}
                  ></div>
                  <div class="flex min-w-0 flex-col justify-center gap-2">
                    <Heading variant="h3" as="p">{action.title}</Heading>
                    <Text color="default">{action.description}</Text>
                  </div>
                </div>
              </Tag>
              );
            })}
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-[560px] bg-page p-4 pb-8 shadow-[-11px_20px_22px_0_rgb(0_0_0_/_5%)] md:pb-8">
          <div class="w-full overflow-hidden bg-section-grey" style="aspect-ratio: 515 / 515;">
            <!-- TODO: replace with <Image> when asset is ready -->
            <HeroImagePlaceholder fill class="h-full w-full" label="El Ranchero story placeholder" />
          </div>

          <div class="mt-7 flex justify-center">
            <Button variant="primary" text={ctaText} href={ctaHref} hideNote={true} />
          </div>
        </div>
      </div>
  </div>
</section>
