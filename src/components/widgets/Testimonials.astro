---
/**
 * Testimonials — Homepage 59:438. "Loved across the island."
 *
 * Visual spec:
 *   bg-page (cream #EFE9DE). Centered eyebrow + h2 header.
 *   Horizontal CSS marquee of review cards (450px each), gap-3.
 *   Edge fade: CSS mask fades at left + right.
 *   Pauses on hover.
 *
 * Card anatomy (bg-card #FAF4E8, p-4, gap-5):
 *   1. Platform logo (Google / Yelp) + 5-star row (rotate −1.82°)
 *   2. Wreck-Script 22px quote (rotate −2.21°)
 *   3. Right-aligned attribution: Norca name (heading) + location (accent) (rotate −2.17°)
 *
 * Implementation:
 *   Cards duplicated for seamless loop: CSS translate −50% = one full set → perfect join.
 *   No JavaScript. 100% GPU-accelerated.
 */

import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import TestimonialCard from '~/components/ui/TestimonialCard.astro';
import { getTestimonials } from '~/lib/content';

export type ReviewPlatform = 'google' | 'yelp';

export interface TestimonialItem {
  quote: string;
  name: string;
  location: string;
  platform?: ReviewPlatform;
}

export interface Props {
  eyebrow?: string;
  heading?: string;
  /** Optional line under the heading. */
  subtitle?: string;
  /** Optional small note under the cards. */
  footnote?: string;
  /** Optional buttons under the cards (e.g. "Read Google reviews"). External links open in a new tab. */
  actions?: { text: string; href: string }[];
  /** Pass testimonials explicitly to skip the Sanity fetch (e.g. in Storybook/tests). */
  testimonials?: TestimonialItem[];
  /** marquee (default, scrolling strip) or grid (all reviews, masonry columns). */
  layout?: 'marquee' | 'grid';
  /** Section background for the grid layout. */
  tone?: 'page' | 'card';
  id?: string;
}

const {
  eyebrow = 'Reviews',
  heading = 'Loved across the island.',
  subtitle,
  footnote,
  actions = [],
  testimonials: propTestimonials,
  layout = 'marquee',
  tone = 'page',
  id,
} = Astro.props;

// Testimonials are managed in Sanity; props override them (Storybook/tests).
const testimonials: TestimonialItem[] =
  propTestimonials ??
  (await getTestimonials()).map(({ quote, name, location, platform }) => ({
    quote,
    name,
    location: location ?? '',
    platform,
  }));

// Seamless loop: the track shows two identical halves and slides by exactly one half.
// Each half must be wider than the widest screen (~2400px of 462px cards), so short
// lists (a few reviews) are repeated until it is.
const CARD_PITCH = 462;
const repeatsPerHalf = testimonials.length ? Math.max(1, Math.ceil(2400 / (testimonials.length * CARD_PITCH))) : 0;
const half = Array.from({ length: repeatsPerHalf }, () => testimonials).flat();
const doubled = layout === 'grid' ? [] : [...half, ...half];
---

<section
  {...id ? { id } : {}}
  class:list={['not-prose relative w-full overflow-hidden py-16 md:py-[120px]', tone === 'card' ? 'bg-section-grey' : 'bg-page']}
>
  {/* ── Centered header ── */}
  <div class="mx-auto w-full max-w-container px-5 sm:px-8 md:px-16">
    <div class="flex flex-col items-center gap-6 text-center">
      {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
      {heading && <Heading variant="h2">{heading}</Heading>}
      {
        subtitle && (
          <Text variant="body" color="default" class="max-w-2xl">
            {subtitle}
          </Text>
        )
      }
    </div>
  </div>

  {
    layout === 'grid' && (
      <div class="mx-auto mt-10 w-full max-w-container px-5 sm:px-8 md:mt-16 md:px-16" aria-label="Customer reviews">
        <div class="columns-1 gap-3 md:columns-2 xl:columns-3">
          {testimonials.map((item) => (
            <TestimonialCard
              class="mb-3 break-inside-avoid"
              quote={item.quote}
              name={item.name}
              location={item.location}
              platform={item.platform}
            />
          ))}
        </div>
      </div>
    )
  }

  {/* ── Marquee track ── */}
  <div class:list={['t-mask mt-10 md:mt-16', layout === 'grid' && 'hidden']} aria-label="Customer reviews">
    <div class="t-track flex items-stretch gap-3">
      {
        doubled.map((item) => (
          <TestimonialCard
            class="t-slide h-[244px] w-[min(85vw,450px)] shrink-0"
            quote={item.quote}
            name={item.name}
            location={item.location}
            platform={item.platform}
          />
        ))
      }
    </div>
  </div>

  {
    (footnote || actions.length > 0) && (
      <div class="mx-auto mt-10 flex w-full max-w-container flex-col items-center gap-6 px-5 text-center sm:px-8 md:mt-14 md:px-16">
        {footnote && (
          <Text variant="small" color="muted" class="max-w-2xl">
            {footnote}
          </Text>
        )}
        {actions.length > 0 && (
          <div class="flex flex-col items-center gap-3 sm:flex-row">
            {actions.map((action) => (
              <Button
                variant="ghost"
                tone="light"
                text={action.text}
                href={action.href}
                target={/^https?:/.test(action.href) ? '_blank' : undefined}
                hideNote={true}
              />
            ))}
          </div>
        )}
      </div>
    )
  }
</section>

<style>
  /* Edge fade mask */
  .t-mask {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 24px, black calc(100% - 24px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, black 24px, black calc(100% - 24px), transparent 100%);
  }

  @media (min-width: 768px) {
    .t-mask {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        black 80px,
        black calc(100% - 80px),
        transparent 100%
      );
      mask-image: linear-gradient(to right, transparent 0, black 80px, black calc(100% - 80px), transparent 100%);
    }
  }

  /* Marquee: translate exactly -50% → one full set → seamless loop */
  @keyframes t-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .t-track {
    width: max-content;
    animation: t-marquee 50s linear infinite;
  }

  .t-mask:hover .t-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .t-track {
      animation: none;
    }
  }
</style>
