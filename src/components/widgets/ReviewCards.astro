---
/**
 * ReviewCards — Figma "Reviews" 2083:2467. Centred header, three framed review
 * cards, calavera motifs top-left / top-right. Reviews come from Sanity
 * (`getTestimonials`); pass `reviews` to override.
 */
import Heading from '~/components/ui/Heading.astro';
import Motif from '~/components/ui/Motif.astro';
import { getTestimonials } from '~/lib/content';

export interface Review {
  quote: string;
  name: string;
  source: string;
}

export interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  reviews?: Review[];
  /** Shown only when Sanity returns nothing. */
  fallback?: Review[];
  limit?: number;
}

const { id, eyebrow, title, reviews, fallback = [], limit = 3 } = Astro.props;

const platformLabel = { google: 'Google', yelp: 'Yelp' } as const;
let items: Review[] = reviews ?? [];
if (!reviews) {
  const fromSanity = await getTestimonials().catch(() => []);
  items = fromSanity.map((t) => ({
    quote: t.quote,
    name: t.name,
    source: [t.platform ? platformLabel[t.platform] : '', t.location].filter(Boolean).join(' · '),
  }));
  if (!items.length) items = fallback;
}
items = items.slice(0, limit);
---

{
  items.length > 0 && (
    <section {...id ? { id } : {}} class="relative w-full overflow-hidden bg-page">
      <Motif name="calavera-large" class="absolute right-[30px] top-[70px] hidden h-[231px] w-[217px] xl:block" />
      <Motif name="calavera-small" class="absolute left-[110px] top-[90px] hidden h-[138px] w-[129px] xl:block" />

      <div class="container-x relative flex flex-col items-center gap-10 py-16 md:gap-12 md:py-[120px]">
        <div class="flex flex-col items-center gap-2 text-center">
          {eyebrow && <Heading variant="eyebrow" class="inline-block rotate-3">{eyebrow}</Heading>}
          <Heading variant="h2" html={title} />
        </div>

        <ul class="grid w-full grid-cols-1 gap-7 md:grid-cols-3">
          {
            items.map((r) => (
              <li class="flex h-full flex-col items-start gap-3.5 border-[1.5px] border-heading bg-card p-7">
                <p class="text-[20px] leading-none text-marigold" aria-label="5 out of 5 stars">★★★★★</p>
                <p class="font-rough text-[72px] leading-[0.6] text-accent" aria-hidden="true">“</p>
                <p class="text-[17px] leading-[1.55] text-heading">{r.quote}</p>
                <p class="type-label mt-auto text-heading">{r.name}</p>
                <p class="text-[13px] font-semibold text-accent">{r.source}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  )
}
