---
/**
 * Locations — Homepage 59:155.
 * bg-page cream. 2-col: left = intro header + 2×2 location cards /
 * right = square photo placeholder.
 *
 * Location card: bg-section-dark (blueberry) pill with name + address row
 * and a bg-card-dark "View store" link with inline pin icon.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import { storeLocations } from '~/data/locations';
import type { ContentImage } from '~/lib/content/types';

export interface Location {
  name: string;
  shopName: string;
  addressLine1: string;
  addressLine2: string;
  href?: string;
}

export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  locations?: Location[];
  image?: ContentImage;
  id?: string;
}

const {
  eyebrow = 'Locations',
  title = 'Six spots across O\u2019ahu.',
  subtitle = 'Dine in, grab and go, or order ahead. There\u2019s an El Ranchero closer than you think.',
  ctaText = 'view all locations',
  ctaHref = '/locations',
  locations = storeLocations.slice(0, 4).map((store) => ({
    name: store.name,
    shopName: store.shopName,
    addressLine1: store.addressLine1,
    addressLine2: store.addressLine2,
    href: store.href,
  })),
  image,
  id,
} = Astro.props;
---

<section {...id ? { id } : {}} class="not-prose relative w-full overflow-hidden bg-section-grey">
  <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
    <div class="flex flex-col gap-8 md:flex-row md:gap-8">
      {/* Left column — header + location cards */}
      <div class="flex min-w-0 flex-1 flex-col gap-16">
        {/* Header block */}
        <div class="flex flex-col items-start gap-6">
          {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
          {title && <Heading variant="h2">{title}</Heading>}
          {
            subtitle && (
              <Text variant="body-lg" color="default">
                {subtitle}
              </Text>
            )
          }
          {ctaText && <Button variant="primary" text={ctaText} href={ctaHref} hideNote={true} />}
        </div>

        {/* 2 × 2 location cards */}
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {
            locations.map((loc) => (
              <div class="flex h-full flex-col gap-6 bg-section-dark px-4 pb-4 pt-6">
                {/* Name + address row */}
                <div class="flex w-full flex-1 items-start justify-between gap-2 text-contrast">
                  <Heading variant="h3" color="white" as="p">
                    {loc.name}
                  </Heading>
                  <div class="text-right leading-[1.3]">
                    <Text variant="small" color="white" as="span" class="block tracking-[-0.01em]">
                      {loc.shopName}
                    </Text>
                    <Text variant="small" color="white" as="span" class="block tracking-[-0.01em]">
                      {loc.addressLine1}
                    </Text>
                    <Text variant="small" color="white" as="span" class="block tracking-[-0.01em]">
                      {loc.addressLine2}
                    </Text>
                  </div>
                </div>

                {/* View store button */}
                <a
                  href={loc.href ?? ctaHref}
                  class="mt-auto flex w-full items-center justify-center gap-2.5 bg-card px-4 py-3 text-heading transition-opacity hover:opacity-80"
                >
                  {/* Location pin icon */}
                  <svg
                    width="13"
                    height="18"
                    viewBox="0 0 13 18"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    class="shrink-0"
                  >
                    <path
                      d="M6.5 0C2.91 0 0 2.91 0 6.5C0 11.375 6.5 18 6.5 18C6.5 18 13 11.375 13 6.5C13 2.91 10.09 0 6.5 0ZM6.5 8.75C5.26 8.75 4.25 7.74 4.25 6.5C4.25 5.26 5.26 4.25 6.5 4.25C7.74 4.25 8.75 5.26 8.75 6.5C8.75 7.74 7.74 8.75 6.5 8.75Z"
                      fill="currentColor"
                    />
                  </svg>
                  <span class="font-heading text-button leading-none">View {loc.name}</span>
                </a>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="w-full self-stretch overflow-hidden bg-section-grey md:aspect-square md:w-auto md:flex-1"
        style="aspect-ratio: 1 / 1;"
      >
        {
          image ? (
            <Image
              {...image}
              class="h-full w-full object-cover"
              widths={[400, 640, 828, 1080]}
              sizes="(max-width: 768px) 100vw, 50vw"
              loading="lazy"
              width={720}
              height={720}
              layout="cover"
              format="webp"
            />
          ) : (
            <HeroImagePlaceholder fill class="h-full w-full" label="El Ranchero locations placeholder" />
          )
        }
      </div>
    </div>
  </div>
</section>
