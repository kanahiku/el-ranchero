---
/**
 * CateringSubNav — "More Catering Options" editorial index.
 *
 * Appears at the bottom of every catering sub-page, just before FAQs.
 * Pass excludeHref to suppress the current page from the list.
 *
 * Design: full-width ruled rows with large Norca Rough occasion names,
 * ghosted counter, and a right-aligned arrow. Hover fills the row in
 * section-dark (blueberry) and flips text to cream — editorial & premium.
 */
import Heading from '~/components/ui/Heading.astro';

export interface Props {
  /** Href of the current sub-page — omitted from the list. */
  excludeHref?: string;
  subtitle?: string;
  id?: string;
}

const { excludeHref, subtitle, id } = Astro.props;

const ALL_OPTIONS = [
  { label: 'Corporate Catering',    href: '/catering/corporate' },
  { label: 'Office Lunch Catering', href: '/catering/office-lunches' },
  { label: 'Meeting Catering',      href: '/catering/meetings' },
  { label: 'Event Catering',        href: '/catering/events' },
  { label: 'Party Catering',        href: '/catering/parties' },
  { label: 'School Catering',       href: '/catering/schools' },
  { label: 'Large Group Catering',  href: '/catering/large-groups' },
];

const options = ALL_OPTIONS.filter((o) => o.href !== excludeHref);
---

<section
  {...id ? { id } : {}}
  class="not-prose relative w-full overflow-hidden bg-section-grey"
  aria-label="More catering options"
>
  <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">

    {/* Header */}
    <div class="mb-10 flex max-w-2xl flex-col gap-3 md:mb-12">
      <Heading variant="eyebrow">Explore more</Heading>
      <Heading variant="h2">More Catering Options</Heading>
      {subtitle && (
        <p class="font-sans text-[16px] leading-[1.3] tracking-[-0.01em] text-muted">
          {subtitle}
        </p>
      )}
    </div>

    {/* Editorial index rows — contained in max-width */}
    <ul role="list" class="w-full border-t border-heading/15">
      {options.map((opt, i) => (
        <li class="border-b border-heading/15">
          <a
            href={opt.href}
            class="group flex w-full items-center gap-6 py-5 md:py-6"
          >
            {/* Ghosted counter */}
            <span
              class="w-10 shrink-0 font-rough text-[15px] leading-none text-heading/30 transition-colors duration-200 md:w-14"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>

            {/* Occasion name */}
            <span class="flex-1 font-rough text-[26px] leading-tight text-heading transition-colors duration-200 group-hover:text-accent md:text-[36px] lg:text-[44px]">
              {opt.label}
            </span>

            {/* Arrow */}
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-heading/25 text-heading/50 transition-all duration-200 group-hover:border-accent group-hover:text-accent md:h-12 md:w-12"
              aria-hidden="true"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" class="size-4 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13L13 3M7 3h6v6" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>

  </div>
</section>
