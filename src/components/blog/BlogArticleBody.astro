---
import BlogArticleImage from '~/components/blog/BlogArticleImage.astro';
import BlogLegacySections from '~/components/blog/BlogLegacySections.astro';
import BlogPortableBlocks from '~/components/blog/BlogPortableBlocks.astro';
import { getUnmatchedInlineImages, shouldUsePortableBody } from '~/lib/content/blogArticle';
import type { BlogPost } from '~/lib/content/types';

export interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const usePortableBody = shouldUsePortableBody(post);
const unmatchedImages = usePortableBody ? [] : getUnmatchedInlineImages(post);
---

<style>
  /*
   * Styles for inline HTML injected via set:html (marks from Sanity portable text).
   * Scoped Tailwind classes dont apply to dynamically injected markup,
   * so we target these with plain CSS inside the article wrapper.
   */
  div :global(a:not(.btn-primary):not(.btn-ghost-light):not(.btn-ghost-dark):not(.btn-secondary):not(.btn-link)) {
    color: var(--aw-color-btn-link);
    font-weight: 600;
    text-decoration: none;
    text-underline-offset: 2px;
    transition: color 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  div :global(a:not(.btn-primary):not(.btn-ghost-light):not(.btn-ghost-dark):not(.btn-secondary):not(.btn-link):hover) {
    color: var(--aw-color-btn-link-hover);
    text-decoration: underline;
  }
  div :global(a.btn-ghost-light:hover),
  div :global(a.btn-primary:hover) {
    color: white;
    text-decoration: none;
  }
  div :global(td strong),
  div :global(th strong) {
    font-weight: 700;
  }
  div :global(strong) {
    font-weight: 600;
    color: var(--aw-color-text-blog);
  }
  div :global(code) {
    background-color: rgb(237 217 116 / 50%);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
  div :global(details > summary::-webkit-details-marker) {
    display: none;
  }
</style>

<div class="min-w-0">
  {usePortableBody ? <BlogPortableBlocks post={post} /> : <BlogLegacySections post={post} />}

  {unmatchedImages.map((imageBlock) => <BlogArticleImage image={imageBlock.image} caption={imageBlock.caption} />)}
</div>

{
  post.contentBlocks?.some((block) => block._type === 'yelpReview') && (
    <script is:inline async src="https://www.yelp.com/embed/widgets.js"></script>
  )
}
