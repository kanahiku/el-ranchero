---
import Image from '~/components/common/Image.astro';
import type { ContentImage } from '~/lib/content/types';

export interface Props {
  image?: ContentImage;
  caption?: string;
  eager?: boolean;
  class?: string;
}

const { image, caption, eager = false, class: className = 'my-8' } = Astro.props;
---

{
  image?.src && (
    <figure class={className}>
      <Image
        src={image.src}
        alt={image.alt}
        class="w-full h-auto rounded-md"
        widths={[400, 768, 1200, 1600]}
        sizes="(max-width: 768px) 100vw, 720px"
        layout="full-width"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      {caption && (
        <figcaption class="mt-3 text-[14px] md:text-[15px] font-normal leading-[160%] text-blog">{caption}</figcaption>
      )}
    </figure>
  )
}
