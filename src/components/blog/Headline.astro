---
const { title = await Astro.slots.render('default'), subtitle = await Astro.slots.render('subtitle') } = Astro.props;
---

<header class="mb-8 md:mb-16 text-left max-w-3xl">
  <h1 class="text-[42px] md:text-[56px] font-normal leading-[105%] tracking-tighter font-heading" set:html={title} />
  {
    subtitle && (
      <div class="mt-2 md:mt-3 mx-auto text-[16px] md:text-[17px] leading-[160%] text-gray-500 dark:text-slate-400 font-medium" set:html={subtitle} />
    )
  }
</header>
