---
import type { TocItem } from '~/lib/content/blogArticle';
import Button from '~/components/ui/Button.astro';
import CTANote from '~/components/ui/CTANote.astro';
import { PRIMARY_CTA_LABEL } from '~/config/cta';

export interface Props {
  toc: TocItem[];
  ctaTitle?: string;
  ctaHref?: string;
  variant?: 'sticky' | 'inline';
}

const {
  toc,
  ctaTitle = 'Have a question?',
  ctaHref = '/form',
  variant = 'sticky',
} = Astro.props;

const isSticky = variant === 'sticky';
---

<blog-toc-nav
  class:list={[
    'block',
    isSticky
      ? 'hidden lg:block lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto'
      : 'lg:hidden mb-10',
  ]}
>
  {
    toc.length > 0 && (
      <nav aria-label="On this page">
        {isSticky ? (
          <p class="text-[12px] font-medium uppercase tracking-wider text-muted mb-3">On this page</p>
        ) : (
          <details class="group">
            <summary class="text-[12px] font-medium uppercase tracking-wider text-muted cursor-pointer list-none flex items-center justify-between gap-3 [&::-webkit-details-marker]:hidden">
              On this page
              <span class="text-heading text-[16px] leading-none group-open:rotate-45 transition-transform">+</span>
            </summary>
            <ol class="space-y-2.5 mt-3">
              {toc.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    data-toc-link
                    class="block text-[14px] md:text-[15px] font-normal leading-[150%] text-muted hover:text-heading"
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )}
        {isSticky && (
          <ol class="space-y-2.5">
            {toc.map((item) => (
              <li>
                <a
                  href={`#${item.id}`}
                  data-toc-link
                  class="block text-[14px] md:text-[15px] font-normal leading-[150%] text-muted hover:text-heading"
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ol>
        )}
      </nav>
    )
  }

  {
    isSticky && (
      <div class:list={['rounded-lg bg-card-light p-5', toc.length > 0 && 'mt-8']}>
        <p class="text-[18px] md:text-[20px] font-sans font-medium leading-[130%] text-heading mb-4">{ctaTitle}</p>
        <div class="flex flex-col gap-1.5">
          <Button
            variant="primary"
            text={PRIMARY_CTA_LABEL}
            href={ctaHref}
            hideNote={true}
            class="w-auto self-start"
          />
          <CTANote />
        </div>
      </div>
    )
  }
</blog-toc-nav>

<style>
  blog-toc-nav a[data-toc-link][aria-current='location'] {
    color: var(--aw-color-text-heading, #222);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--aw-color-accent, #edd974);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    text-decoration-skip-ink: none;
  }
</style>

{
  isSticky && (
    <script>
      class BlogTocNav extends HTMLElement {
        abort;

        connectedCallback() {
          const links = Array.from(this.querySelectorAll('a[data-toc-link]'));
          const items = [];

          for (const link of links) {
            const id = decodeURIComponent(link.getAttribute('href') || '').replace('#', '');
            const target = id ? document.getElementById(id) : null;
            if (target) items.push({ link, target });
          }

          if (!items.length) return;

          const marker = () => {
            const header = document.getElementById('header');
            const headerH = header?.getBoundingClientRect().height ?? 72;
            return Math.max(headerH + 56, 168);
          };

          const sync = () => {
            const line = marker();
            let active = items[0];
            for (const item of items) {
              if (item.target.getBoundingClientRect().top <= line) active = item;
            }

            for (const item of items) {
              if (item === active) item.link.setAttribute('aria-current', 'location');
              else item.link.removeAttribute('aria-current');
            }
          };

          sync();
          window.addEventListener('scroll', sync, { passive: true });
          window.addEventListener('resize', sync);
          window.addEventListener('hashchange', sync);
          this.abort = () => {
            window.removeEventListener('scroll', sync);
            window.removeEventListener('resize', sync);
            window.removeEventListener('hashchange', sync);
          };
        }

        disconnectedCallback() {
          this.abort?.();
        }
      }

      if (!customElements.get('blog-toc-nav')) {
        customElements.define('blog-toc-nav', BlogTocNav);
      }
    </script>
  )
}
