---
/** Sunburst badge shape (Figma "Shape / Starburst" 2029:873). Decorative. */
interface Props {
  class?: string;
  fill?: string;
  points?: number;
}

const { class: className, fill = 'var(--v3-gold)', points = 18 } = Astro.props;

const path = Array.from({ length: points * 2 }, (_, i) => {
  const r = i % 2 === 0 ? 100 : 80;
  const a = (Math.PI * i) / points - Math.PI / 2;
  return `${(100 + r * Math.cos(a)).toFixed(2)},${(100 + r * Math.sin(a)).toFixed(2)}`;
}).join(' ');
---

<svg class={className} viewBox="0 0 200 200" aria-hidden="true" focusable="false">
  <polygon points={path} fill={fill}></polygon>
</svg>
