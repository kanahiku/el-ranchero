---
import CardWrapper from './CardWrapper.astro';
import HeroImagePlaceholder from './HeroImagePlaceholder.astro';

export interface Props {
  title: string;
  description?: string;
  image?: {
    src: string;
    alt: string;
  };
  href?: string;
  variant?: 'dark' | 'light';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  title,
  description,
  image,
  href,
  variant = 'light',
  size = 'md',
  class: className = '',
} = Astro.props;

const headingClass = variant === 'dark' ? 'text-card-heading-dark' : 'text-card-heading-light';
const bodyClass = variant === 'dark' ? 'text-card-body-dark' : 'text-card-body-light';
---

<CardWrapper variant={variant} size={size} href={href} class={className}>
  <!-- TODO: replace with <Image> when asset is ready -->
  <HeroImagePlaceholder
    fill
    label={image?.alt || `${title} placeholder`}
    class="w-full h-36 md:h-44 rounded mb-3"
  />
  <h3 class:list={['text-[18px] md:text-[20px] font-sans font-medium leading-[130%] mb-1', headingClass]}>
    {title}
  </h3>
  {description && (
    <p class:list={['text-[13px] md:text-[14px] font-normal leading-[160%]', bodyClass]}>
      {description}
    </p>
  )}
</CardWrapper>
