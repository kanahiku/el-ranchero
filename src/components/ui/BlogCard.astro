---
import Image from '~/components/common/Image.astro';
import { getFormattedDate } from '~/utils/utils';
import { getBlogPermalink } from '~/lib/content';
import type { BlogPost } from '~/lib/content/types';

export interface Props {
  post: BlogPost;
  variant?: 'dark' | 'light';
}

const { post } = Astro.props;
const href = getBlogPermalink(post.slug);
const publishDate = new Date(post.publishDate);
const thumbnail = post.image?.src ? post.image : undefined;
---

<a
  href={href}
  class="group flex h-full flex-col gap-3 bg-card p-4 shadow-polaroid transition-transform duration-200 hover:-rotate-1"
>
  {
    thumbnail ? (
      <Image
        src={thumbnail.src}
        alt={thumbnail.alt || post.title}
        class="h-44 w-full shrink-0 object-cover md:h-52"
        width={640}
        height={360}
        layout="none"
        widths={[320, 480, 640, 800]}
        sizes="(max-width: 768px) 100vw, 33vw"
      />
    ) : (
      <div class="h-44 w-full shrink-0 bg-section-grey md:h-52" role="img" aria-label={`${post.title} photo placeholder`} />
    )
  }
  <time datetime={post.publishDate} class="block text-[12px] font-medium uppercase tracking-wider text-muted">
    {getFormattedDate(publishDate)}
  </time>
  <h3 class="font-rough text-h4 leading-[1.05] text-accent">{post.title}</h3>
  <p class="flex-1 text-[14px] leading-[160%] text-heading md:text-[15px]">{post.excerpt}</p>
  <span class="mt-auto pt-2 font-button text-[13px] uppercase tracking-[0.06em] text-accent">Read article →</span>
</a>
