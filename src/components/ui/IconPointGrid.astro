---
import IconPoint from './IconPoint.astro';

export interface Props {
  items: Array<{ title: string; description: string; icon: string }>;
  variant?: 'light' | 'dark';
}

const { items, variant = 'light' } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 lg:gap-x-20 gap-y-10 md:gap-y-14">
  {
    items.map((point) => (
      <IconPoint
        title={point.title}
        description={point.description}
        icon={point.icon}
        variant={variant}
        orientation="stack"
        align="start"
      />
    ))
  }
</div>
