---
export interface Props {
  title: string;
  description: string;
  variant?: 'light' | 'dark';
  class?: string;
}

const {
  title,
  description,
  variant = 'light',
  class: className = '',
} = Astro.props;

const headingClass = variant === 'dark' ? 'text-card-heading-dark' : 'text-card-heading-light';
const bodyClass = variant === 'dark' ? 'text-card-body-dark' : 'text-card-body-light';
---

<div class:list={[
  'flex gap-4 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
  className
]}>
  <div class="shrink-0 w-1 bg-accent rounded-full"></div>
  <div>
    <h3 class:list={['text-[18px] md:text-[20px] font-sans font-medium leading-[130%] mb-2', headingClass]}>
      {title}
    </h3>
    <p class:list={['text-[14px] md:text-[15px] font-normal leading-[160%]', bodyClass]}>
      {description}
    </p>
  </div>
</div>
