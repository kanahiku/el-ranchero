---
interface Props {
  position?: 'bottom-right' | 'bottom-left' | 'top-right' | 'top-left' | 'image-corner';
  color?: 'accent' | 'muted' | 'dark' | 'white';
  opacity?: number;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  count?: 1 | 2;
  tilt?: number;
  class?: string;
}

const { 
  position = 'bottom-right',
  color = 'muted',
  opacity = 0.12,
  size = 'md',
  count = 2,
  tilt = 0,
  class: className = ''
} = Astro.props;

const colorMap: Record<string, string> = {
  accent: 'var(--aw-color-accent)',
  muted: 'var(--aw-color-text-muted)',
  dark: 'var(--aw-color-bg-page-dark)',
  white: '#ffffff',
};

const sizeMap: Record<string, string> = {
  sm: 'w-24 md:w-32',
  md: 'w-32 md:w-48',
  lg: 'w-48 md:w-64',
  xl: 'w-64 md:w-80',
};

const positionClasses: Record<string, string> = {
  'bottom-right': 'bottom-0 right-0',
  'bottom-left': 'bottom-0 left-0',
  'top-right': 'top-0 right-0',
  'top-left': 'top-0 left-0',
  'image-corner': 'top-1/2 left-1/2 -translate-y-1/2',
};

const rotationClasses: Record<string, string> = {
  'bottom-right': 'rotate-0',
  'bottom-left': '-scale-x-100',
  'top-right': '-scale-y-100',
  'top-left': 'rotate-180',
  'image-corner': 'rotate-0',
};

const tiltStyle = tilt !== 0 ? `transform: rotate(${tilt}deg);` : '';
---

<div 
  class:list={[
    'absolute pointer-events-none flex flex-col gap-2 md:gap-3',
    positionClasses[position],
    className
  ]}
  style={`opacity: ${opacity}; ${tiltStyle}`}
  aria-hidden="true"
>
  <svg 
    class:list={[sizeMap[size], rotationClasses[position]]}
    viewBox="0 0 287 103" 
    fill="none" 
    xmlns="http://www.w3.org/2000/svg"
    style={`fill: ${colorMap[color]};`}
  >
    <path d="M184.257 0L163.851 20.401L143.445 0L123.039 20.401L102.624 0L0 102.602H14.411L102.624 14.408L115.83 27.61L51.019 92.414H51.01L40.829 102.602H96.051L106.233 92.414H106.242L143.445 55.211L190.846 102.602H246.069L171.06 27.61L184.257 14.408L262.289 92.414L272.479 102.602H286.89L184.257 0ZM91.822 92.414H65.43L123.039 34.818L136.235 48.011L91.822 92.414ZM130.248 27.61L143.453 14.408L156.65 27.601L143.445 40.803L130.248 27.61ZM221.468 92.414H195.067L150.654 48.011L163.851 34.809L221.468 92.414Z" />
  </svg>
  
  {count === 2 && (
    <svg 
      class:list={[sizeMap[size], rotationClasses[position], 'opacity-50']}
      viewBox="0 0 287 103" 
      fill="none" 
      xmlns="http://www.w3.org/2000/svg"
      style={`fill: ${colorMap[color]};`}
    >
      <path d="M184.257 0L163.851 20.401L143.445 0L123.039 20.401L102.624 0L0 102.602H14.411L102.624 14.408L115.83 27.61L51.019 92.414H51.01L40.829 102.602H96.051L106.233 92.414H106.242L143.445 55.211L190.846 102.602H246.069L171.06 27.61L184.257 14.408L262.289 92.414L272.479 102.602H286.89L184.257 0ZM91.822 92.414H65.43L123.039 34.818L136.235 48.011L91.822 92.414ZM130.248 27.61L143.453 14.408L156.65 27.601L143.445 40.803L130.248 27.61ZM221.468 92.414H195.067L150.654 48.011L163.851 34.809L221.468 92.414Z" />
    </svg>
  )}
</div>
