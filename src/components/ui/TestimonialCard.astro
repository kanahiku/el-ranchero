---
/**
 * TestimonialCard — one review: platform logo + stars, handwritten quote,
 * right-aligned attribution. Used by the Testimonials marquee (fixed height) and
 * the Testimonials grid on /reviews (natural height).
 */
import googleIcon from '~/assets/images/google-icon.png';
import yelpIcon from '~/assets/images/yelp-icon.png';

export interface Props {
  quote: string;
  name: string;
  location?: string;
  platform?: 'google' | 'yelp';
  class?: string;
}

const { quote, name, location, platform, class: className } = Astro.props;
---

<article class:list={['flex flex-col gap-5 bg-card p-4', className]}>
  <div class="flex items-start gap-1.5">
    {
      platform === 'yelp' ? (
        <img src={yelpIcon.src} alt="Yelp" width={yelpIcon.width} height={yelpIcon.height} class="h-6 w-auto object-contain" loading="lazy" decoding="async" />
      ) : (
        <img src={googleIcon.src} alt="Google" width={googleIcon.width} height={googleIcon.height} class="h-6 w-auto object-contain" loading="lazy" decoding="async" />
      )
    }
    <div class="-rotate-[1.82deg]" role="img" aria-label="5 out of 5 stars">
      <svg width="139" height="20" viewBox="0 0 139 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        {
          [0, 1, 2, 3, 4].map((i) => (
            <g transform={`translate(${i * 27.8}, 0)`}>
              <path
                d="M10 1.5l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.77l-4.77 2.44.91-5.32L2.27 7.12l5.34-.78L10 1.5z"
                stroke="#3D2819"
                stroke-width="1"
                fill="#3D2819"
              />
            </g>
          ))
        }
      </svg>
    </div>
  </div>

  <p class="type-quote -rotate-[2.21deg] flex-1 text-heading leading-[1.2]">{quote}</p>

  <div class="-rotate-[2.17deg] flex flex-col items-end gap-3 text-right font-heading text-button leading-none">
    <span class="text-heading">{name}</span>
    {location && <span class="text-accent">{location}</span>}
  </div>
</article>
