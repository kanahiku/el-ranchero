---
/**
 * Image slot. Renders the Sanity photo when `image` is provided, otherwise a grey
 * placeholder. Set `ratio` to the Figma frame ratio (e.g. "440 / 400") or size it
 * with `class` (e.g. h-[300px]) and radius utilities.
 */
export interface Props {
  ratio?: string;
  class?: string;
  image?: { src: string; alt?: string };
}

const { ratio, class: className = '', image } = Astro.props;
const style = ratio ? `aspect-ratio: ${ratio};` : undefined;
---

{
  image?.src ? (
    <img
      src={image.src}
      alt={image.alt ?? ''}
      loading="lazy"
      decoding="async"
      class:list={['w-full bg-section-grey object-cover', className]}
      style={style}
    />
  ) : (
    <div aria-hidden="true" class:list={['w-full bg-section-grey', className]} style={style} />
  )
}
