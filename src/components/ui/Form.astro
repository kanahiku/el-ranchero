---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';
import { CONTACT } from '~/config/contact';
import { FORM_ENDPOINT, SITE_SLUG, TURNSTILE_SITE_KEY } from '~/lib/forms';

const { inputs, textarea, disclaimer, button = 'Contact us', description = '' } = Astro.props;

const fieldClass =
  'block w-full rounded-none border border-heading/15 bg-page px-4 py-3 font-sans text-body text-heading placeholder:text-muted/55 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20';

const labelClass = 'mb-2 block font-sans text-body font-normal text-heading';
const textareaId = textarea?.name ?? 'message';
---

<form
  id="contact-form"
  data-endpoint={FORM_ENDPOINT}
  data-site={SITE_SLUG}
  data-turnstile-sitekey={TURNSTILE_SITE_KEY}
  data-phone={CONTACT.phone.display}
>
  {
    inputs &&
      inputs.map(
        ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '', required, options }) =>
          name && (
            <div class="mb-6">
              {label && (
                <label for={name} class={labelClass}>
                  {label}
                </label>
              )}
              {type === 'select' ? (
                <select id={name} name={name} required={required} class={fieldClass}>
                  <option value="">{placeholder || 'Select an option'}</option>
                  {(options ?? []).map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))}
                </select>
              ) : (
                <input
                  type={type}
                  name={name}
                  id={name}
                  autocomplete={autocomplete}
                  placeholder={placeholder}
                  required={required}
                  class={fieldClass}
                />
              )}
            </div>
          )
      )
  }

  {
    textarea && (
      <div>
        <label for={textareaId} class={labelClass}>
          {textarea.label}
        </label>
        <textarea
          id={textareaId}
          name={textareaId}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          class={fieldClass}
        />
      </div>
    )
  }

  <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

  {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            class="mt-1 block w-full cursor-pointer rounded-none border border-heading/15 bg-page px-4 py-3 text-body"
          />
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none font-sans text-small text-muted">
            {disclaimer.label}
          </label>
        </div>
      </div>
    )
  }

  <div class="mt-6" data-turnstile></div>

  {
    button && (
      <div class="mt-10">
        <Button variant="primary" type="submit">
          {button}
        </Button>
      </div>
    )
  }

  <p id="form-status" class="mt-4 text-left hidden" aria-live="polite"></p>

  {
    description && (
      <div class="mt-3 text-left">
        <p class="font-sans text-small text-muted">{description}</p>
      </div>
    )
  }
</form>

<script>
  type TurnstileApi = {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    reset: (id: string) => void;
    getResponse: (id: string) => string;
  };

  function asText(value: FormDataEntryValue | null) {
    return typeof value === 'string' ? value.trim() : '';
  }

  function composeMessage(form: HTMLFormElement, data: FormData) {
    const zip = asText(data.get('zip'));
    const topicField = form.querySelector<HTMLSelectElement>('[name="topic"]');
    const topicValue = asText(data.get('topic'));
    const topicLabel = topicField?.selectedOptions[0]?.text?.trim() || topicValue;
    const message = asText(data.get('message'));
    const lines: string[] = [];
    if (zip) lines.push(`ZIP: ${zip}`);
    if (topicLabel) lines.push(`Topic: ${topicLabel}`);
    if (message) lines.push(message);
    return lines.join('\n\n') || 'Contact form submission';
  }

  function loadTurnstile(): Promise<TurnstileApi> {
    const existing = (window as Window & { turnstile?: TurnstileApi }).turnstile;
    if (existing) return Promise.resolve(existing);

    return new Promise((resolve, reject) => {
      const ready = () => {
        const api = (window as Window & { turnstile?: TurnstileApi }).turnstile;
        if (api) resolve(api);
        else reject(new Error('Turnstile failed to load'));
      };

      const script = document.querySelector<HTMLScriptElement>('script[data-turnstile-api]');
      if (script) {
        if ((window as Window & { turnstile?: TurnstileApi }).turnstile) {
          ready();
          return;
        }
        script.addEventListener('load', ready, { once: true });
        script.addEventListener('error', () => reject(new Error('Turnstile failed to load')), { once: true });
        return;
      }

      const next = document.createElement('script');
      next.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      next.async = true;
      next.dataset.turnstileApi = 'true';
      next.addEventListener('load', ready, { once: true });
      next.addEventListener('error', () => reject(new Error('Turnstile failed to load')), { once: true });
      document.head.appendChild(next);
    });
  }

  async function bindContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');

    if (!form || !status || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const slot = form.querySelector<HTMLElement>('[data-turnstile]');
    const sitekey = form.dataset.turnstileSitekey || '';
    let widgetId = '';

    if (slot && sitekey) {
      try {
        const turnstile = await loadTurnstile();
        widgetId = turnstile.render(slot, { sitekey });
      } catch (error) {
        console.error(error);
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const data = new FormData(form);

      if (asText(data.get('website'))) return;

      const endpoint = form.dataset.endpoint;
      const site = form.dataset.site;
      const turnstile = (window as Window & { turnstile?: TurnstileApi }).turnstile;
      const turnstileToken =
        widgetId && turnstile ? turnstile.getResponse(widgetId) : asText(data.get('cf-turnstile-response'));

      if (submitButton) submitButton.disabled = true;
      status.className = 'mt-4 text-left text-[14px] md:text-[15px] font-medium text-muted';
      status.textContent = 'Sending...';
      status.classList.remove('hidden');

      try {
        if (!endpoint || !site) throw new Error('Form is not configured');
        if (!turnstileToken) throw new Error('Spam check is required');

        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            site,
            name: asText(data.get('name')),
            email: asText(data.get('email')),
            phone: asText(data.get('phone')),
            message: composeMessage(form, data),
            website: asText(data.get('website')),
            turnstileToken,
          }),
        });

        const payload = (await res.json().catch(() => null)) as { ok?: boolean } | null;

        if (res.ok && payload?.ok) {
          status.textContent = "Thanks! We will be in touch soon.";
          status.className = 'mt-4 text-left text-[14px] md:text-[15px] font-medium text-heading';
          form.reset();
          if (widgetId && turnstile) turnstile.reset(widgetId);
        } else {
          throw new Error();
        }
      } catch {
        const phone = form.dataset.phone;
        status.textContent = phone
          ? `Something went wrong. Please try again or call ${phone}.`
          : 'Something went wrong. Please try again.';
        status.className = 'mt-4 text-left text-[14px] md:text-[15px] font-medium text-red-700';
      } finally {
        if (submitButton) submitButton.disabled = false;
        status.classList.remove('hidden');
      }
    });
  }

  document.addEventListener('astro:page-load', bindContactForm);
</script>
